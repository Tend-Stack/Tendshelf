package components

// ReadButtonView is the control that opens the reader. Secondary draws the plain button of the format
// that is not the person's last (decision 0018: one primary resume button per book on any screen).
type ReadButtonView struct {
	Href, Label, AriaLabel string
	Secondary              bool
	// Large makes a secondary button as tall as the primary beside it (the book page and the Home hero);
	// the plain 44 px secondary stays for compact rows such as the offline list.
	Large bool
	// Round draws the icon-only variant of a series row, named by AriaLabel.
	Round bool
}

func readBtnClass(v ReadButtonView) string {
	if v.Secondary {
		if v.Large {
			return "ts-btn ts-btn--secondary ts-btn--lg"
		}
		return "ts-btn ts-btn--secondary"
	}
	if v.Round {
		return "ts-iconbtn ts-iconbtn--tonal"
	}
	return "ts-btn ts-btn--primary ts-btn--lg"
}

// ReadButton is a plain, boosted link to the reader's full page. It needs no JavaScript.
templ ReadButton(v ReadButtonView) {
	<a
		class={ readBtnClass(v) }
		href={ templ.SafeURL(v.Href) }
		data-ts-read
		if v.AriaLabel != "" {
			aria-label={ v.AriaLabel }
		}
	>
		@Icon("book-open", false)
		if !v.Round {
			<span>{ v.Label }</span>
		}
	</a>
}
