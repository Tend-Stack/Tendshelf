package components

import (
	"encoding/json"
	"slices"
	"strings"

	"github.com/Tend-Stack/tendshelf/internal/web/static"
)

// Page is what the layout needs to render any page.
type Page struct {
	Title   string
	Current string // key of the current MainNav item, "" for none
	Theme   string // dark, light, sepia or contrast; "" follows the system
	// TextSize is "large" for a person who chose Larger text in Settings; "" renders the standard size.
	TextSize string
	CSRF    string
	Assets  *static.Set
	// Sheet, when set, is rendered inside #sheet on a full-page load, so a canonical URL such as
	// ?sheet=1 shows the sheet without JavaScript. Fragments swap sheets into #sheet.
	Sheet templ.Component
	// Styles lists extra stylesheets by static path (for example "css/pages-admin.css"). Layout
	// links them at the top of #main, not in the head: htmx drops the head of a boosted answer, so
	// a link inside the swapped content is the only way a page keeps its own look after a swap.
	// Frame pages (no boosting) link theirs in the head.
	Styles []string
	// Admin shows the "Your server" group in the desktop sidebar.
	Admin bool
	// Users shows "Users & invites" in the sidebar; UsersWaiting is its count text ("" hides it).
	Users        bool
	UsersWaiting string
	// Shelves are the person's shelves in the desktop sidebar ("Your shelves"), empty for people
	// who may not use shelves.
	Shelves []ShelfLink
	// Player holds the words of the mini-player and the keyboard sheet (Layout only).
	Player PlayerMsgs

	// prefetch is set by Layout: the page stylesheets this page does not link itself.
	prefetch []string
}

// pagePrefix starts the static path of every per-page stylesheet.
const pagePrefix = "css/pages-"

// withPrefetch returns p with the page stylesheets it does not link itself, so the head can ask the
// browser to fetch them early: the first boosted visit to another page then finds them cached.
func (p Page) withPrefetch() Page {
	if p.Assets == nil {
		return p
	}
	for _, name := range p.Assets.Names() {
		if strings.HasPrefix(name, pagePrefix) && !slices.Contains(p.Styles, name) {
			p.prefetch = append(p.prefetch, name)
		}
	}
	return p
}

// htmxConfig is the htmx 4 configuration meta content.
const htmxConfig = `{"includeIndicatorCSS":false,"defaultTimeout":25000,"transitions":false}`

// csrfHeaders is the JSON for hx-headers: every htmx request carries the CSRF token.
func csrfHeaders(token string) string {
	b, err := json.Marshal(map[string]string{"X-CSRF-Token": token})
	if err != nil {
		return "{}"
	}
	return string(b)
}

// layoutStyles is what Layout adds to the head: the player stylesheet, because every Layout page
// has the player. A page's own stylesheets go inside #main (see Page.Styles).
func layoutStyles() []string {
	return []string{"css/player.css", "css/player-fit.css", "css/now-panel.css"}
}

// Layout is the app shell. The navigation, the player slot, the audio element and the toasts sit
// outside #main, so a boosted navigation swaps only the content.
templ Layout(p Page, body templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if p.Theme != "" {
			data-theme={ p.Theme }
		}
		if p.TextSize == "large" {
			data-text-size="large"
		}
	>
		@Head(p.withPrefetch(), layoutStyles()...)
		<body hx-boost:inherited="target:#main select:#main swap:outerSync transition:true" hx-headers:inherited={ csrfHeaders(p.CSRF) }>
			<a class="ts-sr-focusable" href="#main">Skip to content</a>
			<div class="ts-shell">
				@TabBar(p.Current)
				@SideRail(p.Current)
				@Sidebar(p.Current, p.Admin, UsersLink{Show: p.Users, Waiting: p.UsersWaiting}, p.Shelves)
				<main id="main" class="ts-main" tabindex="-1" hx-history-elt>
					for _, css := range p.Styles {
						<link rel="stylesheet" href={ p.Assets.URL(css) }/>
					}
					@body
				</main>
			</div>
			@PlayerSlot(p.Player)
			@PlayerFull(p.Player)
			@Toasts()
			@KeysHelp(p.Player)
			<div id="sheet" class="ts-sheet-region">
				if p.Sheet != nil {
					@p.Sheet
				}
			</div>
			<script type="module" async src={ p.Assets.URL("js/player.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/player-full.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/waveform.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/now-panel.js") }></script>
		</body>
	</html>
}

// Head is the document head shared by Layout and Frame. extraCSS lists further stylesheets by
// static path (for example "css/pages-onboard.css"), linked after the motion layer.
templ Head(p Page, extraCSS ...string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content="dark light"/>
		<meta name="htmx-config" content={ htmxConfig }/>
		<title>{ p.Title } · Tendshelf</title>
		<link rel="preload" href={ p.Assets.URL("fonts/Fraunces-Variable.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="preload" href={ p.Assets.URL("fonts/FiraSans-Regular.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ p.Assets.URL("css/tokens.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/fonts.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/bundle.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/utilities.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/motion.css") }/>
		for _, css := range extraCSS {
			<link rel="stylesheet" href={ p.Assets.URL(css) }/>
		}
		for _, css := range p.prefetch {
			<link rel="prefetch" as="style" href={ p.Assets.URL(css) }/>
		}
		<link rel="icon" type="image/svg+xml" href={ p.Assets.URL("img/tendshelf-app-icon.svg") }/>
		<script src={ p.Assets.URL("vendor/htmx-4.0.0.min.js") } defer></script>
		<script type="module" src={ p.Assets.URL("js/shell.js") }></script>
		<script type="module" src={ p.Assets.URL("js/copy.js") }></script>
	</head>
}

// SheetStyles links the stylesheets a sheet needs, from inside the sheet's own root element. A sheet
// is swapped into #sheet from any page (hx-select="#sheet > *"), and htmx drops the head of that
// answer, so the sheet carries what styles it. A link to a stylesheet that is already loaded is free.
templ SheetStyles(hrefs []string) {
	for _, href := range hrefs {
		<link rel="stylesheet" href={ href }/>
	}
}
