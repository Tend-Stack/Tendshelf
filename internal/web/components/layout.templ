package components

import (
	"encoding/json"
	"slices"
	"strconv"
	"strings"

	"github.com/Tend-Stack/tendshelf/internal/web/static"
)

// Page is what the layout needs to render any page.
type Page struct {
	Title   string
	Current string // key of the current MainNav item, "" for none
	Theme   string // dark, light, sepia or contrast; "" follows the system
	// TextSize is "large" for a person who chose Larger text in Settings; "" renders the standard size.
	TextSize string
	// NavRail collapses the desktop sidebar into an icon rail (the ui.nav setting).
	NavRail bool
	// TimeZone is the person's stored zone (ui.time_zone), rendered as data-ts-tz so shell.js can tell when the browser's differs.
	TimeZone string
	CSRF    string
	Assets  *static.Set
	// Sheet, when set, is rendered inside #sheet on a full-page load, so a canonical URL such as
	// ?sheet=1 shows the sheet without JavaScript. Fragments swap sheets into #sheet.
	Sheet templ.Component
	// Styles lists extra stylesheets by static path (for example "css/pages-admin.css"). Layout
	// links them at the top of #main, not in the head: htmx drops the head of a boosted answer, so
	// a link inside the swapped content is the only way a page keeps its own look after a swap.
	// Frame pages (no boosting) link theirs in the head.
	Styles []string
	// Account is the signed-in person for the account chip and the Profile tab's avatar (Layout only).
	Account NavAccount
	// Admin shows the "Your server" group in the desktop sidebar.
	Admin bool
	// Users shows "Users & invites" in the sidebar; UsersWaiting is its count text ("" hides it).
	Users        bool
	UsersWaiting string
	// Shelves are the person's shelves in the desktop sidebar ("Your shelves"), empty for people
	// who may not use shelves.
	Shelves []ShelfLink
	// Player holds the words of the mini-player and the keyboard sheet (Layout only).
	Player PlayerMsgs

	// Person is the signed-in person's id, written on <html> so offline.js can tell a change of
	// person (Layout only). ChunkBytes is the size of one offline download request.
	Person     string
	ChunkBytes int
	// Offline holds the words of the offline banner (Layout only).
	Offline OfflineMsgs
	// NoInstall leaves out the install links (manifest, Home Screen icon and title). Share-link pages
	// set it: they are not part of the installed app.
	NoInstall bool
	// Shell is "desktop", "ios" or "android" when the window is a Tendshelf app (cookie ts_shell), else "".
	// It is written as data-shell on <html>. NoOffline keeps offline.js out of the page (no service
	// worker inside an app window).
	Shell     string
	NoOffline bool
	// Crumb is the parent of a book, series, author or reader page. Only the desktop app's title bar shows
	// it, as "Library / The Cartographer's Silence"; a browser never sees it (Layout only).
	Crumb Crumb
	// AddBooks is the Add books page the desktop app's drop zone sends dropped files to; "" when this person
	// may not add books anywhere (owner or admin, a library with uploads on). Desktop shell only.
	AddBooks string
	// Picker marks the desktop app's own start page: its bar has no Back, Forward or More (Frame only).
	Picker bool

	// prefetch is set by Layout: the page stylesheets this page does not link itself.
	prefetch []string
}

// Crumb is a link to the page above this one.
type Crumb struct{ Label, Href string }

// pagePrefix starts the static path of every per-page stylesheet.
const pagePrefix = "css/pages-"

// noPrefetch lists page stylesheets too rarely visited to cost every page a request.
// pages-email.css joins them (decision 0021): Profile adds its own stylesheet, and no page may gain a request for it.
// pages-invite, pages-folders and pages-upload join them for Home's row of three covers (three covers, three requests).
// pages-onboard joins them for the same row: it dresses sign-in, setup and password pages, which a signed-in page never leads to.
// pages-chapters, pages-appkeys, pages-timeline and pages-highlights join them: each belongs to one rarely opened page, and no page may gain a request for it.
var noPrefetch = []string{"css/pages-words.css", "css/pages-desktop.css", "css/pages-email.css", "css/pages-invite.css", "css/pages-folders.css", "css/pages-upload.css", "css/pages-onboard.css", "css/pages-chapters.css", "css/pages-appkeys.css", "css/pages-timeline.css", "css/pages-highlights.css"}

// withPrefetch returns p with the page stylesheets it does not link itself, so the head can ask the
// browser to fetch them early: the first boosted visit to another page then finds them cached.
func (p Page) withPrefetch() Page {
	if p.Assets == nil {
		return p
	}
	for _, name := range p.Assets.Names() {
		if strings.HasPrefix(name, pagePrefix) && !slices.Contains(p.Styles, name) && !slices.Contains(noPrefetch, name) {
			p.prefetch = append(p.prefetch, name)
		}
	}
	return p
}

// htmxConfig is the htmx 4 configuration meta content.
const htmxConfig = `{"includeIndicatorCSS":false,"defaultTimeout":25000,"transitions":false}`

// csrfHeaders is the JSON for hx-headers: every htmx request carries the CSRF token.
func csrfHeaders(token string) string {
	b, err := json.Marshal(map[string]string{"X-CSRF-Token": token})
	if err != nil {
		return "{}"
	}
	return string(b)
}

// layoutStyles is what Layout adds to the head: the player stylesheet, because every Layout page
// has the player. A page's own stylesheets go inside #main (see Page.Styles).
func layoutStyles() []string {
	return []string{"css/player.css", "css/player-fit.css", "css/player-bubble.css", "css/now-panel.css"}
}

// Layout is the app shell. The navigation, the player slot, the audio element and the toasts sit
// outside #main, so a boosted navigation swaps only the content.
templ Layout(p Page, body templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if p.Shell != "" {
			data-shell={ p.Shell }
		}
		if p.Theme != "" {
			data-theme={ p.Theme }
		}
		if p.TextSize == "large" {
			data-text-size="large"
		}
		if p.Person != "" {
			data-ts-person={ p.Person }
			data-ts-chunk={ strconv.Itoa(p.ChunkBytes) }
		}
	>
		@Head(p.withPrefetch(), layoutStyles()...)
		<body data-ts-tz={ p.TimeZone } hx-boost:inherited="target:#main select:#main swap:outerSync transition:true" hx-headers:inherited={ csrfHeaders(p.CSRF) }>
			<a class="ts-sr-focusable" href="#main">Skip to content</a>
			@DesktopBar(p)
			@OfflineBanner(p)
			<div class="ts-shell">
				@TabBar(p.Current, p.Shell, p.Account)
				@SideRail(p.Current, p.Shell, p.Account)
				@Sidebar(p.Current, p.Admin, UsersLink{Show: p.Users, Waiting: p.UsersWaiting}, p.Shelves, p.NavRail, p.CSRF, true, p.Shell, p.Account)
				<main
					id="main"
					class="ts-main"
					tabindex="-1"
					hx-history-elt
					if p.Shell == "desktop" && p.Crumb.Href != "" {
						data-ts-crumb={ p.Crumb.Label }
						data-ts-crumb-href={ p.Crumb.Href }
					}
				>
					for _, css := range p.Styles {
						<link rel="stylesheet" href={ p.Assets.URL(css) }/>
					}
					@body
				</main>
			</div>
			@PlayerSlot(p.Player.inShell(p.Shell))
			@PlayerFull(p.Player)
			@Toasts()
			@KeysHelp(p.Player.inShell(p.Shell))
			<div id="sheet" class="ts-sheet-region">
				if p.Sheet != nil {
					@p.Sheet
				}
			</div>
			<script type="module" async src={ p.Assets.URL("js/player.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/player-full.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/waveform.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/now-panel.js") }></script>
			<script type="module" async src={ p.Assets.URL("js/chapter-bar.js") }></script>
			@OfflineScript(p)
		</body>
	</html>
}

// Head is the document head shared by Layout and Frame. extraCSS lists further stylesheets by
// static path (for example "css/pages-onboard.css"), linked after the motion layer.
templ Head(p Page, extraCSS ...string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content={ colorSchemeMeta(p.Theme) }/>
		if p.Theme == "" {
			<meta name="theme-color" media="(prefers-color-scheme: light)" content={ themeColor("light") }/>
			<meta name="theme-color" media="(prefers-color-scheme: dark)" content={ themeColor("dark") }/>
		} else {
			<meta name="theme-color" content={ themeColor(p.Theme) }/>
		}
		<meta name="format-detection" content="telephone=no, date=no, email=no, address=no"/>
		<meta name="htmx-config" content={ htmxConfig }/>
		<title>{ p.Title } · Tendshelf</title>
		<link rel="preload" href={ p.Assets.URL("fonts/Fraunces-Variable.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="preload" href={ p.Assets.URL("fonts/FiraSans-Regular.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ p.Assets.URL("css/tokens.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/fonts.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/bundle.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/utilities.css") }/>
		<link rel="stylesheet" href={ p.Assets.URL("css/motion.css") }/>
		for _, css := range extraCSS {
			<link rel="stylesheet" href={ p.Assets.URL(css) }/>
		}
		for _, css := range p.prefetch {
			<link rel="prefetch" as="style" href={ p.Assets.URL(css) }/>
		}
		<link rel="icon" type="image/svg+xml" href={ p.Assets.URL("img/tendshelf-app-icon.svg") }/>
		if !p.NoInstall {
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href={ p.Assets.URL("img/apple-touch-icon.png") }/>
			<meta name="apple-mobile-web-app-title" content="Tendshelf"/>
		}
		<script src={ p.Assets.URL("vendor/htmx-4.0.0.min.js") } defer></script>
		<script type="module" src={ p.Assets.URL("js/shell.js") }></script>
		<script type="module" src={ p.Assets.URL("js/copy.js") }></script>
		if p.Shell == "desktop" {
			<link rel="stylesheet" href={ p.Assets.URL("css/pages-desktop.css") }/>
			<script type="module" src={ p.Assets.URL("js/desktop.js") }></script>
			<script type="module" src={ p.Assets.URL("js/desktop-shell.js") }></script>
		}
		if p.Shell == "android" {
			<script type="module" src={ p.Assets.URL("js/native-audio.js") }></script>
			<script type="module" src={ p.Assets.URL("js/native-downloads.js") }></script>
			<script type="module" src={ p.Assets.URL("js/native-speech.js") }></script>
			<script type="module" src={ p.Assets.URL("js/native-feel.js") }></script>
		}
	</head>
}

// SheetStyles links the stylesheets a sheet needs, from inside the sheet's own root element. A sheet
// is swapped into #sheet from any page (hx-select="#sheet > *"), and htmx drops the head of that
// answer, so the sheet carries what styles it. A link to a stylesheet that is already loaded is free.
templ SheetStyles(hrefs []string) {
	for _, href := range hrefs {
		<link rel="stylesheet" href={ href }/>
	}
}
