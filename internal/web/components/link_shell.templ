package components

// LinkShell is the page shell of a share link (/s/{token}): the sign-in frame plus the player, so a
// person with no account can listen. There is no navigation and no hx-boost, so every move is a
// full page load. data-ts-link on the body puts the player in link mode: it prefixes /stream/ and
// /peaks/ with the link's own address, reads the inline #player-data instead of /hx/player and keeps
// the place in the browser only. data is nil on the pages that have no book to play (password form,
// broken link): then no player is drawn and no script is loaded.
templ LinkShell(p Page, base string, data *PlayerDataView, body templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if p.Shell != "" {
			data-shell={ p.Shell }
		}
		if p.Theme != "" {
			data-theme={ p.Theme }
		}
	>
		@Head(withoutInstall(p), append(layoutStyles(), frameStyles(p)...)...)
		<body
			class="ts-frame ts-linkshell"
			if base != "" {
				data-ts-link={ base }
			}
		>
			<a class="ts-sr-focusable" href="#main">Skip to content</a>
			<main id="main" class="ts-frame__main" tabindex="-1">
				@body
			</main>
			if data != nil {
				@PlayerData(*data)
				@PlayerSlot(p.Player)
				@PlayerFull(p.Player)
				@Toasts()
				@KeysHelp(p.Player)
				<script type="module" async src={ p.Assets.URL("js/player.js") }></script>
				<script type="module" async src={ p.Assets.URL("js/player-full.js") }></script>
				<script type="module" async src={ p.Assets.URL("js/waveform.js") }></script>
			}
		</body>
	</html>
}
