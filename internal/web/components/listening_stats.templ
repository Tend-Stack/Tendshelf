package components

// StatsDay is one mark of the week row: its letter and state (listened, today, missed or ahead).
type StatsDay struct{ Letter, State string }

// ListeningStatsView is the words and numbers of the listening panel. It carries no book title.
type ListeningStatsView struct {
	Title                   string
	WeekLabel, Week         string
	StreakLabel, Streak     string
	FinishedLabel, Finished string
	DaysLabel               string
	Days                    []StatsDay
	Note                    string
	// More is the link under the panel to /me/listening (Profile only; the admin view leaves it empty).
	More, MoreHref string
	// Also is the second link, "Your reading", shown when the person has read an ebook (G2).
	Also, AlsoHref string
	// Words is the third, "Your word list" (G1), shown beside Also.
	Words, WordsHref string
	// Highlights is the fourth, "All my highlights" (R1), shown beside Words.
	Highlights, HighlightsHref string
}

// ListeningStats is the three numbers and, on Profile, the week's day marks. The marks are one
// image with a sentence label, so no state is told by colour alone.
templ ListeningStats(v ListeningStatsView) {
	<section aria-labelledby="pf-stats" class="ts-stats">
		<h2 id="pf-stats" class="ts-overline ts-stats__title">{ v.Title }</h2>
		<dl class="ts-stats__grid">
			<div><dt class="caption ts-stats__label">{ v.WeekLabel }</dt><dd class="time ts-stats__value">{ v.Week }</dd></div>
			<div><dt class="caption ts-stats__label">{ v.StreakLabel }</dt><dd class="time ts-stats__value">{ v.Streak }</dd></div>
			<div><dt class="caption ts-stats__label">{ v.FinishedLabel }</dt><dd class="time ts-stats__value">{ v.Finished }</dd></div>
		</dl>
		if len(v.Days) > 0 {
			<div role="img" aria-label={ v.DaysLabel } class="ts-stats__days">
				for _, d := range v.Days {
					<span class="ts-stats__day">
						<span aria-hidden="true" class={ "ts-stats__mark", "ts-stats__day--" + d.State }></span>
						<span class="meta ts-stats__letter" aria-hidden="true">{ d.Letter }</span>
					</span>
				}
			</div>
		}
		if v.Note != "" {
			<p class="caption ts-stats__note">{ v.Note }</p>
		}
		if v.More != "" || v.Also != "" || v.Words != "" || v.Highlights != "" {
			<div class="ts-stats__links">
				if v.More != "" {
					<a class="label ts-dash__more" href={ templ.SafeURL(v.MoreHref) }>{ v.More }</a>
				}
				if v.Also != "" {
					<a class="label ts-dash__more" href={ templ.SafeURL(v.AlsoHref) }>{ v.Also }</a>
				}
				if v.Words != "" {
					<a class="label ts-dash__more" href={ templ.SafeURL(v.WordsHref) }>{ v.Words }</a>
				}
				if v.Highlights != "" {
					<a class="label ts-dash__more" href={ templ.SafeURL(v.HighlightsHref) }>{ v.Highlights }</a>
				}
			</div>
		}
	</section>
}
