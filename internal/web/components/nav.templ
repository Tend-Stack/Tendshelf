package components

// NavItem is one main destination.
type NavItem struct {
	Key, Label, Href, Icon string
	// NoBoost keeps the link a plain navigation: the Android app catches it before the page loads (A7).
	NoBoost bool
}

// MainNav is the one list all three navigations render from, in order.
var MainNav = []NavItem{
	{Key: "home", Label: "Home", Href: "/", Icon: "home"},
	{Key: "library", Label: "Library", Href: "/libraries", Icon: "library"},
	{Key: "search", Label: "Search", Href: "/search", Icon: "search"},
	{Key: "downloads", Label: "Downloads", Href: "/me/downloads", Icon: "download"},
	{Key: "profile", Label: "Profile", Href: "/me", Icon: "profile"},
}

// NavAccount is the signed-in person as the navigation shows them: the account chip at the foot of the
// rail and sidebar, and the avatar on the phone's Profile tab. An empty ID draws the plain Profile item.
type NavAccount struct{ ID, Name, Kind string }

// profileLabel is the accessible name of the account chip.
func profileLabel(a NavAccount) string {
	return "Profile, " + a.Name
}

// chipItem says whether a main-nav item is drawn in the list: Profile moves to the account chip at
// the foot when the person is known.
func chipItem(it NavItem, a NavAccount) bool {
	return it.Key != "profile" || a.ID == ""
}

// navFor is MainNav for the window it is drawn in. The phone app keeps the Downloads item (A7) but draws the list itself
// from what the phone holds, so the link is a plain navigation (NoBoost) that the app's navigation policy catches.
func navFor(shell string) []NavItem {
	if shell != "android" {
		return MainNav
	}
	out := make([]NavItem, len(MainNav))
	copy(out, MainNav)
	for i := range out {
		if out[i].Key == "downloads" {
			out[i].NoBoost = true
		}
	}
	return out
}

// shelfHref is where a sidebar shelf link goes: the shelf, or the list of shelves for the entries
// that have no id ("Shelves" when the person has none, "All shelves" after the first twelve).
func shelfHref(s ShelfLink) string {
	if s.ID == "" {
		return "/shelves"
	}
	return "/shelves/" + s.ID
}

// shelfKey is the Page.Current value of a shelf page: "shelf-{id}", or "shelves" for the list.
func shelfKey(s ShelfLink) string {
	if s.ID == "" {
		return "shelves"
	}
	return "shelf-" + s.ID
}

// TabBar is the phone's bottom navigation.
templ TabBar(current, shell string, acct NavAccount) {
	<nav aria-label="Main" id="nav-tabbar" hx-preserve class="ts-tabbar ts-nav-tabbar">
		for _, it := range navFor(shell) {
			<a
				href={ templ.SafeURL(it.Href) }
				class="ts-tabbar__item"
				data-nav={ it.Href }
				if it.NoBoost {
					hx-boost="false"
				}
				if it.Key == current {
					aria-current="page"
				}
			>
				if it.Key == "profile" && acct.ID != "" {
					@Avatar(acct.ID, acct.Name, "sm")
				} else {
					@Icon(it.Icon, false)
				}
				{ it.Label }
			</a>
		}
	</nav>
}

// SideRail is the tablet navigation rail (768 to 1279 px).
templ SideRail(current, shell string, acct NavAccount) {
	<nav aria-label="Main" id="nav-rail" hx-preserve class="ts-rail ts-nav-rail">
		<span class="ts-rail__brand ts-brand">
			@Mark()
		</span>
		for _, it := range navFor(shell) {
			if chipItem(it, acct) {
				<a
					href={ templ.SafeURL(it.Href) }
					class="ts-rail__item"
					data-nav={ it.Href }
					if it.NoBoost {
						hx-boost="false"
					}
					if it.Key == current {
						aria-current="page"
					}
				>
					@Icon(it.Icon, false)
					{ it.Label }
				</a>
			}
		}
		<span class="ts-rail__spacer"></span>
		if acct.ID != "" {
			<a
				href="/me"
				class="ts-rail__item ts-rail__me"
				data-nav="/me"
				aria-label={ profileLabel(acct) }
				if current == "profile" {
					aria-current="page"
				}
			>
				@Avatar(acct.ID, acct.Name, "md")
				Profile
			</a>
		}
	</nav>
}

// UsersLink says whether the sidebar shows "Users & invites" and what its count reads
// (for example "1 waiting"; empty hides the count).
type UsersLink struct {
	Show    bool
	Waiting string
}

// navMode is the value of the sidebar's data-nav attribute.
func navMode(rail bool) string {
	if rail {
		return "rail"
	}
	return "full"
}

// navToggleLabel names the toggle by what pressing it does.
func navToggleLabel(rail bool) string {
	if rail {
		return "Expand menu"
	}
	return "Collapse menu"
}

// Sidebar is the desktop navigation (1280 px and up). rail collapses it to large icons; the toggle at
// its foot posts the next state. preserve keeps the element across boosted swaps (full page renders);
// the fragment that answers the toggle leaves it off, because htmx 4 would otherwise put the OLD
// preserved element back in place of the new one.
templ Sidebar(current string, admin bool, users UsersLink, shelves []ShelfLink, rail bool, csrf string, preserve bool, shell string, acct NavAccount) {
	<nav
		aria-label="Main"
		id="nav-side"
		class="ts-side ts-nav-side"
		data-nav={ navMode(rail) }
		if preserve {
			hx-preserve
		}
	>
		<span class="ts-side__brand ts-brand">
			@Mark()
			<span class="ts-side__label">Tendshelf</span>
		</span>
		for _, it := range navFor(shell) {
			if chipItem(it, acct) {
				<a
					href={ templ.SafeURL(it.Href) }
					class="ts-side__item"
					data-nav={ it.Href }
					if it.NoBoost {
						hx-boost="false"
					}
					if rail {
						title={ it.Label }
					}
					if it.Key == current {
						aria-current="page"
					}
				>
					@Icon(it.Icon, false)
					<span class="ts-side__label">{ it.Label }</span>
				</a>
			}
		}
		if len(shelves) > 0 && !rail {
			<span class="ts-side__group ts-overline">Your shelves</span>
			for _, sh := range shelves {
				<a
					href={ templ.SafeURL(shelfHref(sh)) }
					class="ts-side__item"
					data-nav={ shelfHref(sh) }
					if current == shelfKey(sh) {
						aria-current="page"
					}
				>
					@Icon("bookmark", false)
					<span class="ts-truncate">{ sh.Name }</span>
					<span class="ts-side__count">{ sh.Count }</span>
				</a>
			}
		}
		if (admin || users.Show) && !rail {
			<span class="ts-side__group ts-overline">Your server</span>
		}
		if users.Show {
			<a
				href="/admin/users"
				class="ts-side__item"
				data-nav="/admin/users"
				if rail {
					title="Users &amp; invites"
				}
				if current == "admin-users" {
					aria-current="page"
				}
			>
				@Icon("invite", false)
				<span class="ts-side__label">Users &amp; invites</span>
				if users.Waiting != "" {
					<span class="ts-side__count">{ users.Waiting }</span>
				}
			</a>
		}
		if admin {
			<a
				href="/admin/libraries"
				class="ts-side__item"
				data-nav="/admin/libraries"
				if rail {
					title="Libraries"
				}
				if current == "admin-libraries" {
					aria-current="page"
				}
			>
				@Icon("folder", false)
				<span class="ts-side__label">Libraries</span>
			</a>
		}
		if acct.ID != "" {
			<a
				href="/me"
				class="ts-side__item ts-side__me"
				data-nav="/me"
				aria-label={ profileLabel(acct) }
				if current == "profile" {
					aria-current="page"
				}
			>
				@Avatar(acct.ID, acct.Name, "md")
				<span class="ts-side__label ts-side__metext">
					<span class="ts-truncate ts-side__mename">{ acct.Name }</span>
					<span class="caption ts-side__mekind">{ acct.Kind }</span>
				</span>
			</a>
		}
		<form class="ts-side__foot" method="post" action="/me/nav" hx-post="/hx/me/nav" hx-target="#nav-side" hx-swap="outerHTML">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="nav" value={ navMode(!rail) }/>
			<button
				type="submit"
				id="nav-toggle"
				class="ts-iconbtn ts-side__toggle"
				aria-label={ navToggleLabel(rail) }
				aria-pressed={ pressed(rail) }
				title={ navToggleLabel(rail) }
			>
				@Icon("panel-left", false)
			</button>
		</form>
	</nav>
}
