package components

import (
	"strconv"
	"strings"
)

// PlayerMsgs is every word the web player and the keyboard sheet show. The server owns the copy
// (internal/web/copy.go); player.js reads these from data-ts-msg-* attributes and never hard-codes
// a word. {name} marks a value the player fills in.
type PlayerMsgs struct {
	// Link is set on a share-link page: the controls that need an account are rendered hidden.
	Link bool
	// Desktop adds the window's rows to the keyboard sheet, in the desktop app only (decision 0023).
	Desktop bool

	// Eyes-free (M3b): its words and the addresses of its script and stylesheet, loaded on first use.
	EyesFree                EyesFreeMsgs
	EyesFreeJS, EyesFreeCSS string

	Open, PlayPrefix, PausePrefix, BackSeconds, ForwardSeconds, ChapterLeft string
	Rewound, CompatWait, CompatFailed, SignedOut, SignIn                    string
	ContinueAsk, OtherDevice, ContinueThere, StayHere                       string
	KeysTitle, KeysPlay, KeysSkip, KeysSearch, KeysLibrary, KeysHome        string
	KeysList, KeysClose, OpenBook, MinLeft                                  string

	// The full player (P1c-5a).
	ChapterOf, LeftInChapter, LeftInBookMinutes, LeftInBookHours, LeftInBookBoth, SubtitleSep, ScrubLabel, ScrubValue, FineScrub string
	ClosePlayer, PrevChapter, NextChapter, Speed, Sleep, Chapters           string
	OpenReader                                                              string // the book icon: "Read this book"
	Bookmark, MoreActions, GoToBook, MarkFinished, ChapterPlayed, OpenPlayer, Resume string
	ScrubBubble, UpNext                                                      string

	// Speed, sleep timer, volume and the bookmark key (P1c-5b).
	SpeedForBook, SpeedMakeUsual, JumpedFar, JumpedBack, SpeedUsualSet string
	SpeedValue, SpeedLabel, SpeedFine, SleepTitle, SleepEndOfChapter, SleepMinutes string
	SleepIn, SleepCustom, SleepCustomLabel, SleepStart, SleepTurnOff, SleepOffLabel string
	SleepOnLabel, Sleeping, SleepFading, SleepFadingShake, PlusTen, Volume         string
	BookmarkMoment, BookmarkFailed, KeysBookmark, Bookmarked, BookmarkMomentAt, BookmarkQueued string
	AddNote                                                                        string

	// The desktop bar's chapter waveform (PB1).
	WaveLabel, WaveValue, Hour, Hours, Minute, Minutes, Second, Seconds, WaveDrawing, WaveChapter string
	WaveLeft, WaveAhead, WaveBack, WaveDragChapter, DeltaMin, DeltaSec, BookTip, BarMeta         string

	// The Now playing panel and the Home hero while its book plays (NP1).
	ShowPlayer, NowPlaying string
}

// inShell returns the words for the shell the page is in: the desktop app's sheet has window rows.
func (m PlayerMsgs) inShell(shell string) PlayerMsgs {
	m.Desktop = shell == "desktop"
	return m
}

// fillN puts n where a message has {n}; the templates use it for the sleep timer choices.
func fillN(s string, n int) string {
	return strings.Replace(s, "{n}", strconv.Itoa(n), 1)
}

// Attrs are the data-ts-msg-* attributes of #player, one per string player.js uses.
func (m PlayerMsgs) Attrs() templ.Attributes {
	return templ.Attributes{
		"data-ts-msg-open":            m.Open,
		"data-ts-msg-open-book":       m.OpenBook,
		"data-ts-msg-min-left":        m.MinLeft,
		"data-ts-msg-play-prefix":     m.PlayPrefix,
		"data-ts-msg-pause-prefix":    m.PausePrefix,
		"data-ts-msg-back-seconds":    m.BackSeconds,
		"data-ts-msg-forward-seconds": m.ForwardSeconds,
		"data-ts-msg-chapter-left":    m.ChapterLeft,
		"data-ts-msg-rewound":         m.Rewound,
		"data-ts-msg-compat-wait":     m.CompatWait,
		"data-ts-msg-compat-failed":   m.CompatFailed,
		"data-ts-msg-signed-out":      m.SignedOut,
		"data-ts-msg-sign-in":         m.SignIn,
		"data-ts-msg-continue-ask":    m.ContinueAsk,
		"data-ts-msg-other-device":    m.OtherDevice,
		"data-ts-msg-continue-there":  m.ContinueThere,
		"data-ts-msg-stay-here":       m.StayHere,

		"data-ts-msg-chapter-of":      m.ChapterOf,
		"data-ts-msg-left-in-chapter": m.LeftInChapter,
		"data-ts-msg-left-in-book-minutes": m.LeftInBookMinutes,
		"data-ts-msg-left-in-book-hours":   m.LeftInBookHours,
		"data-ts-msg-left-in-book-both":    m.LeftInBookBoth,
		"data-ts-msg-subtitle-sep":         m.SubtitleSep,
		"data-ts-msg-scrub-label":     m.ScrubLabel,
		"data-ts-msg-scrub-value":     m.ScrubValue,
		"data-ts-msg-fine-scrub":      m.FineScrub,
		"data-ts-msg-close-player":    m.ClosePlayer,
		"data-ts-msg-prev-chapter":    m.PrevChapter,
		"data-ts-msg-next-chapter":    m.NextChapter,
		"data-ts-msg-speed":           m.Speed,
		"data-ts-msg-sleep":           m.Sleep,
		"data-ts-msg-chapters":        m.Chapters,
		"data-ts-msg-bookmark":        m.Bookmark,
		"data-ts-msg-more-actions":    m.MoreActions,
		"data-ts-msg-go-to-book":      m.GoToBook,
		"data-ts-msg-mark-finished":   m.MarkFinished,
		"data-ts-msg-chapter-played":  m.ChapterPlayed,
		"data-ts-msg-open-player":     m.OpenPlayer,
		"data-ts-msg-resume":          m.Resume,
		"data-ts-msg-scrub-bubble":    m.ScrubBubble,

		"data-ts-msg-speed-value":         m.SpeedValue,
		"data-ts-msg-speed-label":         m.SpeedLabel,
		"data-ts-msg-jumped-far":          m.JumpedFar,
		"data-ts-msg-speed-usual-set":     m.SpeedUsualSet,
		"data-ts-msg-jumped-back":         m.JumpedBack,
		"data-ts-msg-sleep-in":            m.SleepIn,
		"data-ts-msg-sleep-off-label":     m.SleepOffLabel,
		"data-ts-msg-sleep-on-label":      m.SleepOnLabel,
		"data-ts-msg-sleeping":            m.Sleeping,
		"data-ts-msg-sleep-fading":        m.SleepFading,
		"data-ts-msg-sleep-fading-shake":  m.SleepFadingShake,
		"data-ts-msg-bookmark-failed":     m.BookmarkFailed,
		"data-ts-msg-bookmarked":          m.Bookmarked,
		"data-ts-msg-bookmark-moment-at":  m.BookmarkMomentAt,
		"data-ts-msg-bookmark-queued":     m.BookmarkQueued,

		"data-ts-msg-wave-label":        m.WaveLabel,
		"data-ts-msg-wave-value":        m.WaveValue,
		"data-ts-msg-hour":              m.Hour,
		"data-ts-msg-hours":             m.Hours,
		"data-ts-msg-minute":            m.Minute,
		"data-ts-msg-minutes":           m.Minutes,
		"data-ts-msg-second":            m.Second,
		"data-ts-msg-seconds":           m.Seconds,
		"data-ts-msg-wave-drawing":      m.WaveDrawing,
		"data-ts-msg-wave-chapter":      m.WaveChapter,
		"data-ts-msg-wave-left":         m.WaveLeft,
		"data-ts-msg-wave-ahead":        m.WaveAhead,
		"data-ts-msg-wave-back":         m.WaveBack,
		"data-ts-msg-wave-drag-chapter": m.WaveDragChapter,
		"data-ts-msg-delta-min":         m.DeltaMin,
		"data-ts-msg-delta-sec":         m.DeltaSec,
		"data-ts-msg-book-tip":          m.BookTip,
		"data-ts-msg-bar-meta":          m.BarMeta,
		"data-ts-msg-show-player":       m.ShowPlayer,
		"data-ts-msg-now-playing":       m.NowPlaying,
	}
}

// PlayerSlot holds the mini-player and the one audio element. Both live outside #main, so a boosted
// swap never re-creates them; player.js (P1c-4) fills the skeleton and shows it when a book is
// loaded. The open link goes to the book page without script; with it, player-full.js opens the
// full player instead (P1c-5). From 1280 px the bar is a grid (now playing, transport, the chapter waveform, tools;
// docs/design/tendshelf-player-bar); the wrappers are display: contents below that, so the phone and
// tablet mini-player keeps its flat row. The waveform is data-ts-wave="bar" (waveform.js). The bar's
// sleep card is a sibling of #player, not inside it: the hero's Resume button hides the slot (P1c-4),
// and a fade must still be seen and answered with "+10 min" on every page.
templ PlayerSlot(m PlayerMsgs) {
	<section id="player" class="ts-player-slot" aria-label="Now playing" hx-preserve hidden { m.Attrs()... }>
		<div class="ts-mini ts-pbar" id="mini-player">
			<div class="ts-pbar__book" data-ts-bar-book>
				<span class="ts-pbar__booktip" data-ts-bar-booktip aria-hidden="true"></span>
			</div>
			<div class="ts-mini__progress" data-ts-mini-progress></div>
			<a class="ts-mini__open" href="/" hx-boost="false" data-ts-open>
				<span class="ts-cover ts-mini__cover"><img data-ts-cover alt="" width="48" height="48"/></span>
				<span class="ts-mini__text">
					<span class="ts-mini__title" data-ts-title></span>
					<span class="ts-mini__meta" data-ts-meta></span>
					<span class="ts-mini__meta ts-pbar__meta" data-ts-bar-meta>
						<span class="ts-pbar__author" data-ts-bar-author></span>
						<span class="ts-pbar__metaleft" data-ts-bar-left></span>
					</span>
				</span>
			</a>
			<div class="ts-pbar__transport">
				<button type="button" class="ts-iconbtn ts-skip" data-ts-back>
					@Icon("skip-back", false)
					<span class="ts-skip__num" data-ts-back-num aria-hidden="true"></span>
				</button>
				<button type="button" class="ts-iconbtn ts-iconbtn--filled" data-ts-toggle>
					<span data-ts-icon-play>@Icon("play", true)</span>
					<span data-ts-icon-pause>@Icon("pause", true)</span>
				</button>
				<button type="button" class="ts-iconbtn ts-skip ts-mini__forward" data-ts-forward>
					@Icon("skip-forward", false)
					<span class="ts-skip__num" data-ts-forward-num aria-hidden="true"></span>
				</button>
			</div>
			<div class="ts-pbar__seek">
				<div class="ts-wave ts-wave--bar" data-ts-wave="bar">
					<div class="ts-wave__needle"></div>
					<div class="ts-wave__hoverline"></div>
					<div class="ts-wave__tip" aria-hidden="true">
						<span data-ts-tip-time></span>
						<small data-ts-tip-rel></small>
					</div>
					<label class="ts-sr" for="ts-scrub-bar">{ m.WaveLabel }</label>
					<input id="ts-scrub-bar" class="ts-wave__input" type="range" min="0" max="0" step="1" value="0"/>
				</div>
				<div class="ts-pbar__times">
					<span data-pbar="elapsed"></span>
					<span data-pbar="chapter"></span>
					<span class="ts-pbar__left" data-pbar="left"></span>
				</div>
			</div>
			<div class="ts-pbar__tools">
				<button type="button" class="ts-iconbtn ts-mini__speed" data-ts-bar-speed aria-haspopup="dialog" aria-label={ m.Speed }>
					<span class="ts-num" data-ts-bar-speed-value></span>
				</button>
				<button type="button" class="ts-iconbtn ts-mini__sleep" data-ts-bar-sleep aria-haspopup="dialog" aria-label={ m.SleepOffLabel }>
					@Icon("sleep", false)
					<span class="ts-num" data-ts-bar-sleep-left hidden></span>
				</button>
				<button type="button" class="ts-iconbtn" data-ts-bar-chapters aria-haspopup="dialog" aria-label={ m.Chapters }>
					@Icon("chapters", false)
				</button>
				<a class="ts-iconbtn" data-ts-bar-read href="/" hidden aria-label={ m.OpenReader }>
					@Icon("book-open", false)
				</a>
				<button type="button" class="ts-iconbtn" data-ts-bar-bookmark aria-label={ m.BookmarkMoment } if m.Link { hidden }>
					@Icon("bookmark", false)
				</button>
				<div class="ts-pbar__volume" data-ts-volume-wrap>
					<button type="button" class="ts-iconbtn" data-ts-bar-volume aria-expanded="false" aria-controls="ts-volume-pop" aria-label={ m.Volume }>
						@Icon("output", false)
					</button>
					<div id="ts-volume-pop" class="ts-pbar__volume-pop" hidden>
						<label class="ts-sr" for="ts-volume">{ m.Volume }</label>
						<input id="ts-volume" class="ts-pbar__range" type="range" min="0" max="100" step="5" value="100" data-ts-volume/>
					</div>
				</div>
				<button type="button" class="ts-iconbtn" data-ts-bar-expand aria-expanded="false" aria-label={ m.OpenPlayer }>
					@Icon("expand", false)
				</button>
			</div>
		</div>
	</section>
	<audio id="audio" preload="none" hx-preserve></audio>
	@SleepCard(m, "bar")
}
