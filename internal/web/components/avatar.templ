package components

import (
	"hash/fnv"
	"strconv"
	"strings"
	"unicode"
)

// Avatar is a round initials badge (handoff Avatar README). size is "sm" (32), "md" (44) or "lg"
// (72). The background is one of six cover-palette darks picked from the id, so a person keeps the
// same colour everywhere. It is decorative: the name always sits beside it as text.
templ Avatar(id, name, size string) {
	<span class={ "ts-avatar", "ts-avatar--" + size, "ts-avatar--c" + strconv.Itoa(avatarColour(id)) } aria-hidden="true">{ initials(name) }</span>
}

// initials is the first letter of the first two words, upper-cased, or "?" for an empty name.
func initials(name string) string {
	var out []rune
	for _, w := range strings.Fields(name) {
		if len(out) == 2 {
			break
		}
		for _, r := range w {
			out = append(out, unicode.ToUpper(r))
			break
		}
	}
	if len(out) == 0 {
		return "?"
	}
	return string(out)
}

// avatarColour is FNV-1a of id, modulo the six palette entries (.ts-avatar--c0 to c5).
func avatarColour(id string) int {
	h := fnv.New32a()
	_, _ = h.Write([]byte(id))
	return int(h.Sum32() % 6)
}
