package components

import (
	"strconv"
	"strings"
)

// Scrubber is one chapter wide (decision 0005, a declared difference from the design-system Scrubber):
// its ends are the chapter's start and end. The fill and the needle are drawn by player-full.js
// through custom properties, and the range input on top carries the keyboard and screen reader
// semantics. which is "full" or "bar".
templ Scrubber(m PlayerMsgs, class, which string) {
	<div class={ "ts-scrub", class } data-ts-scrub={ which }>
		<div class="ts-wave" aria-hidden="true" data-ts-wave></div>
		<div class="ts-scrub__line"></div>
		<div class="ts-scrub__fill"></div>
		<div class="ts-scrub__needle"></div>
		<div class="ts-scrub__bubble" aria-hidden="true" data-ts-bubble></div>
		<label class="ts-sr" for={ "ts-scrub-" + which }>{ m.ScrubLabel }</label>
		<input id={ "ts-scrub-" + which } class="ts-scrub__input" type="range" min="0" max="0" step="1" value="0" data-ts-range/>
	</div>
}

// PlayerFull is the full player (P1c-5): a dialog outside #main, kept by hx-preserve, shown full
// screen below 1280 px and as a side panel from there. player-full.js fills it from window.tsPlayer.
// The markup order is the screen reader order of the HANDOFF: title, chapter, time left, play and
// pause, skip, scrubber, settings; the stylesheet puts the scrubber above the transport, the
// chapter label in the header and the transport buttons in their visual row. The Speed, Sleep and Chapters
// sheets slide over the body; the sleep card and the toasts sit inside the dialog so a modal player
// still shows them (P1c-5b).
templ PlayerFull(m PlayerMsgs) {
	<dialog id="player-full" class="ts-player" aria-labelledby="player-full-title" hx-preserve>
		<div class="ts-player__body" data-ts-full-body>
			<div id="now-panel" class="ts-np" hidden></div>
			<header class="ts-player__head">
				<button type="button" class="ts-iconbtn" data-ts-close-player aria-label={ m.ClosePlayer }>
					@playerChevron()
				</button>
				<div class="ts-player__tools">
					<button type="button" class="ts-iconbtn ts-player__mark" data-ts-bookmark aria-label={ m.BookmarkMoment }>
						@Icon("bookmark", false)
					</button>
					<details class="ts-player__menu" data-ts-chipmenu data-ts-full-menu>
						<summary class="ts-iconbtn" aria-label={ m.MoreActions }>
							<svg class="ts-icon ts-icon--fill" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.7"></circle><circle cx="12" cy="12" r="1.7"></circle><circle cx="19" cy="12" r="1.7"></circle></svg>
						</summary>
						<div class="ts-player__menubody" role="group" aria-label={ m.MoreActions }>
							<a class="ts-player__menuitem" href="/" data-ts-full-book>{ m.GoToBook }</a>
							<form method="post" action="/" data-ts-full-finish>
								<input type="hidden" name="_csrf" value=""/>
								<input type="hidden" name="finished" value="1"/>
								<input type="hidden" name="next" value=""/>
								<button type="submit" class="ts-player__menuitem">{ m.MarkFinished }</button>
							</form>
						</div>
					</details>
				</div>
			</header>
			<span class="ts-book-block ts-player__block">
				<span class="ts-cover ts-player__cover"><img data-ts-full-cover alt="" width="256" height="256"/></span>
			</span>
			<h2 id="player-full-title" class="title-2 ts-player__title" data-ts-full-title></h2>
			<p class="body ts-player__author">
				<span class="ts-player__chapter-title" data-ts-full-chapter-title></span><span data-ts-full-sep></span><span data-ts-full-author></span>
			</p>
			<span class="ts-overline ts-num ts-player__chapter" data-ts-full-chapter></span>
			<div class="ts-player__times">
				<span class="time-display" data-ts-full-clock></span>
				<span class="label ts-num ts-player__left" data-ts-full-left></span>
			</div>
			<div class="ts-transport ts-player__transport">
				<button type="button" class="ts-iconbtn ts-iconbtn--cover ts-iconbtn--xl" data-ts-full-toggle>
					<span data-ts-icon-play>@Icon("play", true)</span>
					<span data-ts-icon-pause>@Icon("pause", true)</span>
				</button>
				<button type="button" class="ts-iconbtn ts-iconbtn--md ts-skip" data-ts-full-back>
					@Icon("skip-back", false)
					<span class="ts-skip__num" data-ts-full-back-num aria-hidden="true"></span>
				</button>
				<button type="button" class="ts-iconbtn ts-iconbtn--md ts-skip" data-ts-full-forward>
					@Icon("skip-forward", false)
					<span class="ts-skip__num" data-ts-full-forward-num aria-hidden="true"></span>
				</button>
				<button type="button" class="ts-iconbtn ts-iconbtn--md" data-ts-full-prev aria-label={ m.PrevChapter }>
					@Icon("prev-chapter", false)
				</button>
				<button type="button" class="ts-iconbtn ts-iconbtn--md" data-ts-full-next aria-label={ m.NextChapter }>
					@Icon("next-chapter", false)
				</button>
			</div>
			<div class="ts-player__scrub">
				<div class="ts-ruler ts-player__ruler" aria-hidden="true" data-ts-ruler>
					<div class="ts-ruler__line"></div>
					<span class="ts-player__ruler-ticks" data-ts-ruler-ticks></span>
					<div class="ts-ruler__fill"></div>
				</div>
				@Scrubber(m, "", "full")
				<div class="ts-scrub__times">
					<span data-ts-full-elapsed></span>
					<span aria-hidden="true" data-ts-full-fine></span>
					<span data-ts-full-book-left></span>
				</div>
			</div>
			<div class="ts-player-bar ts-player__bar">
				<button type="button" class="ts-player-bar__item" data-ts-open-speed aria-haspopup="dialog" aria-label={ m.Speed }>
					<span class="ts-player-bar__value" data-ts-full-speed></span>
					<span class="ts-player-bar__label">{ m.Speed }</span>
				</button>
				<button type="button" class="ts-player-bar__item" data-ts-open-sleep aria-haspopup="dialog" aria-label={ m.SleepOffLabel }>
					<span class="ts-player-bar__value" data-ts-full-sleep-left hidden></span>
					@Icon("sleep", false)
					<span class="ts-player-bar__label">{ m.Sleep }</span>
				</button>
				<button type="button" class="ts-player-bar__item" data-ts-open-chapters>
					@Icon("chapters", false)
					<span class="ts-player-bar__label">{ m.Chapters }</span>
				</button>
				<button type="button" class="ts-player-bar__item ts-player__barmark" data-ts-bookmark aria-keyshortcuts="B" aria-label={ m.BookmarkMoment }>
					@Icon("bookmark", false)
					<span class="ts-player-bar__label">{ m.Bookmark }</span>
				</button>
			</div>
			@SleepCard(m, "full")
		</div>
		<div class="ts-player__sheet" data-ts-full-sheet>
			<div class="ts-player__sheetwrap" data-ts-chapters-sheet hidden>
				<div class="ts-scrim" data-ts-sheet-close></div>
				<section class="ts-sheet" role="dialog" aria-labelledby="player-full-chapters-title">
					<div class="ts-sheet__grab"></div>
					<div class="ts-sheet__head">
						<h3 id="player-full-chapters-title" class="ts-sheet__title">{ m.Chapters }</h3>
						<button type="button" class="ts-iconbtn" data-ts-sheet-close aria-label={ m.KeysClose }>
							@Icon("close", false)
						</button>
					</div>
					<ol class="ts-player__chapters" data-ts-chapter-list></ol>
				</section>
			</div>
			<div class="ts-player__sheetwrap" data-ts-speed-sheet hidden>
				<div class="ts-scrim" data-ts-sheet-close></div>
				<section class="ts-sheet" role="dialog" aria-labelledby="player-full-speed-title">
					<div class="ts-sheet__grab"></div>
					<div class="ts-sheet__head">
						<h3 id="player-full-speed-title" class="ts-sheet__title">{ m.Speed }</h3>
						<button type="button" class="ts-iconbtn" data-ts-sheet-close aria-label={ m.KeysClose }>
							@Icon("close", false)
						</button>
					</div>
					<ul class="ts-options" role="radiogroup" aria-labelledby="player-full-speed-title">
						for _, v := range []string{"0.8", "1.0", "1.2", "1.5", "2.0"} {
							<li>
								<button type="button" class="ts-option" role="radio" aria-checked="false" data-ts-speed-choice={ v }>
									<span>{ fillValue(m.SpeedValue, v) }</span>
									<span class="ts-option__check">@Icon("check", false)</span>
								</button>
							</li>
						}
					</ul>
					<div class="ts-player__fine">
						<label for="ts-speed-fine">{ m.SpeedFine }</label>
						<output for="ts-speed-fine" class="ts-num" data-ts-speed-out></output>
						<input id="ts-speed-fine" type="range" min="0.5" max="3" step="0.05" data-ts-speed-range/>
					</div>
				</section>
			</div>
			<div class="ts-player__sheetwrap" data-ts-sleep-sheet hidden>
				<div class="ts-scrim" data-ts-sheet-close></div>
				<section class="ts-sheet" role="dialog" aria-labelledby="player-full-sleep-title">
					<div class="ts-sheet__grab"></div>
					<div class="ts-sheet__head">
						<h3 id="player-full-sleep-title" class="ts-sheet__title">{ m.SleepTitle }</h3>
						<button type="button" class="ts-iconbtn" data-ts-sheet-close aria-label={ m.KeysClose }>
							@Icon("close", false)
						</button>
					</div>
					<ul class="ts-options" role="radiogroup" aria-labelledby="player-full-sleep-title">
						<li>
							<button type="button" class="ts-option" role="radio" aria-checked="false" data-ts-sleep-choice="chapter">
								<span>{ m.SleepEndOfChapter }</span>
								<span class="ts-option__meta" data-ts-sleep-meta></span>
								<span class="ts-option__check">@Icon("check", false)</span>
							</button>
						</li>
						for _, n := range []int{15, 30, 60} {
							<li>
								<button type="button" class="ts-option" role="radio" aria-checked="false" data-ts-sleep-choice={ strconv.Itoa(n) }>
									<span>{ fillN(m.SleepMinutes, n) }</span>
									<span class="ts-option__check">@Icon("check", false)</span>
								</button>
							</li>
						}
						<li>
							<button type="button" class="ts-option" role="radio" aria-checked="false" data-ts-sleep-choice="custom">
								<span>{ m.SleepCustom }</span>
								<span class="ts-option__check">@Icon("check", false)</span>
							</button>
						</li>
						<li>
							<button type="button" class="ts-option" role="radio" aria-checked="false" data-ts-sleep-choice="off" hidden>
								<span>{ m.SleepTurnOff }</span>
								<span class="ts-option__check">@Icon("check", false)</span>
							</button>
						</li>
					</ul>
					<div class="ts-player__custom" data-ts-sleep-custom hidden>
						<label for="ts-sleep-minutes">{ m.SleepCustomLabel }</label>
						<input id="ts-sleep-minutes" class="ts-input" type="number" min="1" max="240" step="1" inputmode="numeric" data-ts-sleep-minutes/>
						<button type="button" class="ts-btn ts-btn--primary" data-ts-sleep-start>{ m.SleepStart }</button>
					</div>
				</section>
			</div>
		</div>
		<div class="ts-toasts ts-player__toasts" data-ts-full-toasts aria-live="polite"></div>
		<template data-ts-bookmark-toast>
			<div class="ts-toast" role="status">
				<span class="ts-toast__ok">@Icon("check", false)</span>
				<span>
					<span data-ts-toast-text></span>
					<a data-ts-toast-link href="/" hx-target="#sheet" hx-select="#sheet > *" hx-swap="innerHTML" hx-push-url="false" aria-haspopup="dialog">{ m.AddNote }</a>
				</span>
			</div>
		</template>
		<template data-ts-chapter-row>
			<li>
				<button type="button" class="ts-player__chrow">
					<span class="ts-player__chnum ts-num"></span>
					<span class="ts-player__chtitle"></span>
					<span class="ts-player__chtime ts-num"></span>
					<span class="ts-player__chdone">
						@Icon("check", false)
					</span>
				</button>
			</li>
		</template>
	</dialog>
}

templ playerChevron() {
	<svg class="ts-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
}

// fillValue puts v where a message has {v} (the speed choices).
func fillValue(message, v string) string {
	return strings.Replace(message, "{v}", v, 1)
}

// SleepCard is the "Sleeping in N seconds" card with its "+10 min" button. It is rendered twice:
// inside the full player (where="full") and beside the bar (where="bar", a layout sibling of #player so
// it shows even while the hero hides the bar); player-full.js shows the
// one that matches whether the full player is open. The per-second count is aria-hidden; a polite
// status line says it once at the start of the fade.
templ SleepCard(m PlayerMsgs, where string) {
	<section class="ts-sleepcard" data-ts-sleep-card={ where } if where == "bar" { id="sleep-card-bar" hx-preserve } hidden>
		@Icon("sleep", false)
		<div class="ts-sleepcard__text">
			<p class="body ts-sleepcard__title" aria-hidden="true" data-ts-sleep-count></p>
			<p class="caption ts-sleepcard__hint" aria-hidden="true" data-ts-sleep-hint></p>
			<p class="ts-sr" role="status" data-ts-sleep-said></p>
		</div>
		<button type="button" class="ts-btn ts-btn--secondary" data-ts-sleep-plus>{ m.PlusTen }</button>
	</section>
}
