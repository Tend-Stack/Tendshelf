package components

// EmptyState is the shelf-art empty state of the handoff (copy deck: "Your shelf is empty",
// "Nothing shared yet"). action is the one button or link under the text, or nil. Pass the heading
// level the page needs through the surrounding structure: the title is an h2.
templ EmptyState(title, body string, action templ.Component) {
	<div class="ts-empty">
		<svg class="ts-empty__art" viewBox="0 0 120 72" aria-hidden="true">
			@templ.Raw(emptyArt)
		</svg>
		<h2 class="ts-empty__title">{ title }</h2>
		<p class="ts-empty__body">{ body }</p>
		if action != nil {
			@action
		}
	</div>
}

const emptyArt = `<rect x="0" y="64" width="120" height="6" rx="2" fill="var(--brand-walnut)"/><rect x="22" y="22" width="14" height="42" rx="2" fill="none" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="4 4"/><rect x="40" y="12" width="16" height="52" rx="2" fill="none" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="4 4"/><rect x="60" y="28" width="12" height="36" rx="2" fill="var(--accent-fill)"/><path d="M72 46c3-8 5-8 8 0s5 8 8 0 4-5 6 0" fill="none" stroke="var(--accent-fill)" stroke-width="2.5" stroke-linecap="round"/>`
