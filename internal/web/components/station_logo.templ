package components

import "strconv"

// StationLogo is the generated picture of a station that has no kept logo (or only a tiny one): its initials,
// large and centred in the serif face, on one of the six avatar colours picked from the station id, so a station
// keeps its colour everywhere. size is "36", "56" or "fill" (the width of its box). It is decorative: the name
// always sits beside it as text, so a screen reader skips it.
templ StationLogo(id, name, size string) {
	<span class={ "ts-avatar", "ts-stnlogo", "ts-stnlogo--" + size, "ts-avatar--c" + strconv.Itoa(avatarColour(id)) } aria-hidden="true"><span class="ts-stnlogo__text">{ initials(name) }</span></span>
}

// StationInitials and StationColour are the same initials and colour number for the player's script, which draws
// the tile itself when a station has no picture (data-logo-initials, data-logo-colour).
func StationInitials(name string) string { return initials(name) }

// StationColour is the avatar colour number (0 to 5) of a station id.
func StationColour(id string) int { return avatarColour(id) }

// stationKey is what the colour is picked from: the station id, or the OndaCast slug of a suggestion, or the name.
func stationKey(v StationRowView) string {
	switch {
	case v.ID != "":
		return v.ID
	case v.AddSlug != "":
		return v.AddSlug
	}
	return v.Name
}
