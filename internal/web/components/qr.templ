package components

// QRView is a QR code ready to draw: a server-rendered SVG with one path (decision 0028). ViewBox
// includes the 4-module quiet zone; Label is the words a screen reader gets.
type QRView struct {
	ViewBox, Path, Label string
}

// QR draws the code as dark modules on a light plate. The colours come from --qr-ink and --qr-paper,
// which are the same in every theme, because a scanner needs dark on light.
templ QR(v QRView) {
	<svg class="ts-qr" viewBox={ v.ViewBox } role="img" aria-label={ v.Label } xmlns="http://www.w3.org/2000/svg">
		<rect class="ts-qr__paper" width="100%" height="100%"></rect>
		<path class="ts-qr__ink" d={ v.Path }></path>
	</svg>
}
