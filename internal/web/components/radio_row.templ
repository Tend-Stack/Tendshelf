package components

// StationRowView is one station in a list. The handler writes every word; no stream address is carried.
type StationRowView struct {
	ID, Name, Meta string
	// PlayHref is where the play button goes without JavaScript (the relay); PlayLabel names it.
	PlayHref, PlayLabel string
	// PlayWord is the visible word on a card's Play control.
	PlayWord string
	// RemoveAction is the remove form's address; empty draws no remove control (a recent station that is not kept).
	RemoveAction, RemoveLabel string
	// SaveAction is the save form's address, drawn on a recent station that is not kept; SaveWord and SaveLabel name it.
	SaveAction, SaveWord, SaveLabel string
	// AddSlug marks a suggested station that is not saved yet: the card draws a Save word button that posts the
	// OndaCast slug to /radio/stations, and no Play control. AddLabel names it.
	AddSlug, AddLabel string
	CSRF              string
	// Art is the station's logo from this server's own art route; empty draws no picture, like an episode row without art.
	Art CardView
	// SmallArt marks a kept logo that is small (under 200 px): it is drawn at its own size, centred on a plain tile.
	SmallArt bool
}

// StationRow is one station: play, the name and its facts, remove. The name and the facts are cut with an
// ellipsis, never pushed to a second row. Remove is a real form, so the row works without JavaScript.
templ StationRow(v StationRowView) {
	<li class="ts-row ts-stnrow">
		<a class="ts-iconbtn ts-iconbtn--tonal ts-stnrow__play" href={ templ.SafeURL(v.PlayHref) } hx-boost="false" data-ts-play={ v.ID } aria-label={ v.PlayLabel }>
			@Icon("play", true)
			<span hidden data-ts-pause-icon>
				@Icon("pause", true)
			</span>
		</a>
		<span class="ts-stnrow__main">
			if v.Art.CoverSrc != "" {
				@Cover(v.Art, "36")
			} else {
				@StationLogo(stationKey(v), v.Name, "36")
			}
			<span class="ts-row__text">
				<span class="ts-row__title ts-truncate">{ v.Name }</span>
				if v.Meta != "" {
					<span class="ts-row__meta ts-truncate">{ v.Meta }</span>
				}
			</span>
		</span>
		if v.SaveAction != "" {
			<form class="ts-stnrow__remove" method="post" action={ templ.SafeURL(v.SaveAction) }>
				<input type="hidden" name="_csrf" value={ v.CSRF }/>
				<button type="submit" class="ts-btn ts-btn--quiet ts-stnrow__save" aria-label={ v.SaveLabel }>{ v.SaveWord }</button>
			</form>
		}
		if v.RemoveAction != "" {
			<form class="ts-stnrow__remove" method="post" action={ templ.SafeURL(v.RemoveAction) }>
				<input type="hidden" name="_csrf" value={ v.CSRF }/>
				<button type="submit" class="ts-iconbtn" aria-label={ v.RemoveLabel }>
					@Icon("close", false)
				</button>
			</form>
		}
	</li>
}

// StationCard is one station as a card on the Radio page: the logo (a plain tile with the name when there is none),
// the name, one line of genre and place, one Play control and the keep toggle. The player's script turns Play into
// Pause while the station is on air (word and icon change, so it is never colour alone). Both controls are real
// forms or links, so the card works without JavaScript.
templ StationCard(v StationRowView) {
	<li class="ts-stncard">
		<span class={ "ts-stncard__art", templ.KV("ts-stncard__art--small", v.SmallArt) }>
			if v.Art.CoverSrc != "" {
				@Cover(v.Art, "fill")
			} else {
				@StationLogo(stationKey(v), v.Name, "fill")
			}
		</span>
		<span class="ts-stncard__name ts-clamp-2">{ v.Name }</span>
		<span class="ts-stncard__meta ts-truncate">{ v.Meta }</span>
		<span class="ts-stncard__actions">
			if v.PlayHref != "" {
			<a class="ts-btn ts-btn--secondary ts-stncard__play" href={ templ.SafeURL(v.PlayHref) } hx-boost="false" data-ts-play={ v.ID } aria-label={ v.PlayLabel }>
				@Icon("play", true)
				<span hidden data-ts-pause-icon>
					@Icon("pause", true)
				</span>
				<span data-ts-play-label>{ v.PlayWord }</span>
			</a>
			}
			if v.AddSlug != "" {
				<form class="ts-stncard__add" method="post" action="/radio/stations">
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<input type="hidden" name="slug" value={ v.AddSlug }/>
					<button type="submit" class="ts-btn ts-btn--secondary" aria-label={ v.AddLabel }>{ v.SaveWord }</button>
				</form>
			}
			if v.SaveAction != "" {
				<form class="ts-stncard__keep" method="post" action={ templ.SafeURL(v.SaveAction) }>
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<button type="submit" class="ts-iconbtn ts-stncard__save" aria-label={ v.SaveLabel } aria-pressed="false">
						@Icon("star", false)
					</button>
				</form>
			}
			if v.RemoveAction != "" {
				<form class="ts-stncard__keep" method="post" action={ templ.SafeURL(v.RemoveAction) }>
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<button type="submit" class="ts-iconbtn is-on" aria-label={ v.RemoveLabel } aria-pressed="true">
						@Icon("star", true)
					</button>
				</form>
			}
		</span>
	</li>
}
