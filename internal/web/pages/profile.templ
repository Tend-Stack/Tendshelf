package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// ProfileDevice is one signed-in browser or app of the person.
type ProfileDevice struct {
	// ID is the first 16 hex characters of the stored session hash; never the token.
	ID string
	// Title is "This device" for the current one, otherwise the device label.
	Title string
	// Meta is the device label for the current browser, otherwise when it was last seen.
	Meta    string
	Current bool
	// Icon is "phone" or "laptop"; Action is the sign-out form's URL (a browser session or an app).
	Icon, Action string
	// Session is true for a browser session (not an app): only those may fold into one line.
	Session bool
	// Aria is the sign-out button's label ("Sign out Chrome on Linux, 2 hours ago").
	Aria string
}

// ProfileView is what Profile shows. The handler writes every sentence.
type ProfileView struct {
	CSRF       string
	UserID     string
	Name       string
	Role       string // Owner, Admin, Member or Listener
	ServerName string
	// Stats is the "Your listening" panel, the first of Profile.
	Stats components.ListeningStatsView
	// Banner is the line after a password change, or empty.
	Banner string
	// DevicesLine is the caption of the "Your devices" row ("This device and 8 others").
	DevicesLine string
	// Libraries is the "Your server" row for a person who manages libraries, or empty.
	Libraries string
	// UsersRow is the "Users & invites" row ("3 people · 1 invite waiting") for a person who may
	// manage users, or empty.
	UsersRow string
	// Email shows the "Email" row of "Your server", for the owner only.
	Email bool
	// Backups is the "Backups" row ("Last backup 3 hours ago · 1.2 MB" or "No backup yet"), owner only.
	Backups string
	// Shelves is the "Your shelves" row ("3 shelves"), empty for people who may not use shelves.
	Shelves string
	// NoPassword is true for an account made from an invite that never added a password: Profile
	// then offers "Keep your place" instead of "Change password".
	NoPassword bool
	Version    string
}

// meChevron is the trailing arrow of a row, drawn in CSS.
templ meChevron() {
	<span class="ts-me__chev" aria-hidden="true"></span>
}

// Profile is the person's own page: who they are, their settings and devices, and sign out.
templ Profile(v ProfileView) {
	<div class="ts-me">
		<header class="ts-me__head">
			@components.Avatar(v.UserID, v.Name, "lg")
			<div class="ts-me__who">
				<h1 class="title-2 ts-me__name">{ v.Name }</h1>
				<span class="ts-me__sub">
					<span class={ "ts-role", templ.KV("ts-role--owner", v.Role == "Owner") }>{ v.Role }</span>
					if v.ServerName != "" {
						<span class="caption ts-me__lead">{ v.ServerName }</span>
					}
				</span>
			</div>
		</header>
		if v.Banner != "" {
			<p class="ts-banner ts-me__banner" role="status">
				@components.Icon("check", false)
				{ v.Banner }
			</p>
		}
		<div class="ts-groups">
		@components.ListeningStats(v.Stats)
		<section aria-labelledby="pf-mine" class="ts-me__section ts-group">
			<h2 id="pf-mine" class="ts-sr">Yours</h2>
			if v.Shelves != "" {
				<a class="ts-me__row" href="/shelves">
					<span class="ts-me__rowtext">
						<span class="body ts-me__rowtitle">Your shelves</span>
						<span class="caption ts-me__lead">{ v.Shelves }</span>
					</span>
					@meChevron()
				</a>
			}
			<a class="ts-me__row ts-me__hub" href="/me/settings">
				<span class="body ts-me__rowtext">Settings</span>
				@meChevron()
			</a>
			if v.NoPassword {
				<a class="ts-me__row" href="/welcome">
					<span class="ts-me__rowtext">
						<span class="body ts-me__rowtitle">Keep your place</span>
						<span class="caption ts-me__lead">Add a password so you can sign in elsewhere</span>
					</span>
					@meChevron()
				</a>
			} else {
				<a class="ts-me__row" href="/me/password">
					<span class="body ts-me__rowtext">Change password</span>
					@meChevron()
				</a>
			}
		</section>
		<section aria-labelledby="pf-dev" class="ts-me__section ts-group">
			<h2 id="pf-dev" class="ts-sr">Devices</h2>
			<a class="ts-me__row" href="/me/devices">
				<span class="ts-me__rowtext">
					<span class="body ts-me__rowtitle">Your devices</span>
					<span class="caption ts-me__lead">{ v.DevicesLine }</span>
				</span>
				@meChevron()
			</a>
		</section>
		if v.Libraries != "" || v.UsersRow != "" || v.Email || v.Backups != "" {
			<section aria-labelledby="pf-srv" class="ts-me__section ts-group ts-me__hub">
				<h2 id="pf-srv" class="ts-overline">Your server</h2>
				if v.UsersRow != "" {
					<a class="ts-me__row" href="/admin/users">
						<span class="ts-me__rowtext">
							<span class="body ts-me__rowtitle">Users &amp; invites</span>
							<span class="caption ts-me__lead">{ v.UsersRow }</span>
						</span>
						@meChevron()
					</a>
				}
				if v.Libraries != "" {
					<a class="ts-me__row" href="/admin/libraries">
						<span class="ts-me__rowtext">
							<span class="body ts-me__rowtitle">Libraries</span>
							<span class="caption ts-me__lead">{ v.Libraries }</span>
						</span>
						@meChevron()
					</a>
				}
				if v.Email {
					<a class="ts-me__row" href="/admin/email">
						<span class="ts-me__rowtext">
							<span class="body ts-me__rowtitle">Email</span>
							<span class="caption ts-me__lead">Send invitations from Tendshelf</span>
						</span>
						@meChevron()
					</a>
				}
				if v.Backups != "" {
					<a class="ts-me__row" href="/admin/backups">
						<span class="ts-me__rowtext">
							<span class="body ts-me__rowtitle">Backups</span>
							<span class="caption ts-me__lead">{ v.Backups }</span>
						</span>
						@meChevron()
					</a>
				}
			</section>
		}
		</div>
		<form method="post" action="/logout" class="ts-me__signout" hx-boost="false">
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			<button type="submit" class="ts-btn ts-btn--secondary ts-btn--block">Sign out</button>
		</form>
		<p class="caption ts-me__foot">Tendshelf { v.Version } · open source</p>
	</div>
}
