package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// ProfileStyles is every stylesheet Profile adds to the shell: the hero and shelf rows it borrows, the
// account rows and its own page layout.
var ProfileStyles = []string{"css/pages-home.css", "css/pages-library.css", "css/pages-shelves.css", "css/pages-me.css", "css/pages-profile.css"}

// ProfileDevice is one signed-in browser or app of the person.
type ProfileDevice struct {
	// ID is the first 16 hex characters of the stored session hash; never the token.
	ID string
	// Title is "This device" for the current one, otherwise the device label.
	Title string
	// Meta is the device label for the current browser, otherwise when it was last seen.
	Meta    string
	Current bool
	// Icon is "phone" or "laptop"; Action is the sign-out form's URL (a browser session or an app).
	Icon, Action string
	// Session is true for a browser session (not an app): only those may fold into one line.
	Session bool
	// Aria is the sign-out button's label ("Sign out Chrome on Linux, 2 hours ago").
	Aria string
	// Name is what the person called it: a browser's own name ("" when it has none) or an app's name.
	Name string
}

// ProfileBook is a book under way in "Also in progress": the card and at most one resume control, the
// format the person used last. Both controls are nil when the person may use neither format.
type ProfileBook struct {
	Card components.CardView
	Play *components.PlayButtonView
	Read *components.ReadButtonView
}

// ProfileBooksView is the person's books on Profile. Hero is nil when nothing is in progress.
type ProfileBooksView struct {
	Hero *HomeHeroView
	// Empty is the "Nothing in progress" state, set when Hero is nil.
	Empty *ListeningEmpty
	Also  []ProfileBook
	// SeeAllURL opens the library's Unfinished list; it is empty when six or fewer are under way.
	SeeAllURL string
	Finished  []components.CardView
	// FinishedURL opens the library's Finished list; it is empty when nothing is finished.
	FinishedURL string
}

// ProfileView is what Profile shows. The handler writes every sentence.
type ProfileView struct {
	CSRF       string
	UserID     string
	Name       string
	Role       string // Owner, Admin, Member or Listener
	ServerName string
	// Stats is the "Your listening" panel, at the head of the side column.
	Stats components.ListeningStatsView
	// Banner is the line after a password change, or empty.
	Banner string
	// DevicesLine is the caption of the "Your devices" row ("This device and 8 others").
	DevicesLine string
	// Libraries is the "Your server" row for a person who manages libraries, or empty.
	Libraries string
	// UsersRow is the "Users & invites" row ("3 people · 1 invite waiting") for a person who may
	// manage users, or empty.
	UsersRow string
	// Email shows the "Email" row of "Your server", for the owner only.
	Email bool
	// Backups is the "Backups" row ("Last backup 3 hours ago · 1.2 MB" or "No backup yet"), owner only.
	Backups string
	// Books is the person's books: the hero, the others under way and the lately finished.
	Books ProfileBooksView
	// ShelfRows are the first shelves for the "Your shelves" card; CanShelve is false for a person who
	// may not use shelves (the card is then not drawn).
	ShelfRows []ShelfRowView
	CanShelve bool
	// NoPassword is true for an account made from an invite that never added a password: Profile
	// then offers "Keep your place" instead of "Change password".
	NoPassword bool
	Version    string
}

// meChevron is the trailing arrow of a row, drawn in CSS.
templ meChevron() {
	<span class="ts-me__chev" aria-hidden="true"></span>
}

// profileCaption is the line under a menu entry: the devices, people, libraries and backups summaries.
func profileCaption(v ProfileView, key string) string {
	switch key {
	case "devices":
		return v.DevicesLine
	case "users":
		return v.UsersRow
	case "libraries":
		return v.Libraries
	case "backups":
		return v.Backups
	}
	return ""
}

// profileMenuLink is one entry of a Profile menu.
templ profileMenuLink(href, label, caption string) {
	<a class="ts-chipmenu__item ts-profile__mitem" href={ templ.SafeURL(href) }>
		<span class="ts-profile__mtext">
			<span>{ label }</span>
			if caption != "" {
				<span class="caption ts-me__lead">{ caption }</span>
			}
		</span>
	</a>
}

// profileMenus are the two buttons in the head: Account and Settings. Each is a <details> menu
// (shell.js closes it on Escape and on a click elsewhere), so the links work without a script. The
// links come from the Settings side list (prefsSettingsItems, prefsServerItems), so they cannot drift.
templ profileMenus(v ProfileView) {
	<div class="ts-profile__menus">
		<details class="ts-chipmenu ts-profile__menu" id="pf-menu-account" data-ts-chipmenu>
			<summary class="ts-btn ts-btn--secondary">
				Account
				@chevron()
			</summary>
			<div class="ts-chipmenu__body">
				<div class="ts-chipmenu__group" role="group" aria-label="Account">
					@profileMenuLink(prefsDevicesItem().Href, prefsDevicesItem().Label, profileCaption(v, "devices"))
					if v.NoPassword {
						@profileMenuLink("/welcome", "Keep your place", "Add a password so you can sign in elsewhere")
					} else {
						@profileMenuLink("/me/password", "Change password", "")
					}
					<form method="post" action="/logout" class="ts-profile__signout" hx-boost="false">
						<input type="hidden" name="_csrf" value={ v.CSRF }/>
						<button type="submit" class="ts-chipmenu__item ts-profile__mitem ts-profile__mquiet">Sign out</button>
					</form>
				</div>
			</div>
		</details>
		<details class="ts-chipmenu ts-chipmenu--end ts-profile__menu" id="pf-menu-settings" data-ts-chipmenu>
			<summary class="ts-btn ts-btn--secondary">
				Settings
				@chevron()
			</summary>
			<div class="ts-chipmenu__body">
				<div class="ts-chipmenu__group" role="group" aria-label="Settings">
					for _, it := range prefsSettingsItems() {
						@profileMenuLink(it.Href, it.Label, "")
					}
				</div>
				if items := prefsServerItems(PrefsNav{Users: v.UsersRow != "", Libraries: v.Libraries != "", Email: v.Email, Backups: v.Backups != ""}); len(items) > 0 {
					<div class="ts-chipmenu__group" role="group" aria-labelledby="pf-menu-server">
						<p class="ts-chipmenu__head" id="pf-menu-server">Your server</p>
						for _, it := range items {
							@profileMenuLink(it.Href, it.Label, profileCaption(v, it.Key))
						}
					</div>
				}
			</div>
		</details>
	</div>
}

// profileBook is one "Also in progress" entry: the card, then its one round resume control.
templ profileBook(b ProfileBook) {
	<li class="ts-pbook">
		@components.BookCard(b.Card)
		if b.Play != nil {
			@components.PlayButton(*b.Play)
		}
		if b.Read != nil {
			@components.ReadButton(*b.Read)
		}
	</li>
}

// Profile is the person's own page (decision 0021): who they are, then their books (the hero, the
// others under way, the lately finished), their listening and shelves, and the account last.
templ Profile(v ProfileView) {
	<div class="ts-me ts-profile">
		<header class="ts-profile__head">
			@components.Avatar(v.UserID, v.Name, "lg")
			<div class="ts-profile__who">
				<h1 class="title-2 ts-profile__name">{ v.Name }</h1>
				<span class="ts-me__sub">
					<span class={ "ts-role", templ.KV("ts-role--owner", v.Role == "Owner") }>{ v.Role }</span>
					if v.ServerName != "" {
						<span class="caption ts-me__lead">{ v.ServerName }</span>
					}
				</span>
			</div>
			@profileMenus(v)
		</header>
		if v.Banner != "" {
			<p class="ts-banner ts-me__banner" role="status">
				@components.Icon("check", false)
				{ v.Banner }
			</p>
		}
		<div class="ts-profile__cols">
			<div class="ts-profile__books">
				if v.Books.Hero != nil {
					@HeroCard(*v.Books.Hero)
				} else if v.Books.Empty != nil {
					<div class="ts-profile__empty">
						@components.EmptyState(v.Books.Empty.Title, v.Books.Empty.Body, listeningAction(v.Books.Empty.Action, v.Books.Empty.Href))
					</div>
				}
				if len(v.Books.Also) > 0 {
					<section class="ts-profile__also" aria-labelledby="pf-also">
						<div class="ts-home__rowhead">
							<h2 id="pf-also" class="section">Also in progress</h2>
							if v.Books.SeeAllURL != "" {
								<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.Books.SeeAllURL) }>See all</a>
							}
						</div>
						<ul class="ts-pbooks">
							for _, b := range v.Books.Also {
								@profileBook(b)
							}
						</ul>
					</section>
				}
				if len(v.Books.Finished) > 0 {
					<section class="ts-profile__finished" aria-labelledby="pf-done">
						<div class="ts-home__rowhead">
							<h2 id="pf-done" class="section">Finished lately</h2>
							<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.Books.FinishedURL) }>See all</a>
						</div>
						<div class="ts-profile__done">
							for _, c := range v.Books.Finished {
								@components.BookCard(c)
							}
						</div>
					</section>
				}
			</div>
			<div class="ts-profile__side">
				@components.ListeningStats(v.Stats)
				if v.CanShelve {
					<section class="ts-profile__card" aria-labelledby="pf-shelves">
						<div class="ts-home__rowhead">
							<h2 id="pf-shelves" class="ts-overline">Your shelves</h2>
							<a class="ts-btn ts-btn--quiet" href="/shelves">See all</a>
						</div>
						if len(v.ShelfRows) > 0 {
							<ul class="ts-shelf-list">
								for _, r := range v.ShelfRows {
									<li>
										@ShelfRow(r)
									</li>
								}
							</ul>
						} else {
							<p class="caption ts-me__lead">No shelves yet</p>
						}
					</section>
				}
				<p class="caption ts-me__foot">Tendshelf { v.Version } · open source</p>
			</div>
		</div>
	</div>
}
