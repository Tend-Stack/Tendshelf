package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// PasswordStyles add the shared form look of the onboarding pages to the Profile styles.
var PasswordStyles = []string{"css/pages-onboard.css", "css/pages-me.css"}

// PasswordView is the Change password form. It never carries a password back.
type PasswordView struct {
	CSRF string
	// FormError is the answer to too many tries, or empty.
	FormError string
	// CurrentError and NewError are the field messages, or empty.
	CurrentError, NewError string
}

// Password asks for the current password and a new one.
templ Password(v PasswordView) {
	<div class="ts-me ts-me--narrow">
		<a class="ts-me__back" href="/me" aria-label="Back to profile">
			@components.Icon("profile", false)
			Profile
		</a>
		<h1 class="title-1 ts-me__title">Change password</h1>
		<form class="ts-form" method="post" action="/me/password" hx-boost="false">
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			@formError(v.FormError)
			@components.TextField(components.Field{
				ID: "current", Name: "current", Label: "Current password", Type: "password", Required: true,
				Autocomplete: "current-password", Error: v.CurrentError, Autofocus: true,
			})
			@components.TextField(components.Field{
				ID: "password", Name: "password", Label: "New password", Type: "password", Required: true,
				Autocomplete: "new-password", Hint: "At least 10 characters.", Error: v.NewError,
			})
			<button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">Change password</button>
		</form>
	</div>
}
