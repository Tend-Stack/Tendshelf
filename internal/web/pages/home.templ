package pages

// HomePage is the first screen. Until libraries exist it shows the empty state from the copy deck.
templ HomePage() {
	<h1 class="title-1">Home</h1>
	<section aria-labelledby="home-empty-title">
		<h2 id="home-empty-title" class="title-3">Your shelf is empty</h2>
		<p class="body">Point Tendshelf at a folder of audiobooks and they'll appear here.</p>
	</section>
}
