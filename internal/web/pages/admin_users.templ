package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// UserRow is one person on the Users page. The handler writes every sentence.
type UserRow struct {
	ID, Name string
	// RolePill is the role word ("Owner", "Admin", "Member", "Listener"); RoleKind is owner, admin,
	// member or guest and picks the pill colour.
	RolePill, RoleKind string
	// Access is the "Can listen to" cell, for example "For Mamá · 2 books" or "Everything".
	Access string
	// LastActive is "Today", "3 days ago", "Never"... ; Live shows the three bars of "Listening now".
	LastActive string
	Live       bool
	// Month is the hours listened this month ("12 h"); Devices is the count as text.
	Month, Devices string
	// Href opens the person's page; empty when the signed-in person may not manage them.
	Href string
	You  bool
	Off  bool
}

// UsersView is the Users & invites page (People tab).
type UsersView struct {
	CSRF string
	// Subtitle is "5 people · 1 invite waiting · 3 listening this week", zero segments dropped.
	Subtitle string
	// TabPeople is "People · 5".
	TabPeople string
	Rows      []UserRow
	// TabInvites is "Invites · 2", or empty when the viewer manages no invites; the tab links to
	// the #users-invites section.
	TabInvites string
	// Invites are the pending invites the viewer may manage, oldest first.
	Invites []InviteRow
	// TabDevices is "Devices · 4", or empty when nobody is signed in anywhere; the tab links to the
	// #users-devices section.
	TabDevices string
	// DeviceGroups are the people with a signed-in browser or app, in the order of the People tab.
	DeviceGroups []UsersDevices
	// NewLink, when set, shows the address of an invite whose link was just replaced.
	NewLink *InviteLink
}

// UsersDevices is one person's signed-in browsers and apps on the Devices tab. Rows carry an Action
// only where the viewer may sign them out; Note explains a group with none ("Manage your own...").
type UsersDevices struct {
	Name string
	Note string
	Rows []ProfileDevice
}

// InviteRow is one pending invite on the Users page. The handler writes every sentence.
type InviteRow struct {
	ID string
	// Name is who the invite is for; Line is "{name} hasn't opened the invite yet" and Meta is
	// "Member · Until 2 Jan" or "Member · No end date".
	Name, Line, Meta string
}

// InviteLink is the panel that shows the new address of an invite, once.
type InviteLink struct {
	Name, URL string
	// Title and Note are the panel's two sentences; the handler writes both.
	Title, Note string
	// Label and FieldID name the field; empty means "Invite link" and "invite-link" (a share link
	// sets both).
	Label, FieldID string
	// QR is the invite's address as a QR code, shown under the sentences; nil on a share link and on
	// an address a phone cannot reach.
	QR *components.QRView
}

// usersLiveBars is the "Listening now" mark: three bars the stylesheet animates.
templ usersLiveBars() {
	<span class="ts-users__live" aria-hidden="true"><i></i><i></i><i></i></span>
}

// usersRoleBadge is the role pill of a row.
templ usersRoleBadge(r UserRow) {
	<span class={ "ts-role", templ.KV("ts-role--owner", r.RoleKind == "owner") }>{ r.RolePill }</span>
}

// usersName is the name of a row with "(you)" and "Turned off" when they apply.
templ usersName(r UserRow) {
	<span class="body ts-users__name">{ r.Name }</span>
	if r.You {
		<span class="caption ts-users__you">(you)</span>
	}
	if r.Off {
		<span class="caption ts-users__off">Turned off</span>
	}
}

// UsersList is the table (768 px and up) and the list (phone) of people. It is its own fragment,
// <section id="users">, so GET /hx/admin/users can refresh it alone.
templ UsersList(v UsersView) {
	<section id="users" aria-label="People">
		<table class="ts-users__table">
			<thead>
				<tr>
					<th scope="col">Person</th>
					<th scope="col">Role</th>
					<th scope="col">Can listen to</th>
					<th scope="col">Last active</th>
					<th scope="col">This month</th>
					<th scope="col">Devices</th>
					<th scope="col"><span class="ts-sr">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				for _, r := range v.Rows {
					<tr class="ts-users__row">
						<th scope="row">
							@components.Avatar(r.ID, r.Name, "md")
							@usersName(r)
						</th>
						<td>@usersRoleBadge(r)</td>
						<td class="ts-users__access">{ r.Access }</td>
						<td class="ts-users__active">
							if r.Live {
								@usersLiveBars()
							}
							{ r.LastActive }
						</td>
						<td class="ts-num">{ r.Month }</td>
						<td class="ts-num ts-users__devices">{ r.Devices }</td>
						<td>
							if r.Href != "" {
								<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(r.Href) } aria-label={ "Manage " + r.Name }>
									Manage
									@usersChevron()
								</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<ul class="ts-users__list">
			for _, r := range v.Rows {
				<li>
					if r.Href != "" {
						<a class="ts-users__item" href={ templ.SafeURL(r.Href) }>
							@usersListItem(r)
							@usersChevron()
						</a>
					} else {
						<div class="ts-users__item">
							@usersListItem(r)
						</div>
					}
				</li>
			}
		</ul>
	</section>
}

// usersListItem is the inside of one phone row: avatar, name, role, access, last active, month.
templ usersListItem(r UserRow) {
	@components.Avatar(r.ID, r.Name, "md")
	<span class="ts-users__text">
		<span class="ts-users__line">
			@usersName(r)
			@usersRoleBadge(r)
		</span>
		<span class="caption ts-users__meta">{ r.Access }</span>
		<span class="caption ts-users__meta">
			if r.Live {
				@usersLiveBars()
			}
			{ r.LastActive } · { r.Month } this month
		</span>
	</span>
}

templ usersChevron() {
	<span class="ts-users__chev" aria-hidden="true"></span>
}

// AdminUsers is the Users & invites page. Pending invites land in #users-invites; "Invite someone"
// opens the Share & invite page.
templ AdminUsers(v UsersView) {
	<div class="ts-admin ts-users">
		<header class="ts-users__head">
			<span class="ts-overline">Server</span>
			<h1 class="title-1 ts-admin__title">Users &amp; invites</h1>
			<p class="caption ts-users__sub">{ v.Subtitle }</p>
			<a class="ts-btn ts-btn--primary ts-btn--lg ts-users__invite" href="/share">
				@components.Icon("invite", false)
				Invite someone
			</a>
		</header>
		<nav class="ts-tabs ts-users__tabs" aria-label="Users and invites">
			<a class="ts-tabs__item" href="/admin/users" aria-current="page">{ v.TabPeople }</a>
			if v.TabInvites != "" {
				<a class="ts-tabs__item" href="#users-invites">{ v.TabInvites }</a>
			}
			if v.TabDevices != "" {
				<a class="ts-tabs__item" href="#users-devices">{ v.TabDevices }</a>
			}
		</nav>
		@UsersList(v)
		<div class="ts-groups ts-users__groups">
			@InvitesList(v)
			@UsersDevicesList(v)
		</div>
		<p class="caption ts-users__note">Listening time is shown so you can see the shelf is being used. Nobody, including you, can see what someone else is listening to unless they share it.</p>
	</div>
}

func inviteFieldID(l InviteLink) string {
	if l.FieldID != "" {
		return l.FieldID
	}
	return "invite-link"
}

func inviteFieldLabel(l InviteLink) string {
	if l.Label != "" {
		return l.Label
	}
	return "Invite link"
}

// InviteLinkPanel shows an invite's address, once: a status region with a read-only field. The
// Users page and the Share & invite page both use it.
templ InviteLinkPanel(l InviteLink) {
	<div class="ts-invite__link" role="status">
		<h2 class="body ts-invite__linktitle">{ l.Title }</h2>
		<p class="caption">{ l.Note }</p>
		if l.QR != nil {
			<div class="ts-pair__qr">
				@components.QR(*l.QR)
			</div>
		}
		<label class="caption" for={ inviteFieldID(l) }>{ inviteFieldLabel(l) }</label>
		<input class="ts-input" id={ inviteFieldID(l) } type="text" readonly autofocus value={ l.URL }/>
		<button type="button" class="ts-btn ts-btn--secondary" data-copy={ "#" + inviteFieldID(l) } hidden>Copy link</button>
		<p class="ts-sr" aria-live="polite" data-copy-status></p>
	</div>
}

// InvitesList is the pending-invite card inside #users-invites: one row per invite with "Copy link
// again" and "Cancel invite", and the new-link panel after a link was replaced. With nothing to
// show it is the empty anchor the tab points at.
templ InvitesList(v UsersView) {
	if len(v.Invites) == 0 && v.NewLink == nil {
		<div id="users-invites"></div>
	} else {
		<section id="users-invites" class="ts-group ts-group--pad ts-invite__card" aria-label={ v.TabInvites }>
			if v.TabInvites != "" {
				<h2 class="section">{ v.TabInvites }</h2>
			}
			if v.NewLink != nil {
				@InviteLinkPanel(*v.NewLink)
			}
			<ul class="ts-users__list">
				for _, r := range v.Invites {
					<li class="ts-invite__item">
						<span class="ts-invite__icon">@components.Icon("link", false)</span>
						<span class="ts-users__text">
							<span class="body ts-users__name">{ r.Line }</span>
							<span class="caption ts-users__meta">{ r.Meta }</span>
						</span>
						<form method="post" action={ templ.URL("/admin/invites/" + r.ID + "/link") }>
							<input type="hidden" name="_csrf" value={ v.CSRF }/>
							<button type="submit" class="ts-btn ts-btn--secondary" aria-label={ "Copy link again for " + r.Name }>Copy link again</button>
						</form>
						<form method="post" action={ templ.URL("/admin/invites/" + r.ID + "/cancel") }>
							<input type="hidden" name="_csrf" value={ v.CSRF }/>
							<button type="submit" class="ts-btn ts-btn--quiet" aria-label={ "Cancel invite for " + r.Name }>Cancel invite</button>
						</form>
					</li>
				}
			</ul>
		</section>
	}
}

// UsersDevicesList is the Devices card inside #users-devices: per person, the browsers and apps
// signed in, each with "Sign out" where the viewer may. With nothing to show it is the empty
// anchor the tab points at.
templ UsersDevicesList(v UsersView) {
	if len(v.DeviceGroups) == 0 {
		<div id="users-devices"></div>
	} else {
		<section id="users-devices" class="ts-group ts-group--pad ts-invite__card ts-users__devices" aria-label={ v.TabDevices }>
			<h2 class="section">{ v.TabDevices }</h2>
			for _, g := range v.DeviceGroups {
				<h3 class="ts-overline ts-users__devname">{ g.Name }</h3>
				if g.Note != "" {
					<p class="caption ts-users__devnote">{ g.Note }</p>
				}
				<ul class="ts-users__list">
					for _, d := range g.Rows {
						<li class="ts-invite__item">
							<span class="ts-invite__icon">@components.Icon(d.Icon, false)</span>
							<span class="ts-users__text">
								<span class="body ts-users__name">{ d.Title }</span>
								<span class="caption ts-users__meta">{ d.Meta }</span>
							</span>
							if d.Action != "" {
								<form method="post" action={ templ.URL(d.Action) }>
									<input type="hidden" name="_csrf" value={ v.CSRF }/>
									<button type="submit" class="ts-btn ts-btn--quiet" aria-label={ "Sign out " + d.Title + " for " + g.Name }>Sign out</button>
								</form>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
}
