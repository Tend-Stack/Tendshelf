package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// DownloadMsg is one data-ts-msg-<Key> attribute on the Downloads root: a sentence with {tokens}
// that js/downloads.js fills in. Every word on the page comes from the server.
type DownloadMsg struct{ Key, Text string }

// DownloadsView holds the words of the Downloads page.
type DownloadsView struct {
	Title, Lead, Empty, EmptyHow                 string
	Storage, RemoveTitle, RemoveHint             string
	Active, Ready, Settings                      string
	KeepOpen, Persist, Safari, Insecure, Install string
	Messages                                     []DownloadMsg
}

func (v DownloadsView) attrs() templ.Attributes {
	a := templ.Attributes{"data-ts-downloads": true}
	for _, m := range v.Messages {
		a["data-ts-msg-"+m.Key] = m.Text
	}
	return a
}

// Downloads is /me/downloads (docs/plans/m3-offline.md, board DownloadsPhone). The server renders
// the heading, the lead and the empty state, which is the whole page without JavaScript. Everything
// else starts hidden: js/downloads.js shows it and fills the two list templates from the person's
// download index (the DOM contract in the plan).
templ Downloads(v DownloadsView) {
	<div class="ts-downloads" { v.attrs()... }>
		<h1 class="title-1 ts-downloads__title">{ v.Title }</h1>
		<p class="caption ts-downloads__lead">{ v.Lead }</p>
		<p class="caption ts-downloads__note" data-ts-insecure hidden>{ v.Insecure }</p>
		<section class="ts-downloads__storage" data-ts-storage aria-labelledby="dl-storage" hidden>
			<div class="ts-downloads__storagehead">
				<h2 id="dl-storage" class="label ts-downloads__storagetitle">{ v.Storage }</h2>
				<span class="caption ts-num" data-ts-storage-free></span>
			</div>
			<div class="ts-bar ts-downloads__storagebar" role="img" data-ts-storage-bar>
				<div class="ts-bar__fill ts-value"></div>
			</div>
			<p class="caption ts-num ts-downloads__legend">
				<span class="ts-downloads__dot" aria-hidden="true"></span>
				<span data-ts-storage-used></span>
			</p>
			<p class="caption ts-downloads__note" data-ts-persist-note hidden>{ v.Persist }</p>
			<p class="caption ts-downloads__note" data-ts-safari-note hidden>{ v.Safari }</p>
		</section>
		<p class="caption ts-downloads__note" data-ts-keep-open hidden>{ v.KeepOpen }</p>
		<button type="button" class="ts-btn ts-btn--secondary ts-downloads__install" data-ts-install hidden>{ v.Install }</button>
		<section class="ts-downloads__settings" aria-label={ v.Settings } hidden data-ts-settings>
			<div class="ts-switch-row">
				<span class="ts-switch-row__text">
					<span class="ts-switch-row__label" id="dl-remove">{ v.RemoveTitle }</span>
					<span class="ts-switch-row__hint">{ v.RemoveHint }</span>
				</span>
				<button type="button" role="switch" aria-checked="false" aria-labelledby="dl-remove" class="ts-switch" data-ts-pref="removeFinished"></button>
			</div>
		</section>
		<section class="ts-downloads__section" data-ts-active aria-labelledby="dl-now" hidden>
			<h2 id="dl-now" class="ts-overline ts-downloads__overline">{ v.Active } · <span data-ts-active-count></span></h2>
			<ul class="ts-downloads__list" data-ts-active-list></ul>
		</section>
		<section class="ts-downloads__section" data-ts-ready aria-labelledby="dl-ready" hidden>
			<div class="ts-downloads__readyhead">
				<h2 id="dl-ready" class="ts-overline ts-downloads__overline">{ v.Ready } · <span data-ts-ready-count></span></h2>
				<span class="caption ts-num" data-ts-ready-size></span>
			</div>
			<ul class="ts-downloads__list" data-ts-ready-list></ul>
		</section>
		<div data-ts-empty>
			@components.EmptyState(v.Empty, v.EmptyHow, nil)
		</div>
		<template data-ts-row-active>
			<li class="ts-row ts-downloads__row">
				<span class="ts-cover ts-cover--52 ts-cover--blank" data-ts-cover></span>
				<div class="ts-row__text ts-downloads__text">
					<span class="ts-row__title" data-ts-title></span>
					<div class="ts-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-ts-row-bar>
						<div class="ts-bar__fill ts-value"></div>
					</div>
					<span class="ts-row__meta" data-ts-meta></span>
				</div>
				<button type="button" class="ts-iconbtn" data-ts-act="pause">
					@components.Icon("pause", true)
				</button>
				<button type="button" class="ts-iconbtn" data-ts-act="resume" hidden>
					@components.Icon("play", true)
				</button>
				<button type="button" class="ts-iconbtn" data-ts-act="cancel" hidden>
					@components.Icon("close", false)
				</button>
			</li>
		</template>
		<template data-ts-row-ready>
			<li class="ts-row ts-downloads__row">
				<a class="ts-row__main" href="/" data-ts-link>
					<span class="ts-cover ts-cover--52 ts-cover--blank" data-ts-cover></span>
					<span class="ts-row__text">
						<span class="ts-row__title" data-ts-title></span>
						<span class="ts-row__meta ts-downloads__ready">
							@components.Icon("check", false)
							<span data-ts-meta></span>
						</span>
					</span>
				</a>
				<button type="button" class="ts-iconbtn" data-ts-act="remove">
					@components.Icon("trash", false)
				</button>
			</li>
		</template>
	</div>
}
