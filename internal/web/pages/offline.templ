package pages

import (
	"context"
	"io"

	"github.com/Tend-Stack/tendshelf/internal/web/components"
)

// OfflineRow is one book of the offline shell. Play is nil for a book that is not on this phone.
type OfflineRow struct {
	Card  components.CardView
	Meta  string
	Ready bool
	Play  *components.PlayButtonView
	// Read opens the reader, for a book whose text is on this phone. In a row it is always the plain button.
	Read *components.ReadButtonView
	// Episode is the play link of a downloaded podcast episode (it plays through the player's episode path).
	Episode *OfflineEpisodePlay
}

// OfflineEpisodePlay is an episode's play link in the shell: the audio address without JavaScript, the
// episode id for the player, and its spoken name.
type OfflineEpisodePlay struct{ ID, Href, Label string }

// OfflineView is the page the service worker shows when the server cannot be reached
// (screens/states/StateOffline): the books saved on this phone first, then the recent ones that need
// a connection.
type OfflineView struct {
	Greeting, Caption, Section, Note string
	// EmptyTitle and EmptyBody are the words shown when there is no book to list.
	EmptyTitle, EmptyBody string
	Rows                  []OfflineRow
}

// Offline is GET /offline. The service worker keeps this answer in the person's own cache and serves it
// for a page it cannot fetch; the root carries data-ts-offline-shell so offline.js knows the shell is
// showing.
templ Offline(v OfflineView) {
	<div class="ts-home ts-offline-home" data-ts-offline-shell>
		<h1 class="title-1">{ v.Greeting }</h1>
		<p class="caption ts-offline-home__lead">{ v.Caption }</p>
		if len(v.Rows) == 0 {
			@components.EmptyState(v.EmptyTitle, v.EmptyBody, nil)
		} else {
			<section aria-labelledby="offline-section">
				<h2 id="offline-section" class="section">{ v.Section }</h2>
				for _, row := range v.Rows {
					@components.BookRowWith(row.Card, row.Meta, row.Ready, offlineActions(row))
				}
			</section>
		}
		<p class="caption ts-offline-home__lead">{ v.Note }</p>
	</div>
}

// offlineActions is the row's slot: the Read button, then the round play control, or nothing.
func offlineActions(row OfflineRow) templ.Component {
	if row.Play == nil && row.Read == nil && row.Episode == nil {
		return nil
	}
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		if row.Read != nil {
			if err := components.ReadButton(*row.Read).Render(ctx, w); err != nil {
				return err
			}
		}
		if row.Episode != nil {
			return offlineEpisodePlay(*row.Episode).Render(ctx, w)
		}
		if row.Play != nil {
			return components.PlayButton(*row.Play).Render(ctx, w)
		}
		return nil
	})
}

templ offlineEpisodePlay(v OfflineEpisodePlay) {
	<a class="ts-iconbtn ts-iconbtn--tonal" href={ templ.SafeURL(v.Href) } hx-boost="false" data-ts-play={ v.ID } aria-label={ v.Label }>
		@components.Icon("play", true)
	</a>
}
