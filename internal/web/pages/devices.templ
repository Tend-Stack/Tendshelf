package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// DeviceLine is one line of "Your devices": a single browser or app, or, when Sessions has more
// than one entry, several nearly identical sign-ins folded into one line. For a folded line the
// embedded row carries the shared label, the count and the newest time.
type DeviceLine struct {
	ProfileDevice
	Sessions []ProfileDevice
}

// DevicesView is what "Your devices" shows. The handler writes every sentence.
type DevicesView struct {
	CSRF   string
	Lines  []DeviceLine
	Others int
	// RenameID, RenameValue and RenameErr re-open the Name form of the row whose save was refused (422).
	RenameID, RenameValue, RenameErr string
	// NameButton, NameLabel, HintWeb and HintApp are the handler's words for the Name form.
	NameButton, NameLabel, HintWeb, HintApp string
	// AppKeys is the App keys section under the list; the handler fills it.
	AppKeys AppKeysView
	// Feeds is the Podcast feeds section under the App keys; the handler fills it.
	Feeds FeedsView
}

// deviceSignOut is the per-session sign-out form: it acts on that one session only.
templ deviceSignOut(csrf string, d ProfileDevice) {
	<form method="post" action={ templ.URL(d.Action) }>
		<input type="hidden" name="_csrf" value={ csrf }/>
		<button type="submit" class="ts-btn ts-btn--quiet" aria-label={ d.Aria }>Sign out</button>
	</form>
}

// deviceRenameAction is where a row's Name form posts: a browser sign-in or an app, always the person's own.
func deviceRenameAction(d ProfileDevice) string {
	if d.Session {
		return "/me/sessions/" + d.ID + "/name"
	}
	return "/me/devices/" + d.ID + "/name"
}

// deviceRenameValue is the Name field's value: what the person last typed for a refused save, else the current name.
func deviceRenameValue(v DevicesView, d ProfileDevice) string {
	if v.RenameID == d.ID {
		return v.RenameValue
	}
	return d.Name
}

func deviceRenameErr(v DevicesView, d ProfileDevice) string {
	if v.RenameID == d.ID {
		return v.RenameErr
	}
	return ""
}

func deviceRenameHint(v DevicesView, d ProfileDevice) string {
	if d.Session {
		return v.HintWeb
	}
	return v.HintApp
}

// deviceRename is the quiet Name control of one row: a disclosure with one field, working without
// JavaScript. aria says which device it names, for a screen reader.
templ deviceRename(v DevicesView, d ProfileDevice, aria string) {
	<details class="ts-me__rename" open?={ v.RenameID == d.ID }>
		<summary class="ts-btn ts-btn--quiet" aria-label={ aria }>{ v.NameButton }</summary>
		<form class="ts-me__renameform" method="post" action={ templ.URL(deviceRenameAction(d)) }>
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			@components.TextField(components.Field{ID: "dev-name-" + d.ID, Name: "name", Label: v.NameLabel, Value: deviceRenameValue(v, d),
				Hint: deviceRenameHint(v, d), Error: deviceRenameErr(v, d), Autocomplete: "off"})
			<button type="submit" class="ts-btn ts-btn--secondary">Save</button>
		</form>
	</details>
}

// Devices is "Your devices": everywhere the person is signed in, a sign-out for each.
templ Devices(v DevicesView) {
	<div class="ts-me">
		<h1 class="title-2 ts-me__title">Your devices</h1>
		<p class="body ts-me__lead">Everywhere you are signed in. Signing out of one leaves the others as they are.</p>
		<section aria-label="Your devices" class="ts-me__section ts-group">
			for _, l := range v.Lines {
				if len(l.Sessions) > 1 {
					<details class="ts-me__devgroup">
						<summary class="ts-me__row ts-me__device">
							<span class="ts-me__deviceicon" aria-hidden="true">
								@components.Icon(l.Icon, false)
							</span>
							<span class="ts-me__rowtext">
								<span class="body ts-me__rowtitle">{ l.Title }</span>
								<span class="caption ts-me__lead">{ l.Meta }</span>
							</span>
							@meChevron()
						</summary>
						for _, d := range l.Sessions {
							<div class="ts-me__row ts-me__devone">
								<span class="body ts-me__rowtext">{ d.Meta }</span>
								@deviceRename(v, d, "Name "+d.Title+", "+d.Meta)
								@deviceSignOut(v.CSRF, d)
							</div>
						}
					</details>
				} else {
					<div class="ts-me__row ts-me__device">
						<span class="ts-me__deviceicon" aria-hidden="true">
							@components.Icon(l.Icon, false)
						</span>
						<span class="ts-me__rowtext">
							<span class="body ts-me__rowtitle">{ l.Title }</span>
							<span class="caption ts-me__lead">{ l.Meta }</span>
						</span>
						@deviceRename(v, l.ProfileDevice, "Name "+l.Title)
						if !l.Current {
							@deviceSignOut(v.CSRF, l.ProfileDevice)
						}
					</div>
				}
			}
			<div class="ts-me__devfoot">
				<a class="ts-btn ts-btn--secondary" href="/me/devices/add">Add a phone</a>
				if v.Others > 0 {
					<form method="post" action="/me/sessions/signout-others" class="ts-me__others">
						<input type="hidden" name="_csrf" value={ v.CSRF }/>
						<button type="submit" class="ts-btn ts-btn--quiet">Sign out everywhere else</button>
					</form>
				}
			</div>
		</section>
		@AppKeys(v.AppKeys)
		@Feeds(v.Feeds)
	</div>
}
