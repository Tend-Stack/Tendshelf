package pages

import (
	"strconv"

	"github.com/Tend-Stack/tendshelf/internal/web/components"
)

// LibChip is a link that narrows the Library to one library (or back to all of them).
type LibChip struct {
	Name, Href string
	Current    bool
}

// FilterOption is one choice in a filter menu: a link to the list with that choice made. A Disabled
// option is shown but is not a link (the Category menu at five genres).
type FilterOption struct {
	Name, Href string
	// Value is the form value of a length or show choice; empty for people and series.
	Value    string
	Count    int
	On       bool
	Disabled bool
}

// FilterKind is one kind of filter inside the Filter menu: a nested disclosure that holds the kind's
// choices ("Author", "Series", "Length"). A kind with a long list (people, series, categories) does not
// send the list with the page: LazyHref is a fragment address the menu loads the first time the kind
// opens, and PageHref is the plain link that shows the list without JavaScript. An Open kind carries
// its list in the page.
type FilterKind struct {
	// ID names the kind: the <details> element is lib-kind-<ID>.
	ID, Label, AnyLabel, AnyHref string
	// Chosen is the choice made, in words ("Elias Varn"); empty while none is.
	Chosen  string
	Options []FilterOption
	// Counts shows each option's number of books.
	Counts bool
	// On is true while a choice is made.
	On bool
	// Open renders the kind expanded with its list in the page.
	Open bool
	// LazyHref loads the list on first open; PageHref is the no-JavaScript link that opens it.
	LazyHref, PageHref string
}

// ActiveFilter is one chip of the active filter row: a link that removes only that filter. Kind is
// "Author", Value is "Elias Varn"; Name is the accessible name ("Remove filter: Author Elias Varn").
type ActiveFilter struct {
	Kind, Value, Name, Href string
}

// FilterMenu is one chip with its menu ("Show", "Sort", "Filter"). The chip reads "Show: Unfinished"
// while a choice is made; AnyHref drops the choice. The menu is a <details> element and its choices
// are links, so it works without JavaScript. The Filter menu holds Kinds (a nested disclosure each)
// instead of Options.
type FilterMenu struct {
	// ID names the menu: the <details> element is lib-menu-<ID>.
	ID                             string
	Label, Chip, AnyLabel, AnyHref string
	// Icon is a leading icon for a chip that is not a value ("filter"); otherwise a check shows while On.
	Icon    string
	Options []FilterOption
	// Kinds are the filter kinds of the Filter menu.
	Kinds []FilterKind
	// Counts shows each option's number of books.
	Counts bool
	// On is true while a choice is made.
	On bool
	// End opens the menu towards the left, for a chip near the right edge.
	End bool
	// Open renders the menu open (the address asked for it); Titled shows Label as the first group's heading.
	Open, Titled bool
}

// HiddenField carries a filter the form does not edit across a submit.
type HiddenField struct{ Name, Value string }

// LibraryView is the Library page and its list fragment. The handler builds every
// address, so the template holds no URL logic: each filter, sort, view and page position is an
// address a person can bookmark and go Back to.
type LibraryView struct {
	// Title is "Library" or the name of the one library shown.
	Title string
	// AddBooksHref and AddBooksLabel are the header button to the Add books page; empty when the
	// person may not add books or the library takes no uploads.
	AddBooksHref, AddBooksLabel string
	// FormAction is the address the filter form sends to (the page without its query).
	FormAction string
	// Libraries are the chips that switch between libraries; empty with a single library.
	Libraries []LibChip
	// HeaderLine is "912 books · 3 folders · 8,240 hours" (folders only for a person who manages
	// libraries); while a filter is on it starts "15 of 912 books". It is the page's one count and a
	// polite live region.
	HeaderLine string
	// FilterMenu is the "Filter" chip: every kind with its choices. ShowMenu is the "Show" chip
	// (Unfinished, Not started, Finished, Shared with you) and ShowValue the chosen one; SortMenu is
	// the "Sort" chip.
	FilterMenu FilterMenu
	ShowMenu   FilterMenu
	ShowValue  string
	SortMenu   FilterMenu
	// Active are the chips of the active filter row, one per filter in use; empty while unfiltered.
	Active []ActiveFilter
	// TitleFilter is the text of the "Filter by title" field.
	TitleFilter string
	// Hidden are the person, narrator and series ids the forms carry; LengthValue is the chosen
	// length bucket ("short", "medium", "long" or "").
	Hidden      []HiddenField
	LengthValue string
	// View is "grid" or "list"; GridHref and ListHref switch.
	View               string
	GridHref, ListHref string
	// SelectedGenres are the chosen ones, carried by the title form.
	SelectedGenres []string
	// ClearHref ("Clear all") drops every filter and keeps the sort and the view; it is set only while a filter is on.
	ClearHref string
	// StartHref is "Back to the start" and is set only on a page reached by a cursor.
	StartHref string
	Cards     []components.CardView
	// MoreURL is the page address of the next page (the no-JavaScript "Show more"); MoreHX the
	// fragment address infinite scroll loads. Both are empty on the last page.
	MoreURL, MoreHX string
	Scan            *components.ScanStatusView
	Empty           *EmptyView
}

// titleForm is the "Filter by title" form. It is a boosted GET: typing sends it after a pause and
// swaps the results plus the header menus (their links carry the typed title); without JavaScript
// the "Show books" button sends it. The other filters ride along as hidden fields.
templ titleForm(v LibraryView) {
	<form class="ts-filter-form" method="get" action={ templ.SafeURL(v.FormAction) }>
		if v.View == "list" {
			<input type="hidden" name="view" value="list"/>
		}
		for _, h := range v.Hidden {
			<input type="hidden" name={ h.Name } value={ h.Value }/>
		}
		for _, g := range v.SelectedGenres {
			<input type="hidden" name="genre" value={ g }/>
		}
		if v.LengthValue != "" {
			<input type="hidden" name="length" value={ v.LengthValue }/>
		}
		if v.ShowValue != "" {
			<input type="hidden" name="show" value={ v.ShowValue }/>
		}
		<div class="ts-search ts-lib-title">
			@components.Icon("search", false)
			<label class="ts-sr" for="fb-title">Filter by title</label>
			<input
				class="ts-input"
				type="search"
				id="fb-title"
				name="title"
				value={ v.TitleFilter }
				placeholder="Filter this library by title"
				maxlength="100"
				autocomplete="off"
				hx-get={ v.FormAction }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#library-results"
				hx-select="#library-results"
				hx-select-oob="#lib-menus, #lib-count:innerHTML"
				hx-swap="outerHTML"
				hx-push-url="true"
				hx-include="closest form"
			/>
		</div>
		<noscript>
			<button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-filter-submit">Show books</button>
		</noscript>
	</form>
}

// menuOption is one line of a menu: a link, or plain words while it cannot be chosen.
templ menuOption(m FilterMenu, o FilterOption) {
	if o.Disabled {
		<span class="ts-chipmenu__item is-disabled" aria-disabled="true">
			<span class="ts-chipmenu__name">{ o.Name }</span>
			if m.Counts {
				<span class="ts-chipmenu__count ts-num">{ strconv.Itoa(o.Count) }</span>
			}
		</span>
	} else {
		<a
			class="ts-chipmenu__item"
			href={ templ.SafeURL(o.Href) }
			if o.On {
				aria-current="true"
			}
		>
			<span class="ts-chipmenu__name">{ o.Name }</span>
			if m.Counts {
				<span class="ts-chipmenu__count ts-num">{ strconv.Itoa(o.Count) }</span>
			}
		</a>
	}
}

// filterMenu is one filter chip with its menu of links. Opening it needs no script. An open menu
// takes the focus on a page load or a swap (autofocus), so the next step is one key away.
templ filterMenu(m FilterMenu) {
	<details id={ "lib-menu-" + m.ID } class={ "ts-chipmenu", templ.KV("is-on", m.On), templ.KV("ts-chipmenu--end", m.End) } data-ts-chipmenu open?={ m.Open }>
		<summary class="ts-chip" autofocus?={ m.Open }>
			if m.Icon != "" {
				@components.Icon(m.Icon, false)
			} else if m.On {
				@components.Icon("check", false)
			}
			<span class="ts-chipmenu__label">{ m.Chip }</span>
			@chevron()
		</summary>
		<div class="ts-chipmenu__body">
			if len(m.Kinds) > 0 {
				for _, k := range m.Kinds {
					@filterKind(k)
				}
			} else if m.Titled {
				<div class="ts-chipmenu__group" role="group" aria-labelledby={ "lib-menu-" + m.ID + "-h" }>
					<p class="ts-chipmenu__head" id={ "lib-menu-" + m.ID + "-h" }>{ m.Label }</p>
					@menuAny(m)
					for _, o := range m.Options {
						@menuOption(m, o)
					}
				</div>
			} else {
				<div class="ts-chipmenu__group" role="group" aria-label={ m.Label }>
					@menuAny(m)
					for _, o := range m.Options {
						@menuOption(m, o)
					}
				</div>
			}
		</div>
	</details>
}

// kindMenu is the menu-shaped view of a kind, so its choices use the same lines as every menu.
func kindMenu(k FilterKind) FilterMenu {
	return FilterMenu{AnyHref: k.AnyHref, AnyLabel: k.AnyLabel, On: k.On, Counts: k.Counts}
}

// kindChoices is a kind's "Any ..." line and its choices.
templ kindChoices(k FilterKind) {
	@menuAny(kindMenu(k))
	for _, o := range k.Options {
		@menuOption(kindMenu(k), o)
	}
}

// FilterKindChoices is the fragment a closed kind loads the first time it opens.
templ FilterKindChoices(k FilterKind) {
	@kindChoices(k)
}

// filterKind is one kind inside the Filter menu: a nested disclosure. The details share a name, so
// opening one closes the others without a script. A kind with a long list loads it on first open
// (htmx) and offers a plain link in place of that without JavaScript.
templ filterKind(k FilterKind) {
	<details id={ "lib-kind-" + k.ID } class={ "ts-chipmenu__kind", templ.KV("is-on", k.On) } name="lib-filter-kind" open?={ k.Open }>
		<summary class="ts-chipmenu__item ts-chipmenu__kindhead">
			<span class="ts-chipmenu__name">{ k.Label }</span>
			if k.Chosen != "" {
				<span class="ts-chipmenu__chosen">{ k.Chosen }</span>
			}
			@chevron()
		</summary>
		if k.LazyHref != "" && !k.Open {
			<div class="ts-chipmenu__group ts-chipmenu__list" role="group" aria-label={ k.Label } hx-get={ k.LazyHref } hx-trigger={ "toggle from:#lib-kind-" + k.ID + " once" } hx-swap="innerHTML">
				<noscript>
					<a class="ts-chipmenu__item" href={ templ.SafeURL(k.PageHref) }>{ "Show the " + k.Label + " list" }</a>
				</noscript>
				<span class="ts-chipmenu__item is-disabled ts-chipmenu__loading">Loading</span>
			</div>
		} else {
			<div class="ts-chipmenu__group ts-chipmenu__list" role="group" aria-label={ k.Label }>
				@kindChoices(k)
			</div>
		}
	</details>
}

// menuAny is the "Any ..." line that drops the menu's choice; menus without one (Filter) have no AnyHref.
templ menuAny(m FilterMenu) {
	if m.AnyHref != "" {
		<a
			class="ts-chipmenu__item"
			href={ templ.SafeURL(m.AnyHref) }
			if !m.On {
				aria-current="true"
			}
		>{ m.AnyLabel }</a>
	}
}

// libraryItems are the books of one page in the chosen view, then the sentinel for the next page.
// The sentinel is a real link to the next page of the same list (so "Show more" works without
// JavaScript) that loads the fragment when it scrolls into view and is replaced by the next books.
templ libraryItems(v LibraryView) {
	for _, c := range v.Cards {
		if v.View == "list" {
			@components.BookRow(c)
		} else {
			@components.BookCard(c)
		}
	}
	if v.MoreURL != "" {
		<a class="ts-more" href={ templ.SafeURL(v.MoreURL) } hx-get={ v.MoreHX } hx-trigger="revealed" hx-target="this" hx-swap="outerHTML" hx-push-url="false">
			<span class="ts-more__label">Show more</span>
			<span class="ts-more__loading">
				@components.SkeletonCards(3)
			</span>
		</a>
	}
}

// LibraryItems is the fragment infinite scroll swaps in: books and the next sentinel, no page.
templ LibraryItems(v LibraryView) {
	@libraryItems(v)
}

// Library is the page: the title and count, the controls, the kinds in use, the list.
templ Library(v LibraryView) {
	<div class="ts-library">
		<header class="ts-lib-head">
			<h1 class="title-1 ts-lib-head__title">{ v.Title }</h1>
			<p id="lib-count" class="caption ts-num ts-lib-head__count" role="status">{ v.HeaderLine }</p>
			if v.AddBooksHref != "" {
				<a class="ts-btn ts-btn--secondary ts-lib-head__add" href={ templ.SafeURL(v.AddBooksHref) }>{ v.AddBooksLabel }</a>
			}
		</header>
		if v.Scan != nil {
			<div class="ts-browse-scan">
				@components.ScanStatus(*v.Scan)
			</div>
		}
		if len(v.Libraries) > 0 {
			<nav class="ts-chip-set" aria-label="Libraries">
				for _, l := range v.Libraries {
					<a
						class="ts-chip"
						href={ templ.SafeURL(l.Href) }
						if l.Current {
							aria-current="true"
						}
					>
						if l.Current {
							@components.Icon("check", false)
						}
						{ l.Name }
					</a>
				}
			</nav>
		}
		<div class="ts-lib-controls">
			<div class="ts-lib-bar">
				@titleForm(v)
			</div>
			<div id="lib-menus" class="ts-lib-menus">
				@filterMenu(v.FilterMenu)
				@filterMenu(v.ShowMenu)
				@filterMenu(v.SortMenu)
			</div>
			<div class="ts-seg" role="group" aria-label="View">
				<a
					class="ts-seg__item"
					href={ templ.SafeURL(v.GridHref) }
					if v.View != "list" {
						aria-current="true"
					}
				>
					@components.Icon("grid", false)
					<span class="ts-seg__text">Grid</span>
				</a>
				<a
					class="ts-seg__item"
					href={ templ.SafeURL(v.ListHref) }
					if v.View == "list" {
						aria-current="true"
					}
				>
					@listIcon()
					<span class="ts-seg__text">List</span>
				</a>
			</div>
		</div>
		<div id="library-results" class="ts-lib-results">
			if len(v.Active) > 0 {
				<div class="ts-lib-active" role="group" aria-label="Active filters">
					for _, f := range v.Active {
						<a class="ts-chip ts-lib-fchip" href={ templ.SafeURL(f.Href) } aria-label={ f.Name }>
							<span class="ts-lib-fchip__kind">{ f.Kind }</span>
							<span class="ts-lib-fchip__value">{ f.Value }</span>
							@components.Icon("close", false)
						</a>
					}
					<a class="ts-btn ts-btn--quiet ts-lib-clear" href={ templ.SafeURL(v.ClearHref) }>Clear all</a>
				</div>
			}
			if v.StartHref != "" {
				<p class="ts-lib-start"><a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.StartHref) }>Back to the start</a></p>
			}
			if v.Empty != nil {
				@Empty(*v.Empty)
			} else {
				<div
					id="library-grid"
					class={ "ts-lib-items", templ.KV("ts-grid ts-grid--covers", v.View != "list"), templ.KV("ts-lib-rows", v.View == "list") }
				>
					@libraryItems(v)
				</div>
			}
		</div>
	</div>
}

templ chevron() {
	<svg class="ts-icon ts-icon--sm" viewBox="0 0 24 24" aria-hidden="true">
		<path d="m6 9 6 6 6-6"></path>
	</svg>
}

templ listIcon() {
	<svg class="ts-icon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M4 6h16M4 12h16M4 18h16"></path>
	</svg>
}
