package pages

import (
	"strconv"

	"github.com/Tend-Stack/tendshelf/internal/web/components"
)

// ReaderStyles are the reader's stylesheets: the page and the reading settings.
var ReaderStyles = []string{"css/pages-reader.css"}

// ReaderBlockView is one block of text. HTML is the already escaped inside (see web/reader_render.go).
type ReaderBlockView struct {
	Kind, ID, HTML string
	Pg             int
}

// ReaderChapterView is one chapter of the text. NextFrag and NextHref are empty after the last chapter.
type ReaderChapterView struct {
	Idx, Pg          int
	Overline, Page   string
	Title            string
	Blocks           []ReaderBlockView
	NextFrag         string
	NextHref         string
	NextLabel        string
}

// ReaderMarkItem is one row of the "Highlights and notes" sheet.
type ReaderMarkItem struct {
	ID, BookID, Kind, Quote, Note string
	OpenLabel               string
	OpenHref, DeleteHref    string
	NoteHref, SaveLabel     string
	DeleteLabel, NoteField  string
	CSRF                    string
	OOB                     bool
}

// ReaderFilter is a filter link of the marks sheet.
type ReaderFilter struct {
	Label, Href string
	Count       int
	Current     bool
}

// ReaderSheetView is the contents or the marks panel, drawn over the page (the house ?sheet= pattern).
type ReaderSheetView struct {
	Kind, Title, CloseLabel, CloseHref, BookID string
	Lead, Empty                                string
	Chapters                                   []ReaderContentsItem
	Filters                                    []ReaderFilter
	Items                                      []ReaderMarkItem
}

// ReaderContentsItem is a chapter in the contents.
type ReaderContentsItem struct {
	Num, Title, Note, Href string
	Current                bool
}

// ReaderView is the whole page.
type ReaderView struct {
	Title, BookID, EditionID    string
	CloseHref, CloseLabel       string
	Chapter                     ReaderChapterView
	MarksModule                 string // address of reader-marks.js
	Footer                      ReaderFooter
	Marks                       ReaderMarksBar
	Look                        ReaderLook // the person's reading settings (reader.v1)
	SettingsLabel, SettingsHref string     // the Aa link
	SettingsModule              string     // address of reader-settings.js
}

// ReaderFooter is the line under the text: the page number and the link to the contents.
type ReaderFooter struct {
	PageLine, ContentsLabel, ContentsHref string
}

// ReaderMarksBar is the selection toolbar and the hidden form it posts.
type ReaderMarksBar struct {
	Label, Highlight, Note, Copy string
	Action, CSRF                         string
	Count                                string
}

// Reader is the page: the top bar, the text, the footer and the selection toolbar.
templ Reader(v ReaderView) {
	<div class="ts-readerpage">
		<header class="ts-readerbar">
			<a class="ts-iconbtn" href={ templ.SafeURL(v.CloseHref) } aria-label={ v.CloseLabel }>
				@components.Icon("close", false)
			</a>
			<a
				class="ts-iconbtn ts-aa"
				href={ templ.SafeURL(v.SettingsHref) }
				hx-get={ v.SettingsHref }
				hx-target="#sheet"
				hx-select="#sheet > *"
				hx-swap="innerHTML"
				hx-push-url="false"
				aria-haspopup="dialog"
				aria-label={ v.SettingsLabel }
			>Aa</a>
		</header>
		<article
			id="reader"
			class={ "ts-reader " + v.Look.Class }
			data-book={ v.BookID }
			data-edition={ v.EditionID }
		>
			<div class="ts-reader__col" id="reader-text">
				@ReaderChapter(v.Chapter)
			</div>
		</article>
		if v.SettingsModule != "" {
			<span hidden data-ts-module={ v.SettingsModule }></span>
		}
		<footer class="ts-readdock" id="reader-dock">
			<div class="ts-readdock__row">
				<span>{ v.Footer.PageLine }</span>
				<a class="ts-iconbtn ts-iconbtn--md" href={ templ.SafeURL(v.Footer.ContentsHref) } aria-label={ v.Footer.ContentsLabel }>
					@components.Icon("chapters", false)
				</a>
			</div>
		</footer>
		<div id="reader-marks" class="ts-selmenu" role="toolbar" aria-label={ v.Marks.Label } if v.MarksModule != "" { data-ts-module={ v.MarksModule } } hidden>
			<button type="button" class="ts-selmenu__item" data-ts-mark="highlight"><span class="ts-selmenu__swatch"></span>{ v.Marks.Highlight }</button>
			<button type="button" class="ts-selmenu__item" data-ts-mark="note">
				@components.Icon("edit", false)
				{ v.Marks.Note }
			</button>
			<button type="button" class="ts-selmenu__item" data-ts-mark="copy">
				@components.Icon("share", false)
				{ v.Marks.Copy }
			</button>
		</div>
		<form id="reader-hl-form" hidden hx-post={ v.Marks.Action } hx-swap="none">
			<input type="hidden" name="_csrf" value={ v.Marks.CSRF }/>
			<input type="hidden" name="edition" value={ v.EditionID }/>
			<input type="hidden" name="start_sid"/>
			<input type="hidden" name="start_off"/>
			<input type="hidden" name="end_sid"/>
			<input type="hidden" name="end_off"/>
			<input type="hidden" name="colour" value="yellow"/>
			<input type="hidden" name="note"/>
			<input type="hidden" name="client_id"/>
		</form>
		<span id="reader-marks-count" hidden>{ v.Marks.Count }</span>
	</div>
}

// ReaderChapter is one chapter: the meta line, the title, the blocks and the sentinel that asks for the next one.
templ ReaderChapter(c ReaderChapterView) {
	<section
		id={ "reader-ch-" + strconv.Itoa(c.Idx) }
		data-ch={ strconv.Itoa(c.Idx) }
	>
		<div class="ts-reader__meta"><span class="ts-overline ts-overline--accent">{ c.Overline }</span><span>{ c.Page }</span></div>
		<h2 class="ts-reader__chapter">{ c.Title }</h2>
		<div class="ts-reader__text">
			for _, b := range c.Blocks {
				@ReaderBlock(b, false)
			}
		</div>
		if c.NextFrag != "" {
			<div class="ts-reader__next" hx-get={ c.NextFrag } hx-trigger="revealed, ts-reader-next" hx-swap="outerHTML">
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(c.NextHref) }>{ c.NextLabel }</a>
			</div>
		}
	</section>
}

// ReaderBlock is one block; with oob it swaps itself in place (a highlight changed it).
templ ReaderBlock(b ReaderBlockView, oob bool) {
	switch b.Kind {
		case "h":
			<h3 id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</h3>
		case "quote":
			<blockquote id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }><p>@templ.Raw(b.HTML)</p></blockquote>
		case "li":
			<p id={ b.ID } class="ts-reader__li" data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "note":
			<p id={ b.ID } class="ts-reader__note" data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "img":
			<p id={ b.ID } class="ts-reader__img" data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "pre":
			<pre id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</pre>
		case "hr":
			<hr id={ b.ID } if oob { hx-swap-oob="outerHTML" }/>
		default:
			<p id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
	}
}

// ReaderSheet is the contents or the marks panel over the page.
templ ReaderSheet(v ReaderSheetView) {
	<div class="ts-sheet-layer ts-sheet-layer--details">
		<a class="ts-scrim" href={ templ.SafeURL(v.CloseHref) } hx-boost="false" aria-label={ v.CloseLabel } tabindex="-1"></a>
		<div class="ts-sheet ts-details-sheet" role="dialog" aria-modal="true" aria-labelledby="reader-sheet-title" tabindex="-1">
			<div class="ts-sheet__grab" aria-hidden="true"></div>
			<div class="ts-sheet__head">
				<h2 id="reader-sheet-title" class="ts-sheet__title">{ v.Title }</h2>
				<a class="ts-iconbtn" href={ templ.SafeURL(v.CloseHref) } hx-boost="false" aria-label={ v.CloseLabel }>
					@components.Icon("close", false)
				</a>
			</div>
			if v.Kind == "contents" {
				<ol class="ts-reader__toc">
					for _, c := range v.Chapters {
						<li>
							<a
								href={ templ.SafeURL(c.Href) }
								if c.Current {
									aria-current="location"
								}
							>
								<span>{ c.Num }</span> { c.Title }
								if c.Note != "" {
									<span class="caption">{ c.Note }</span>
								}
							</a>
						</li>
					}
				</ol>
			} else {
				<p class="body">{ v.Lead }</p>
				<nav class="ts-chip-set" aria-label={ v.Title }>
					for _, f := range v.Filters {
						<a
							class="ts-chip"
							href={ templ.SafeURL(f.Href) }
							if f.Current {
								aria-current="true"
							}
						>{ f.Label } { strconv.Itoa(f.Count) }</a>
					}
				</nav>
				if len(v.Items) == 0 {
					<p class="body">{ v.Empty }</p>
				}
				<ul class="ts-reader__marks" id="reader-marks-list">
					for _, it := range v.Items {
						@ReaderMarkRow(it)
					}
				</ul>
			}
		</div>
	</div>
}

// ReaderMarkRow is one highlight, note or bookmark in the marks panel.
templ ReaderMarkRow(it ReaderMarkItem) {
	<li id={ "reader-mark-" + it.ID } class="ts-reader__mark" if it.OOB { hx-swap-oob="outerHTML" }>
		<p class="caption">{ it.Kind }</p>
		if it.Quote != "" {
			<blockquote class="ts-note__quote">{ it.Quote }</blockquote>
		}
		if it.Note != "" {
			<p class="body">{ it.Note }</p>
		}
		if it.OpenHref != "" {
			<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(it.OpenHref) }>{ it.OpenLabel }</a>
		}
		if it.NoteHref != "" {
			<form hx-patch={ it.NoteHref } hx-swap="none">
				<input type="hidden" name="_csrf" value={ it.CSRF }/>
				<label class="caption" for={ "reader-note-" + it.ID }>{ it.NoteField }</label>
				<textarea id={ "reader-note-" + it.ID } name="note" rows="2">{ it.Note }</textarea>
				<button type="submit" class="ts-btn ts-btn--quiet">{ it.SaveLabel }</button>
			</form>
		}
		if it.DeleteHref != "" {
			<button type="button" class="ts-btn ts-btn--quiet" hx-delete={ it.DeleteHref } hx-swap="none">{ it.DeleteLabel }</button>
		}
	</li>
}

// ReaderMarksCount is the out-of-band count of marks (the Contents and notes link reads it).
templ ReaderMarksCount(text string) {
	<span id="reader-marks-count" hx-swap-oob="true" hidden>{ text }</span>
}

// ReaderMarkGone removes a row of the marks panel.
templ ReaderMarkGone(id string) {
	<li id={ "reader-mark-" + id } hx-swap-oob="delete"></li>
}
