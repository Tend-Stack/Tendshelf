package pages

import (
	"strconv"

	"github.com/Tend-Stack/tendshelf/internal/web/components"
)

// ReaderStyles are the reader's stylesheets: the page and the reading settings.
var ReaderStyles = []string{"css/pages-reader.css"}

// ReaderBlockView is one block of text. HTML is the already escaped inside (see web/reader_render.go).
type ReaderBlockView struct {
	Kind, ID, HTML string
	Pg             int
	C              int // characters (UTF-16 units) before the block in its chapter; the paginator counts with it
}

// ReaderChapterView is one chapter of the text. NextFrag and NextHref are empty after the last chapter.
type ReaderChapterView struct {
	Idx, Pg        int
	Part, Parts    int // this part of the chapter and how many there are
	Before         int // characters of the book before this part
	Overline, Page string
	Title          string
	Chars          int        // characters of the whole chapter (the time left in it)
	End            *ReaderEnd // the last part of the book carries the end-of-book block
	Head           bool // the part carries the chapter's heading (the first part only)
	Blocks         []ReaderBlockView
	// PrevFrag and NextFrag are fragment addresses the client fetches (data-prev-href, data-next-href);
	// PrevHref and NextHref are the plain page links for no JavaScript. Empty at the ends of the book.
	PrevFrag, PrevHref, PrevLabel string
	NextFrag, NextHref, NextLabel string
}

// ReaderEnd is the end-of-book block: a sentence and the form that marks the book finished (the person does it, never the reader).
type ReaderEnd struct{ Text, Label, Action, CSRF string }

// ReaderRoot is what the client reads from the reader root: the place to open at, the reading speed,
// the sizes it needs for page numbers and time left, and where to save.
type ReaderRoot struct {
	At, Off, Flow, Save, Lang, Words string // Words is JSON: the sentences the client script shows
	NotesSrc                         string // address of reader-notes.js, loaded on the first footnote
	Cpm, TotalChars, ChapterChars    int
	Pages, Chapters                  int // the book's standard pages (p. n of N) and its chapters
	Before                           int
	Learned                          bool
}

// ReaderMarkItem is one row of the "Highlights and notes" sheet.
type ReaderMarkItem struct {
	ID, BookID, Kind, Quote, Note string
	PostDelete                    bool // a bookmark is removed by a POST, a highlight by DELETE
	OpenLabel               string
	OpenHref, DeleteHref    string
	NoteHref, SaveLabel     string
	DeleteLabel, NoteField  string
	CSRF                    string
	OOB                     bool
}

// ReaderFilter is a filter link of the marks sheet.
type ReaderFilter struct {
	Label, Href string
	Count       int
	Current     bool
}

// ReaderSheetView is the contents or the marks panel, drawn over the page (the house ?sheet= pattern).
type ReaderSheetView struct {
	Kind, Title, CloseLabel, CloseHref, BookID string
	Lead, Empty                                string
	Chapters                                   []ReaderContentsItem
	Filters                                    []ReaderFilter
	Items                                      []ReaderMarkItem
	Exports                                    []ReaderExport // download links of the marks sheet
	Search                                     *ReaderSearchView
}

// ReaderExport is a download link of the marks sheet.
type ReaderExport struct{ Label, Href string }

// ReaderHit is one search result: the words around the match (the match itself in Hit) and where it opens.
type ReaderHit struct {
	Chapter, Before, Hit, After, Href string
}

// ReaderSearchView is the search sheet: the form and, once there is a question, its answers.
type ReaderSearchView struct {
	Action, HxAction, EditionID, Q, Label, Button string
	Hits                                ReaderHits
}

// ReaderHits is the answer list; the htmx search route returns just this.
type ReaderHits struct {
	Message string // nothing found or too short
	Items   []ReaderHit
	Note    string // shown after a full list (the cap)
}

// ReaderNoteView is a footnote popup: the note's paragraphs and the way to its place in the book.
type ReaderNoteView struct {
	Label, GoLabel, GoHref, CloseLabel string
	Paras                              []string // already escaped inside (see web/reader_render.go)
}

// ReaderSwatch is one colour of the selection toolbar.
type ReaderSwatch struct{ Colour, Label string }

// ReaderProblem is the plain page for a book that cannot be opened.
type ReaderProblem struct {
	Title, Message, BackLabel, BackHref string
	DownloadHref, DownloadLabel          string // set only when the person may download the file
}

// ReaderContentsItem is a chapter in the contents.
type ReaderContentsItem struct {
	Num, Title, Note, Href string
	Current                bool
}

// ReaderView is the whole page.
type ReaderView struct {
	Title, BookID, EditionID    string
	CloseHref, CloseLabel       string
	Root                        ReaderRoot
	Speaker                     *components.PlayButtonView // the audiobook; nil without ListenBook or audio
	MarksLabel, MarksHref       string                     // the Highlights and notes sheet
	Chapter                     ReaderChapterView
	MarksModule                 string // address of reader-marks.js
	ReaderModule, PagesModule   string // addresses of reader.js (flow, anchors, saving, input, progress) and reader-pages.js (the columns)
	Footer                      ReaderFooter
	Marks                       ReaderMarksBar
	Look                        ReaderLook // the person's reading settings (reader.v1)
	SettingsLabel, SettingsHref string     // the Aa link
	SettingsModule              string     // address of reader-settings.js
	SearchLabel, SearchHref     string
	BookmarkLabel, BookmarkURL  string // the bookmark-this-page button and where its form posts
}

// ReaderFooter is the line under the text: the page number and the link to the contents.
type ReaderFooter struct {
	PageLine, ContentsLabel, ContentsHref string
	Ruler                                 components.RulerView // place in the book, ticks at chapter starts
}

// ReaderMarksBar is the selection toolbar and the hidden form it posts.
type ReaderMarksBar struct {
	Label, Highlight, Note, Copy string
	Action, CSRF                 string
	Count                        string
	Swatches                     []ReaderSwatch
	Save, Cancel                 string // the note dialog's buttons
}

// Reader is the page: the top bar, the text, the footer and the selection toolbar.
templ Reader(v ReaderView) {
	<div class="ts-readerpage">
		<header class="ts-readerbar">
			<a class="ts-iconbtn" href={ templ.SafeURL(v.CloseHref) } aria-label={ v.CloseLabel }>
				@components.Icon("close", false)
			</a>
			<h1 class="ts-readerbar__title">{ v.Title }</h1>
			if v.Speaker != nil {
				@components.PlayButton(*v.Speaker)
			}
			<a class="ts-iconbtn" href={ templ.SafeURL(v.SearchHref) } hx-get={ v.SearchHref } hx-target="#sheet" hx-select="#sheet > *" hx-swap="innerHTML" hx-push-url="false" aria-haspopup="dialog" aria-label={ v.SearchLabel }>
				@components.Icon("search", false)
			</a>
			<a class="ts-iconbtn" href={ templ.SafeURL(v.Footer.ContentsHref) } hx-get={ v.Footer.ContentsHref } hx-target="#sheet" hx-select="#sheet > *" hx-swap="innerHTML" hx-push-url="false" aria-haspopup="dialog" aria-label={ v.Footer.ContentsLabel }>
				@components.Icon("chapters", false)
			</a>
			<button type="button" class="ts-iconbtn" data-ts-mark="bookmark" aria-label={ v.BookmarkLabel }>
				@components.Icon("bookmark", false)
			</button>
			<a class="ts-iconbtn" href={ templ.SafeURL(v.MarksHref) } hx-get={ v.MarksHref } hx-target="#sheet" hx-select="#sheet > *" hx-swap="innerHTML" hx-push-url="false" aria-haspopup="dialog" aria-label={ v.MarksLabel }>
				@components.Icon("edit", false)
			</a>
			<a
				class="ts-iconbtn ts-aa"
				href={ templ.SafeURL(v.SettingsHref) }
				hx-get={ v.SettingsHref }
				hx-target="#sheet"
				hx-select="#sheet > *"
				hx-swap="innerHTML"
				hx-push-url="false"
				aria-haspopup="dialog"
				aria-label={ v.SettingsLabel }
			>Aa</a>
		</header>
		<article
			id="reader"
			class={ "ts-reader " + v.Look.Class }
			data-book={ v.BookID }
			data-edition={ v.EditionID }
			data-at={ v.Root.At }
			data-off={ v.Root.Off }
			data-cpm={ strconv.Itoa(v.Root.Cpm) }
			data-learned={ strconv.FormatBool(v.Root.Learned) }
			data-total-chars={ strconv.Itoa(v.Root.TotalChars) }
			data-before={ strconv.Itoa(v.Root.Before) }
			data-chapter-chars={ strconv.Itoa(v.Root.ChapterChars) }
			data-save={ v.Root.Save }
			data-flow={ v.Root.Flow }
			data-pages={ strconv.Itoa(v.Root.Pages) }
			data-chapter-count={ strconv.Itoa(v.Root.Chapters) }
			data-copy={ v.Root.Words }
			data-pages-src={ v.PagesModule }
			data-notes-src={ v.Root.NotesSrc }
			if v.ReaderModule != "" {
				data-ts-module={ v.ReaderModule }
			}
			if v.Root.Lang != "" {
				lang={ v.Root.Lang }
			}
		>
			<div class="ts-reader__col" id="reader-text">
				@ReaderChapter(v.Chapter)
			</div>
		</article>
		if v.SettingsModule != "" {
			<span hidden data-ts-module={ v.SettingsModule }></span>
		}
		<footer class="ts-readdock" id="reader-dock">
			@components.Ruler(v.Footer.Ruler)
			<div class="ts-readdock__row">
				<span id="reader-page">{ v.Footer.PageLine }</span>
				<span id="reader-left"></span>
			</div>
		</footer>
		<div id="reader-marks" class="ts-selmenu" role="toolbar" aria-label={ v.Marks.Label } if v.MarksModule != "" { data-ts-module={ v.MarksModule } } hidden>
			for _, sw := range v.Marks.Swatches {
				<button type="button" class="ts-selmenu__item ts-selmenu__item--swatch" data-ts-mark="highlight" data-colour={ sw.Colour } aria-label={ sw.Label }><span class="ts-selmenu__swatch" data-colour={ sw.Colour }></span></button>
			}
			<button type="button" class="ts-selmenu__item" data-ts-mark="note">
				@components.Icon("edit", false)
				{ v.Marks.Note }
			</button>
			<button type="button" class="ts-selmenu__item" data-ts-mark="copy">
				@components.Icon("share", false)
				{ v.Marks.Copy }
			</button>
		</div>
		<form id="reader-hl-form" hidden hx-post={ v.Marks.Action } hx-swap="none">
			<input type="hidden" name="_csrf" value={ v.Marks.CSRF }/>
			<input type="hidden" name="edition" value={ v.EditionID }/>
			<input type="hidden" name="start_sid"/>
			<input type="hidden" name="start_off"/>
			<input type="hidden" name="end_sid"/>
			<input type="hidden" name="end_off"/>
			<input type="hidden" name="colour" value="yellow"/>
			<input type="hidden" name="note"/>
			<input type="hidden" name="client_id"/>
		</form>
		<form id="reader-bm-form" hidden hx-post={ v.BookmarkURL } hx-swap="none">
			<input type="hidden" name="_csrf" value={ v.Marks.CSRF }/>
			<input type="hidden" name="edition_id" value={ v.EditionID }/>
			<input type="hidden" name="sid"/>
			<input type="hidden" name="client_id"/>
		</form>
		<dialog id="reader-note-dialog" class="ts-readernote" aria-label={ v.Marks.Note }>
			<form method="dialog">
				<textarea name="note" rows="4" maxlength="2000" aria-label={ v.Marks.Note }></textarea>
				<button type="submit" class="ts-btn ts-btn--primary" value="save">{ v.Marks.Save }</button>
				<button type="submit" class="ts-btn ts-btn--quiet" value="cancel" formnovalidate>{ v.Marks.Cancel }</button>
			</form>
		</dialog>
		<span id="reader-marks-count" hidden>{ v.Marks.Count }</span>
	</div>
}

// ReaderChapter is one chapter: the meta line, the title, the blocks and the sentinel that asks for the next one.
templ ReaderChapter(c ReaderChapterView) {
	<section
		id={ readerSectionID(c) }
		data-ch={ strconv.Itoa(c.Idx) }
		data-part={ strconv.Itoa(c.Part) }
		data-before={ strconv.Itoa(c.Before) }
		data-chars={ strconv.Itoa(c.Chars) }
		if c.PrevFrag != "" {
			data-prev-href={ c.PrevFrag }
		}
		if c.NextFrag != "" {
			data-next-href={ c.NextFrag }
		}
	>
		if c.PrevHref != "" {
			<a class="ts-btn ts-btn--quiet ts-reader__prev" href={ templ.SafeURL(c.PrevHref) }>{ c.PrevLabel }</a>
		}
		if c.Head {
			<div class="ts-reader__meta"><span class="ts-overline ts-overline--accent">{ c.Overline }</span><span>{ c.Page }</span></div>
			<h2 class="ts-reader__chapter">{ c.Title }</h2>
		}
		<div class="ts-reader__text">
			for _, b := range c.Blocks {
				@ReaderBlock(b, false)
			}
		</div>
		if c.End != nil {
			<form class="ts-reader__end" method="post" action={ templ.URL(c.End.Action) } hx-post={ c.End.Action } hx-swap="none">
				<p>{ c.End.Text }</p>
				<input type="hidden" name="_csrf" value={ c.End.CSRF }/>
				<input type="hidden" name="finished" value="1"/>
				<button type="submit" class="ts-btn ts-btn--primary">{ c.End.Label }</button>
			</form>
		}
		if c.NextFrag != "" {
			<div class="ts-reader__next" hx-get={ c.NextFrag } hx-trigger="ts-reader-next" hx-swap="outerHTML">
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(c.NextHref) }>{ c.NextLabel }</a>
			</div>
		}
	</section>
}

// readerSectionID names a chapter part's section: the first part keeps the chapter's id.
func readerSectionID(c ReaderChapterView) string {
	if c.Part <= 1 {
		return "reader-ch-" + strconv.Itoa(c.Idx)
	}
	return "reader-ch-" + strconv.Itoa(c.Idx) + "-" + strconv.Itoa(c.Part)
}

// ReaderBlock is one block; with oob it swaps itself in place (a highlight changed it).
templ ReaderBlock(b ReaderBlockView, oob bool) {
	switch b.Kind {
		case "h":
			<h3 id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</h3>
		case "quote":
			<blockquote id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }><p>@templ.Raw(b.HTML)</p></blockquote>
		case "li":
			<p id={ b.ID } class="ts-reader__li" data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "note":
			<p id={ b.ID } class="ts-reader__note" data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "img":
			<p id={ b.ID } class="ts-reader__img" data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
		case "pre":
			<pre id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</pre>
		case "hr":
			<hr id={ b.ID } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }/>
		default:
			<p id={ b.ID } data-pg={ strconv.Itoa(b.Pg) } data-c={ strconv.Itoa(b.C) } if oob { hx-swap-oob="outerHTML" }>@templ.Raw(b.HTML)</p>
	}
}

// ReaderSheet is the contents or the marks panel over the page.
templ ReaderSheet(v ReaderSheetView) {
	<div class="ts-sheet-layer ts-sheet-layer--details">
		<a class="ts-scrim" href={ templ.SafeURL(v.CloseHref) } hx-boost="false" aria-label={ v.CloseLabel } tabindex="-1"></a>
		<div class="ts-sheet ts-details-sheet" role="dialog" aria-modal="true" aria-labelledby="reader-sheet-title" tabindex="-1">
			<div class="ts-sheet__grab" aria-hidden="true"></div>
			<div class="ts-sheet__head">
				<h2 id="reader-sheet-title" class="ts-sheet__title">{ v.Title }</h2>
				<a class="ts-iconbtn" href={ templ.SafeURL(v.CloseHref) } hx-boost="false" aria-label={ v.CloseLabel }>
					@components.Icon("close", false)
				</a>
			</div>
			if v.Search != nil {
				@ReaderSearchForm(*v.Search)
			} else if v.Kind == "contents" {
				<ol class="ts-reader__toc">
					for _, c := range v.Chapters {
						<li>
							<a
								href={ templ.SafeURL(c.Href) }
								if c.Current {
									aria-current="location"
								}
							>
								<span>{ c.Num }</span> { c.Title }
								if c.Note != "" {
									<span class="caption">{ c.Note }</span>
								}
							</a>
						</li>
					}
				</ol>
			} else {
				<p class="body">{ v.Lead }</p>
				<nav class="ts-chip-set" aria-label={ v.Title }>
					for _, f := range v.Filters {
						<a
							class="ts-chip"
							href={ templ.SafeURL(f.Href) }
							if f.Current {
								aria-current="true"
							}
						>{ f.Label } { strconv.Itoa(f.Count) }</a>
					}
				</nav>
				if len(v.Items) == 0 {
					<p class="body">{ v.Empty }</p>
				}
				<ul class="ts-reader__marks" id="reader-marks-list">
					for _, it := range v.Items {
						@ReaderMarkRow(it)
					}
				</ul>
				if len(v.Exports) > 0 {
					<div class="ts-reader__export">
						for _, e := range v.Exports {
							<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(e.Href) } download hx-boost="false">{ e.Label }</a>
						}
					</div>
				}
			}
		</div>
	</div>
}

// ReaderMarkRow is one highlight, note or bookmark in the marks panel.
templ ReaderMarkRow(it ReaderMarkItem) {
	<li id={ "reader-mark-" + it.ID } class="ts-reader__mark" if it.OOB { hx-swap-oob="outerHTML" }>
		<p class="caption">{ it.Kind }</p>
		if it.Quote != "" {
			<blockquote class="ts-note__quote">{ it.Quote }</blockquote>
		}
		if it.Note != "" {
			<p class="body">{ it.Note }</p>
		}
		if it.OpenHref != "" {
			<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(it.OpenHref) }>{ it.OpenLabel }</a>
		}
		if it.NoteHref != "" {
			<form hx-patch={ it.NoteHref } hx-swap="none">
				<input type="hidden" name="_csrf" value={ it.CSRF }/>
				<label class="caption" for={ "reader-note-" + it.ID }>{ it.NoteField }</label>
				<textarea id={ "reader-note-" + it.ID } name="note" rows="2">{ it.Note }</textarea>
				<button type="submit" class="ts-btn ts-btn--quiet">{ it.SaveLabel }</button>
			</form>
		}
		if it.DeleteHref != "" && it.PostDelete {
			<button type="button" class="ts-btn ts-btn--quiet" hx-post={ it.DeleteHref } hx-swap="none">{ it.DeleteLabel }</button>
		} else if it.DeleteHref != "" {
			<button type="button" class="ts-btn ts-btn--quiet" hx-delete={ it.DeleteHref } hx-swap="none">{ it.DeleteLabel }</button>
		}
	</li>
}

// ReaderMarksCount is the out-of-band count of marks (the Contents and notes link reads it).
templ ReaderMarksCount(text string) {
	<span id="reader-marks-count" hx-swap-oob="true" hidden>{ text }</span>
}

// ReaderMarkGone removes a row of the marks panel.
templ ReaderMarkGone(id string) {
	<li id={ "reader-mark-" + id } hx-swap-oob="delete"></li>
}

// ReaderSearchForm is the search sheet body: a plain GET form that also asks htmx for the answers alone.
templ ReaderSearchForm(v ReaderSearchView) {
	<form class="ts-reader__search" method="get" action={ templ.SafeURL(v.Action) } hx-get={ v.HxAction } hx-target="#reader-hits" hx-swap="innerHTML" hx-push-url="false" hx-boost="false">
		<input type="hidden" name="sheet" value="search"/>
		if v.EditionID != "" {
			<input type="hidden" name="edition" value={ v.EditionID }/>
		}
		<label class="caption" for="reader-q">{ v.Label }</label>
		<input id="reader-q" class="ts-input" type="search" name="q" value={ v.Q } autocomplete="off" enterkeyhint="search"/>
		<button type="submit" class="ts-btn ts-btn--primary">{ v.Button }</button>
	</form>
	<div id="reader-hits" aria-live="polite">
		@ReaderHitList(v.Hits)
	</div>
}

// ReaderHitList is the answers to a search.
templ ReaderHitList(h ReaderHits) {
	if h.Message != "" {
		<p class="body">{ h.Message }</p>
	}
	if len(h.Items) > 0 {
		<ol class="ts-reader__hits">
			for _, it := range h.Items {
				<li>
					<a href={ templ.SafeURL(it.Href) } hx-boost="false">
						<span class="caption">{ it.Chapter }</span>
						<span>{ it.Before }<mark>{ it.Hit }</mark>{ it.After }</span>
					</a>
				</li>
			}
		</ol>
	}
	if h.Note != "" {
		<p class="caption">{ h.Note }</p>
	}
}

// ReaderNote is the footnote popup, a dialog the client opens as soon as it arrives.
templ ReaderNote(v ReaderNoteView) {
	<dialog class="ts-readernote ts-readernote--note" aria-label={ v.Label }>
		for _, p := range v.Paras {
			<p>@templ.Raw(p)</p>
		}
		<div class="ts-readernote__actions">
			<a class="ts-btn" href={ templ.SafeURL(v.GoHref) } hx-boost="false">{ v.GoLabel }</a>
			<button type="button" class="ts-btn ts-btn--quiet" data-close>{ v.CloseLabel }</button>
		</div>
	</dialog>
}

// ReaderTrouble is the page for a book that cannot be opened: plain words and the way back.
templ ReaderTrouble(v ReaderProblem) {
	<div class="ts-readerpage ts-readerpage--trouble">
		<main class="ts-reader__trouble">
			<h1 class="title">{ v.Title }</h1>
			<p class="body">{ v.Message }</p>
			<a class="ts-btn" href={ templ.SafeURL(v.BackHref) }>{ v.BackLabel }</a>
			if v.DownloadHref != "" {
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.DownloadHref) } hx-boost="false">{ v.DownloadLabel }</a>
			}
		</main>
	</div>
}
