package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// HomeHeroView is the "Continue listening" card: the book the person stopped in last. Every word is
// written by the handler. Play is nil when the person may not play the book (no dead button).
type HomeHeroView struct {
	Cover components.CardView
	// Eyebrow is "Continue listening"; Title, Byline and Narrator are the book's words ("read by ...").
	Eyebrow, Title, Byline, Narrator, BookHref string
	// RulerLabel names the ruler ("Book progress, chapter 12 of 19"), RulerNow is 0 to 100 as text and
	// Ticks are the chapter starts as 0 to 100 percentages (text, for data-ts-value).
	RulerLabel, RulerNow string
	Ticks                []string
	// RulerBook, RulerChapters and RulerCurrent let the ruler pick a chapter (chapter-bar.js).
	RulerBook                       string
	RulerChapters, RulerCurrent int
	// Where is "Chapter 12 · 18 min left in chapter · 6 h 40 m left in book".
	Where string
	Play  *components.PlayButtonView
	// Read replaces Play for a book the person last read (nil otherwise).
	Read *components.ReadButtonView
	// ChaptersHref and ChaptersLabel make the desktop "Chapters" link.
	ChaptersHref, ChaptersLabel string
	// Also are the next books in progress (Home's row of three covers, decision 0021) and AlsoHref is its
	// "See all". HeroCard ignores them; HomeHero draws them under the card.
	Also     []components.CardView
	AlsoHref string
}

// HomeSeriesRowView is one line of "Your series in progress". Play is nil when the book is the hero
// (one resume button per book) or cannot play.
type HomeSeriesRowView struct {
	Cover            components.CardView
	Name, Meta, Href string
	Play             *components.PlayButtonView
	// Read replaces Play for a book the person last read (nil otherwise): the row keeps one control.
	Read *components.ReadButtonView
}

// HomeSeriesView is the series row with its heading.
type HomeSeriesView struct {
	Title string
	Rows  []HomeSeriesRowView
}

// HomeBecauseView is "Because you listened to {seed}" and its cards.
type HomeBecauseView struct {
	Title, Seed string
	Cards       []components.CardView
}

// HeroCard is the "Continue listening" card itself, without the #home-hero wrapper: Home draws it inside
// the wrapper, Profile draws it bare (Profile does not refresh while playing).
templ HeroCard(v HomeHeroView) {
	<section class="ts-hero ts-home__hero" aria-label={ v.Eyebrow }>
		<div class="ts-hero__top">
			<a class="ts-hero__cover ts-book-block" href={ templ.SafeURL(v.BookHref) } tabindex="-1" aria-hidden="true">
				@components.Cover(v.Cover, "fill")
			</a>
			<div class="ts-hero__text">
				<div class="ts-hero__head">
					<span class="ts-overline ts-overline--accent" data-ts-hero-eyebrow>{ v.Eyebrow }</span>
					<h2 class="ts-hero__title"><a href={ templ.SafeURL(v.BookHref) }>{ v.Title }</a></h2>
					<p class="ts-hero__byline">
						{ v.Byline }
						if v.Narrator != "" {
							<br/>
							{ v.Narrator }
						}
					</p>
				</div>
				<div class="ts-hero__progress">
					@components.Ruler(components.RulerView{Label: v.RulerLabel, Now: v.RulerNow, Ticks: v.Ticks, Book: v.RulerBook, Chapters: v.RulerChapters, Current: v.RulerCurrent})
					<p class="ts-hero__where">{ v.Where }</p>
				</div>
				<div class="ts-hero__actions">
					if v.Play != nil {
						@components.PlayButton(*v.Play)
					}
					if v.Read != nil {
						@components.ReadButton(*v.Read)
					}
					if v.ChaptersHref != "" {
						<a class="ts-btn ts-btn--secondary ts-btn--lg ts-hero__chapters" href={ templ.SafeURL(v.ChaptersHref) }>{ v.ChaptersLabel }</a>
					}
				</div>
			</div>
		</div>
	</section>
}

// HomeHero is the hero card inside its #home-hero wrapper. The wrapper is always there, empty when
// nothing is in progress, so the first save can fill it: it re-reads /hx/home/hero when progress is
// saved (progress-saved on the body). Without JavaScript the card is just there, with a plain link.
templ HomeHero(v *HomeHeroView) {
	<div id="home-hero" hx-get="/hx/home/hero" hx-trigger="progress-saved from:body" hx-swap="outerHTML">
		if v != nil {
			@HeroCard(*v)
		}
	</div>
}

// HomeAlso is the other books in progress, in its #home-also wrapper below "New on the shelf". The
// wrapper is always there, so a save can fill it.
templ HomeAlso(v *HomeHeroView) {
	<div id="home-also">
		@homeAlsoRow(v)
	</div>
}

// HomeHeroUpdate is what /hx/home/hero answers: the hero, and the row out of band, because a save can
// move a book between the two.
templ HomeHeroUpdate(v *HomeHeroView) {
	@HomeHero(v)
	<div id="home-also" hx-swap-oob="outerHTML">
		@homeAlsoRow(v)
	</div>
}

templ homeAlsoRow(v *HomeHeroView) {
	if v != nil && len(v.Also) > 0 {
		<section class="ts-home__row" aria-labelledby="home-also-title">
			<div class="ts-home__rowhead">
				<h2 id="home-also-title" class="section">Also in progress</h2>
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.AlsoHref) }>See all</a>
			</div>
			<div class="ts-home__cards ts-home__cards--three">
				for _, c := range v.Also {
					@components.BookCard(c)
				}
			</div>
		</section>
	}
}

// HomeSeries is "Your series in progress": a cover, the series, where the person is, and a round play
// link for the next book (none for the book the hero already offers).
templ HomeSeries(v HomeSeriesView) {
	if len(v.Rows) > 0 {
		<section id="row-series" class="ts-home__row" aria-labelledby="row-series-title">
			<h2 id="row-series-title" class="section ts-home__rowtitle">{ v.Title }</h2>
			for _, r := range v.Rows {
				<div class="ts-row">
					<a class="ts-row__main" href={ templ.SafeURL(r.Href) }>
						@components.Cover(r.Cover, "56")
						<span class="ts-row__text">
							<span class="ts-row__title">{ r.Name }</span>
							<span class="ts-row__meta ts-truncate">{ r.Meta }</span>
						</span>
					</a>
					if r.Play != nil {
						@components.PlayButton(*r.Play)
					}
					if r.Read != nil {
						@components.ReadButton(*r.Read)
					}
				</div>
			}
		</section>
	}
}

// HomeSharedView is the "Shared with you" row: the heading, the "from ..." caption (empty when no
// sharer is named), the link to the whole list and up to three book cards.
type HomeSharedView struct {
	Title, From, SeeAllURL string
	Cards                  []components.CardView
}

// HomeShared is the "Shared with you" row. Its markup hooks (row-shared, ts-home__rowsub,
// ts-home__rowsep, ts-home__cards--three) are styled by pages-home.css.
templ HomeShared(v *HomeSharedView) {
	if v != nil && len(v.Cards) > 0 {
		<section id="row-shared" class="ts-home__row" aria-labelledby="row-shared-title">
			<div class="ts-home__rowhead">
				<h2 id="row-shared-title" class="section">
					{ v.Title }
					if v.From != "" {
						<span class="caption ts-home__rowsub"><span class="ts-home__rowsep" aria-hidden="true">· </span>{ v.From }</span>
					}
				</h2>
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.SeeAllURL) }>See all</a>
			</div>
			<div class="ts-home__cards ts-home__cards--three">
				for _, c := range v.Cards {
					@components.BookCard(c)
				}
			</div>
		</section>
	}
}

// HomeBecause is "Because you listened to {seed}" with plain book cards (cards never resume).
templ HomeBecause(v *HomeBecauseView) {
	if v != nil && len(v.Cards) > 0 {
		<section id="row-because" class="ts-home__row" aria-labelledby="row-because-title">
			<h2 id="row-because-title" class="section ts-home__rowtitle">{ v.Title } <em>{ v.Seed }</em></h2>
			<div class="ts-home__cards">
				for _, c := range v.Cards {
					@components.BookCard(c)
				}
			</div>
		</section>
	}
}
