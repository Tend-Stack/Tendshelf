package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// BookStyles are the stylesheets the book, people and series pages link after the shared ones, and
// SearchStyles those of search. pages-home.css carries the covers, pages-library.css the grid and
// the rows.
var (
	BookStyles   = []string{"css/pages-home.css", "css/pages-library.css", "css/pages-book.css"}
	SearchStyles = []string{"css/pages-home.css", "css/pages-library.css", "css/pages-search.css"}
)

// Link is a name that links somewhere: an author, a narrator, a series, a genre.
type Link struct{ Name, Href string }

// BookTab is one tab of the book page; every tab is its own address.
type BookTab struct {
	ID, Label, Href string
	Current         bool
	// Home marks the Chapters tab on the About page: on a wide screen the About tab is hidden and
	// this one stands for the page (the stylesheet draws it as current there).
	Home bool
}

// DetailRow is one line of the Details tab: a label and plain text, or links (genres).
type DetailRow struct {
	Label, Value string
	Links        []Link
}

// BookPlayView is the #book-play region: the book's one play button (nil when no file can play),
// the progress ruler and where-lines of a book under way (Ruler is nil otherwise), the shelf link,
// then a quiet button that marks the book finished (MarkValue "1") or not started ("0"). Refresh is
// the fragment address the region re-reads when a save or a mark fires progress-saved. Action, Next
// and CSRF drive the plain-form fallback of the mark.
type BookPlayView struct {
	Button *components.PlayButtonView
	// Read opens the reader. ReadFirst puts it before Button (it is the primary one, decision 0018); Note is the
	// sentence a person sees instead of it when they may see the book but not read it.
	Read      *components.ReadButtonView
	ReadFirst bool
	Note      string
	// Queue is the dropdown on the button's right quarter (Play next, Add to queue); nil draws the
	// button alone.
	Queue                *components.QueueMenuView
	MarkLabel, MarkValue string
	Action, Next, CSRF   string
	Refresh              string
	// Ruler is the progress line; Where is the long line under it, WhereShort the tablet's.
	Ruler             *components.RulerView
	Where, WhereShort string
	// ShelfHref and ShelfLabel open the "Add to shelf" sheet; empty for people who may not shelve.
	ShelfHref, ShelfLabel string
	// ShareHref opens the book's Share & invite page; empty unless the person manages users.
	ShareHref string
	// Download is the offline Download control; nil unless the person may download the book and it
	// has a playable file (M3a). Both of its nodes start hidden: js/downloads.js shows one.
	Download *BookDownloadView
}

// BookDownloadView is the Download pair on the book page: the button that starts a download and the
// status link to the Downloads page. The messages are read by js/downloads.js.
type BookDownloadView struct {
	ID, Label, Href string
	// Downloading has a {pct} token; the rest are the status link's words per state.
	Downloading, Waiting, Ready, Paused, Failed string
}

// BookView is the book page. The handler writes every word and address; the template only lays
// them out. Exactly one of the three panels is filled, by Tab.
type BookView struct {
	Title, Subtitle string
	// Cover is drawn at its largest size (a 640 px source, no srcset).
	Cover components.CardView
	// BackHref and BackLabel are the link above the book ("Back to library").
	BackHref, BackLabel string
	Authors, Narrators  []Link
	// ByLabel and NarratedLabel are the words in front of the names.
	ByLabel, NarratedLabel, BylineSep string
	// Overline is "Harbour Lights · Book 2 of 3 · finished in March" (empty when there is nothing to
	// say). The chips are the series ("Harbour Lights · Book 1"), the length, the chapters, the year
	// and the publisher; each is empty when unknown. Caption is "Harrow & Finch · Abridged · 19
	// chapters" (the tablet's line).
	Overline                                                     string
	ChipSeries, ChipSeriesHref                                   string
	ChipEbook, ChipDuration, ChipChapters, ChipYear, ChipPublisher, Caption string
	// BandTint is the cover's tint for the band behind the header and BandClass its strength per
	// theme ("ts-band-dark-1 ts-band-light-2"); both are empty when the band stays plain.
	BandTint, BandClass string
	// Banner is the status line for a missing or refused book.
	Banner string
	Tabs   []BookTab
	// Tab is "about", "chapters", "bookmarks", "text" or "details".
	Tab string
	// The description (Intro, then Rest behind MoreLabel) shows in the header on a wide screen and
	// in the About panel otherwise.
	Intro, Rest, MoreLabel string
	// LessLabel replaces MoreLabel while the rest is open; the control then sits below the text.
	LessLabel string
	// The rails: "More in {series}" with its tiles (SeriesHref is the series page, StartHref and
	// StartLabel the "Start series" link, empty when it does not apply) and "Also narrated by".
	SeriesTitle, SeriesHref string
	StartHref, StartLabel   string
	SeriesTiles             []components.CardView
	NarratedTitle           string
	Narrated                []components.CardView
	// Chapters, or NoChaptersText when the book lists none.
	Chapters       components.ChapterListView
	NoChaptersText string
	// Rows are the Details lines.
	Rows []DetailRow
	// Bookmarks fills the Bookmarks tab (P1c-7a).
	Bookmarks BookmarksView
	// Text fills the Text tab (M5 R1).
	Text TextView
	// Play is the play region (the book's one play button and the mark control); nil when the person
	// may not listen.
	Play *BookPlayView
	// ShelfHref opens the "Add to shelf" sheet (the book page with ?sheet=shelves); empty for people
	// who may not use shelves. It is not a play control: the book's one play button stays alone.
	ShelfHref, ShelfLabel string
	// ShareHref opens the book's Share & invite page; empty unless the person manages users.
	ShareHref string
	// CoverHref opens the "Change cover" sheet; empty for people who may not edit the book.
	CoverHref, CoverLabel string
	// RemoveHref opens the confirmation of "Remove this book"; empty unless Tendshelf added every
	// file of the book by upload and the person may add books (decision 0015).
	RemoveHref, RemoveLabel string
	// PanelTitle heads the options panel of the Details tab; PanelCoverCaption is the line under its
	// Change cover button. Empty PanelTitle (any other tab) shows no panel.
	PanelTitle, PanelCoverCaption string
	// Edit holds the Details tab's lookup and reset controls; the zero value shows none.
	Edit DetailsEditView
	// Write holds the Details tab's write-details controls (M4-9); the zero value shows none.
	Write WriteTabView
}

// DetailsEditView is what a person who may edit the book sees on the Details tab (M4-6): the lookup
// button, the status after details were taken from a match, and the "go back to the files" form.
type DetailsEditView struct {
	// LookupHref opens the lookup sheet (the page with ?sheet=lookup); empty when lookups are off.
	LookupHref, LookupLabel string
	// Applied is "Used 2 changes."; empty when nothing was just applied.
	Applied string
	// ResetAction is where the reset form posts; empty hides the disclosure.
	ResetAction, CSRF                  string
	ResetTitle, ResetBody, ResetButton string
	// LookupCaption is the line under the lookup button.
	LookupCaption string
}

templ backIcon() {
	<svg class="ts-icon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="m15 6-6 6 6 6"></path>
	</svg>
}

templ linkList(prefix string, links []Link) {
	if len(links) > 0 {
		<span class="ts-book__people">
			{ prefix }
			for i, l := range links {
				if i > 0 {
					,&nbsp;
				}
				<a href={ templ.SafeURL(l.Href) }>{ l.Name }</a>
			}
		</span>
	}
}

// BookPlay is the play region of the book page: the book's single play button, the progress ruler
// of a book under way, the shelf link and "Mark as finished" or "Mark as not started". It refreshes
// itself when progress is saved (progress-saved on the body), so the button, the ruler and the label
// follow the listening. The mark is an htmx form with a plain POST fallback.
templ BookPlay(v *BookPlayView) {
	if v != nil {
		<div
			id="book-play"
			class="ts-book__play"
			hx-get={ v.Refresh }
			hx-trigger="progress-saved from:body"
			hx-swap="outerHTML"
		>
			if v.Read != nil && v.ReadFirst {
				@components.ReadButton(*v.Read)
			}
			if v.Note != "" {
				<p class="ts-book__note">{ v.Note }</p>
			}
			if v.Button != nil && v.Queue != nil {
				<div class="ts-split" role="group">
					@components.PlayButton(*v.Button)
					@components.QueueMenu(*v.Queue)
				</div>
			} else if v.Button != nil {
				@components.PlayButton(*v.Button)
			}
			if v.Read != nil && !v.ReadFirst {
				@components.ReadButton(*v.Read)
			}
			if v.Ruler != nil {
				<div class="ts-book__progress">
					@components.Ruler(*v.Ruler)
					<p class="ts-hero__where ts-book__where">{ v.Where }</p>
					<p class="caption ts-book__whereshort">{ v.WhereShort }</p>
				</div>
			}
			<div class="ts-book__acts">
				if v.ShelfHref != "" {
					@bookShelfLink(v.ShelfHref, v.ShelfLabel)
				}
				if v.ShareHref != "" {
					@bookShareLink(v.ShareHref)
				}
				if v.Download != nil {
					@bookDownload(*v.Download)
				}
				if v.MarkLabel != "" {
					<form method="post" action={ templ.SafeURL(v.Action) } hx-post={ v.Action } hx-swap="none">
						<input type="hidden" name="_csrf" value={ v.CSRF }/>
						<input type="hidden" name="finished" value={ v.MarkValue }/>
						<input type="hidden" name="next" value={ v.Next }/>
						<button type="submit" class="ts-btn ts-btn--secondary ts-btn--lg ts-book__mark">
							@components.Icon("check", false)
							<span class="ts-book__label">{ v.MarkLabel }</span>
						</button>
					</form>
				}
			</div>
		</div>
	}
}

// bookShelfLink opens the "Add to shelf" sheet. It is not a play control: the book's one play button
// stays alone.
// bookDownload is the Download pair (hidden until js/downloads.js knows the download state): a
// button to start, and a link to the Downloads page showing the state once one exists.
templ bookDownload(v BookDownloadView) {
	<button
		type="button"
		class="ts-btn ts-btn--secondary ts-btn--lg ts-book__download"
		data-ts-download={ v.ID }
		data-ts-msg-downloading={ v.Downloading }
		data-ts-msg-waiting={ v.Waiting }
		hidden
	>
		@components.Icon("download", false)
		<span class="ts-book__label">{ v.Label }</span>
	</button>
	<a
		class="ts-btn ts-btn--secondary ts-btn--lg ts-book__download"
		href={ templ.SafeURL(v.Href) }
		data-ts-download-status
		data-ts-msg-ready={ v.Ready }
		data-ts-msg-paused={ v.Paused }
		data-ts-msg-failed={ v.Failed }
		hidden
	>
		@components.Icon("download", false)
		<span class="ts-book__label" data-ts-download-label></span>
	</a>
}

// bookShareLink opens the Share & invite page for this book. A plain link: the page is a full page.
templ bookShareLink(href string) {
	<a class="ts-btn ts-btn--secondary ts-btn--lg ts-book__share" href={ templ.SafeURL(href) }>
		@components.Icon("share", false)
		<span class="ts-book__label">Share</span>
	</a>
}

templ bookShelfLink(href, label string) {
	<a
		class="ts-btn ts-btn--secondary ts-btn--lg ts-book__shelf"
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#sheet"
		hx-select="#sheet > *"
		hx-swap="innerHTML"
		hx-push-url="false"
		aria-haspopup="dialog"
	>
		@components.Icon("plus", false)
		<span class="ts-book__label">{ label }</span>
	</a>
}

// Book is the page of one book: the header (a tinted band, cover, text, play region), then the
// About, Chapters, Bookmarks and Details tabs and the rails. The tab URLs all return this full page;
// a tab link swaps only #book-panel.
templ Book(v BookView) {
	<article class="ts-book">
		if v.BandTint != "" {
			<div class={ "ts-book__band " + v.BandClass } data-ts-tint={ v.BandTint } aria-hidden="true"></div>
		}
		<a class="ts-btn ts-btn--quiet ts-book__back" href={ templ.SafeURL(v.BackHref) }>
			@backIcon()
			{ v.BackLabel }
		</a>
		<header class="ts-book__head">
			<div class="ts-book__cover">
				<span class="ts-book-block">
					@components.Cover(v.Cover, "fill")
				</span>
				if v.CoverHref != "" {
					<a
						class="ts-btn ts-btn--quiet ts-book__cover-change"
						href={ templ.SafeURL(v.CoverHref) }
						hx-get={ v.CoverHref }
						hx-target="#sheet"
						hx-select="#sheet > *"
						hx-swap="innerHTML"
						hx-push-url="false"
						aria-haspopup="dialog"
					>{ v.CoverLabel }</a>
				}
			</div>
			<div class="ts-book__info">
				if v.Overline != "" {
					<p class="ts-overline ts-book__overline">{ v.Overline }</p>
				}
				<h1 class="title-1 ts-book__title">{ v.Title }</h1>
				if v.Subtitle != "" {
					<p class="ts-book__sub">{ v.Subtitle }</p>
				}
				<p class="ts-book__byline">
					@linkList(v.ByLabel+" ", v.Authors)
					if len(v.Authors) > 0 && len(v.Narrators) > 0 {
						<span class="ts-book__sep" aria-hidden="true">{ v.BylineSep }</span>
					}
					<span class="ts-book__narr">
						@linkList(v.NarratedLabel+" ", v.Narrators)
					</span>
				</p>
				<ul class="ts-chip-set ts-book__chips">
					if v.ChipSeries != "" {
						<li><a class="ts-chip ts-book__chip--series" href={ templ.SafeURL(v.ChipSeriesHref) }>{ v.ChipSeries }</a></li>
					}
					if v.ChipDuration != "" {
						<li><span class="ts-chip ts-chip--static ts-num">{ v.ChipDuration }</span></li>
					}
					if v.ChipEbook != "" {
						<li><span class="ts-chip ts-chip--static ts-num">{ v.ChipEbook }</span></li>
					}
					if v.ChipChapters != "" {
						<li><span class="ts-chip ts-chip--static ts-book__chip--wide">{ v.ChipChapters }</span></li>
					}
					if v.ChipYear != "" {
						<li><span class="ts-chip ts-chip--static ts-num">{ v.ChipYear }</span></li>
					}
					if v.ChipPublisher != "" {
						<li><span class="ts-chip ts-chip--static ts-book__chip--wide">{ v.ChipPublisher }</span></li>
					}
				</ul>
				if v.Caption != "" {
					<p class="caption ts-book__caption">{ v.Caption }</p>
				}
				if v.Banner != "" {
					<p class="ts-banner" role="status">
						@components.Icon("alert", false)
						{ v.Banner }
					</p>
				}
			</div>
			if v.Play != nil {
				@BookPlay(v.Play)
			} else if v.ShelfHref != "" || v.ShareHref != "" {
				<div class="ts-book__play">
					<div class="ts-book__acts">
						if v.ShelfHref != "" {
							@bookShelfLink(v.ShelfHref, v.ShelfLabel)
						}
						if v.ShareHref != "" {
							@bookShareLink(v.ShareHref)
						}
					</div>
				</div>
			}
			if v.Intro != "" {
				<div class="ts-book__lede">
					<p class="ts-book__desc">{ v.Intro }</p>
					if v.Rest != "" {
						<details class="ts-book__more">
							<summary class="ts-btn ts-btn--quiet"><span class="ts-more-closed">{ v.MoreLabel }</span><span class="ts-more-open">{ v.LessLabel }</span></summary>
							<p class="ts-book__desc">{ v.Rest }</p>
						</details>
					}
				</div>
			}
		</header>
		<div class="ts-book__body">
			<nav id="book-tabs" class="ts-tabs" aria-label="Book">
				for _, t := range v.Tabs {
					<a
						id={ "book-tab-" + t.ID }
						class={ "ts-tabs__item", "ts-book__tab--" + t.ID, templ.KV("is-home", t.Home) }
						href={ templ.SafeURL(t.Href) }
						hx-get={ t.Href }
						hx-target="#book-panel"
						hx-select="#book-panel"
						hx-select-oob="#book-tabs"
						hx-swap="outerHTML"
						hx-push-url="true"
						if t.Current {
							aria-current="page"
						}
					>{ t.Label }</a>
				}
			</nav>
			<section id="book-panel" class={ "ts-book__panel", templ.KV("is-about", v.Tab == "about") } aria-labelledby={ "book-tab-" + v.Tab }>
				<div class="ts-book__tabbody">
					switch v.Tab {
						case "chapters":
							@bookChapters(v)
						case "bookmarks":
							@BookmarksPanel(v.Bookmarks)
						case "text":
							@TextPanel(v.Text)
						case "details":
							@bookDetails(v)
						default:
							@bookAbout(v)
					}
				</div>
				if v.Tab == "details" {
					<div class="ts-book__side">
						@bookDetailsPanel(v)
						@bookRails(v)
					</div>
				} else {
					@bookRails(v)
				}
			</section>
		</div>
	</article>
}

// bookAbout is the About panel: the description (hidden on a wide screen, where the header carries
// it) and the chapter list (shown only there, where the About tab is hidden).
templ bookAbout(v BookView) {
	<div class="ts-book__aboutdesc">
		if v.Intro != "" {
			<p class="ts-book__desc">{ v.Intro }</p>
			if v.Rest != "" {
				<details class="ts-book__more">
					<summary class="ts-btn ts-btn--quiet"><span class="ts-more-closed">{ v.MoreLabel }</span><span class="ts-more-open">{ v.LessLabel }</span></summary>
					<p class="ts-book__desc">{ v.Rest }</p>
				</details>
			}
		}
	</div>
	<div class="ts-book__aboutchapters">
		@bookChapters(v)
	</div>
}

// bookRails are the two rails that ride along with every tab: the tiles of the book's series and
// the other books by the narrator.
templ bookRails(v BookView) {
	if len(v.SeriesTiles) > 0 || len(v.Narrated) > 0 {
		<aside class="ts-book__rails">
			if len(v.SeriesTiles) > 0 {
				<section class="ts-book__rail" aria-labelledby="book-series-title">
					<div class="ts-book__railhead">
						<h2 id="book-series-title" class="section"><a href={ templ.SafeURL(v.SeriesHref) }>{ v.SeriesTitle }</a></h2>
						if v.StartHref != "" {
							<a class="ts-btn ts-btn--quiet ts-book__start" href={ templ.SafeURL(v.StartHref) }>{ v.StartLabel }</a>
						}
					</div>
					<div class="ts-book__tiles">
						for _, c := range v.SeriesTiles {
							@components.BookCard(c)
						}
					</div>
				</section>
			}
			if len(v.Narrated) > 0 {
				<section class="ts-book__rail" aria-labelledby="book-narrated-title">
					<div class="ts-book__railhead">
						<h2 id="book-narrated-title" class="section">{ v.NarratedTitle }</h2>
					</div>
					<div class="ts-book__tiles">
						for _, c := range v.Narrated {
							@components.BookCard(c)
						}
					</div>
				</section>
			}
		</aside>
	}
}

templ bookChapters(v BookView) {
	if len(v.Chapters.Rows) > 0 {
		@components.ChapterList(v.Chapters)
	} else {
		<p class="ts-book__desc">{ v.NoChaptersText }</p>
	}
}

templ bookDetails(v BookView) {
	<dl class="ts-book__details">
		for _, r := range v.Rows {
			<div class="ts-book__detail">
				<dt>{ r.Label }</dt>
				<dd>
					if len(r.Links) > 0 {
						for i, l := range r.Links {
							if i > 0 {
								,&nbsp;
							}
							<a href={ templ.SafeURL(l.Href) }>{ l.Name }</a>
						}
					} else {
						{ r.Value }
					}
				</dd>
			</div>
		}
	</dl>
}

// hasDetailsPanel is true when the person has at least one control for the options panel.
func hasDetailsPanel(v BookView) bool {
	return v.PanelTitle != "" && (v.Edit.LookupHref != "" || v.Edit.ResetAction != "" || v.CoverHref != "" ||
		v.Write.OpenHref != "" || v.Write.Pending.ConfirmAction != "" || v.Write.Note != "" || v.Edit.Applied != "" || v.Write.Attention != nil || v.RemoveHref != "")
}

// bookDetailsPanel is the card of options about the book: the latest status first, the "Waiting
// for you" choice while a write waits, then the actions, each full width with a line of help. On a
// wide screen it sits in the right column; below that it follows the details list.
templ bookDetailsPanel(v BookView) {
	if hasDetailsPanel(v) {
		<section class="ts-dpanel" aria-labelledby="details-panel-head">
			<h2 id="details-panel-head" class="section">{ v.PanelTitle }</h2>
			if v.Edit.Applied != "" {
				<p class="ts-book__applied label" role="status">
					@components.Icon("check", false)
					{ v.Edit.Applied }
				</p>
			}
			if v.Write.Note != "" {
				<p class="ts-book__applied label" role="status">
					@components.Icon("check", false)
					{ v.Write.Note }
				</p>
			}
			@WritePending(v.Write.Pending)
			if v.Write.Attention != nil {
				<div class="ts-write__attention" role="alert">
					<p class="body">{ v.Write.Attention.Text }</p>
					if v.Write.Attention.Folder != "" {
						<p class="caption ts-write__folder">{ v.Write.Attention.Folder }</p>
					}
				</div>
			}
			if v.Edit.LookupHref != "" || v.Write.OpenHref != "" || v.CoverHref != "" {
				<div class="ts-dpanel__acts">
					if v.Edit.LookupHref != "" {
						<div class="ts-dpanel__act">
							<a
								class="ts-btn ts-btn--secondary ts-btn--block ts-book__lookup"
								href={ templ.SafeURL(v.Edit.LookupHref) }
								hx-get={ v.Edit.LookupHref }
								hx-target="#sheet"
								hx-select="#sheet > *"
								hx-swap="innerHTML"
								hx-push-url="false"
								aria-haspopup="dialog"
							>{ v.Edit.LookupLabel }</a>
							<p class="caption">{ v.Edit.LookupCaption }</p>
						</div>
					}
					if v.Write.OpenHref != "" {
						<div class="ts-dpanel__act">
							<a
								class="ts-btn ts-btn--secondary ts-btn--block ts-book__write"
								href={ templ.SafeURL(v.Write.OpenHref) }
								hx-get={ v.Write.OpenHref }
								hx-target="#sheet"
								hx-select="#sheet > *"
								hx-swap="innerHTML"
								hx-push-url="false"
								aria-haspopup="dialog"
							>{ v.Write.OpenLabel }</a>
							<p class="caption">{ v.Write.OpenCaption }</p>
						</div>
					}
					if v.CoverHref != "" {
						<div class="ts-dpanel__act">
							<a
								class="ts-btn ts-btn--secondary ts-btn--block ts-dpanel__cover"
								href={ templ.SafeURL(v.CoverHref) }
								hx-get={ v.CoverHref }
								hx-target="#sheet"
								hx-select="#sheet > *"
								hx-swap="innerHTML"
								hx-push-url="false"
								aria-haspopup="dialog"
							>{ v.CoverLabel }</a>
							<p class="caption">{ v.PanelCoverCaption }</p>
						</div>
					}
				</div>
			}
			if v.RemoveHref != "" {
				<a class="ts-btn ts-btn--quiet ts-btn--block ts-book__remove" href={ templ.SafeURL(v.RemoveHref) }>{ v.RemoveLabel }</a>
			}
			if v.Edit.ResetAction != "" {
				<details class="ts-book__reset">
					<summary class="ts-btn ts-btn--quiet ts-btn--block">{ v.Edit.ResetTitle }</summary>
					<form method="post" action={ templ.URL(v.Edit.ResetAction) } hx-post={ v.Edit.ResetAction } hx-target="#book-panel" hx-select="#book-panel" hx-swap="outerHTML">
						<input type="hidden" name="_csrf" value={ v.Edit.CSRF }/>
						<p class="caption">{ v.Edit.ResetBody }</p>
						<button type="submit" class="ts-btn ts-btn--secondary ts-btn--block">{ v.Edit.ResetButton }</button>
					</form>
				</details>
			}
		</section>
	}
}
