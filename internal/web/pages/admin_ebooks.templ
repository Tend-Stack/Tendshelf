package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// InboxMatch is one audiobook an ebook might belong to: its title, byline, why it was offered, and
// the "Make one book" form. Note is the guard sentence when joining changes who can reach what. The
// handler writes every word.
type InboxMatch struct {
	Title, Byline, Reason string
	Action, CSRF, BookID  string
	ChooseLabel, Aria     string
	Note                  string
}

// InboxAction is one button in a form of its own: a POST to Action with the token and, when BookID is set,
// the audiobook it is about. Kind is the button style ("primary", "secondary" or "quiet").
type InboxAction struct {
	Action, Label, Aria, CSRF, Kind, BookID string
}

// InboxSuggestion is an ebook that may be the same book as an audiobook: the pairing card (with the guard
// sentence as its warning) and the three answers.
type InboxSuggestion struct {
	ID                  string
	Card                components.PairingCardView
	Make, NotSame, Keep InboxAction
	// PickHref is the page that searches every audiobook, for when the one offered is wrong.
	PickHref, PickLabel string
}

// InboxRow is one ebook file Tendshelf could not open, or has not finished reading. DownloadHref is set for
// a file that failed or looks damaged, for people who manage libraries.
type InboxRow struct {
	ID, Name, Meta, Note                    string
	PickHref, PickLabel                     string
	DownloadHref, DownloadLabel, DownloadAr string
}

// AdminEbooksView is /admin/ebooks.
type AdminEbooksView struct {
	Title, Lead, Empty, Error string
	MaybeTitle, MaybeLead     string
	Maybe                     []InboxSuggestion
	CannotTitle               string
	Cannot                    []InboxRow
	// More is "And {n} more." when a list is cut.
	More string
}

// AdminEbooks lists the suggested merges of ebooks with audiobooks, then the files that could not be opened.
templ AdminEbooks(v AdminEbooksView) {
	<div class="ts-admin ts-admin--list">
		<h1 class="title-1 ts-admin__title">{ v.Title }</h1>
		if v.Error != "" {
			<p class="body ts-users__error" role="alert">{ v.Error }</p>
		}
		<p class="body-lg ts-admin__lead">{ v.Lead }</p>
		if len(v.Maybe) == 0 && len(v.Cannot) == 0 {
			<p class="body ts-admin__lead" role="status">{ v.Empty }</p>
		}
		if len(v.Maybe) > 0 {
			<section aria-labelledby="inbox-maybe-h">
				<h2 id="inbox-maybe-h" class="section">{ v.MaybeTitle }</h2>
				<p class="caption ts-admin__lead">{ v.MaybeLead }</p>
				<div class="ts-ebook__files">
					for _, sg := range v.Maybe {
						<div id={ "inbox-" + sg.ID }>
							@components.PairingCard(sg.Card) {
								<div class="ts-pair__actions">
									@inboxActionForm(sg.Make)
									@inboxActionForm(sg.NotSame)
									@inboxActionForm(sg.Keep)
									<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(sg.PickHref) }>{ sg.PickLabel }</a>
								</div>
							}
						</div>
					}
				</div>
			</section>
		}
		if len(v.Cannot) > 0 {
			<section aria-labelledby="inbox-cannot-h">
				<h2 id="inbox-cannot-h" class="section ts-inbox__kept">{ v.CannotTitle }</h2>
				@inboxList(v.Cannot)
			</section>
		}
		if v.More != "" {
			<p class="caption ts-needs__more">{ v.More }</p>
		}
	</div>
}

templ inboxList(rows []InboxRow) {
	<ul class="ts-group ts-group--pad ts-needs">
		for _, r := range rows {
			<li class="ts-needs__row" id={ "inbox-" + r.ID }>
				<div class="ts-needs__text">
					<span class="body ts-needs__title">{ r.Name }</span>
					if r.Meta != "" {
						<span class="caption ts-needs__author">{ r.Meta }</span>
					}
					if r.Note != "" {
						<span class="caption ts-needs__outcome">{ r.Note }</span>
					}
				</div>
				if r.PickHref != "" {
					<div class="ts-needs__actions">
						<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(r.PickHref) }>{ r.PickLabel }</a>
					</div>
				}
				if r.DownloadHref != "" {
					<div class="ts-needs__actions">
						<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(r.DownloadHref) } aria-label={ r.DownloadAr }>{ r.DownloadLabel }</a>
					</div>
				}
			</li>
		}
	</ul>
}

// inboxActionForm is one answer in its own plain POST form: htmx boosts it, and it works without JavaScript.
templ inboxActionForm(a InboxAction) {
	<form class="ts-pair__form" method="post" action={ templ.URL(a.Action) }>
		<input type="hidden" name="_csrf" value={ a.CSRF }/>
		if a.BookID != "" {
			<input type="hidden" name="book" value={ a.BookID }/>
		}
		<button type="submit" class={ "ts-btn", "ts-btn--" + a.Kind } aria-label={ a.Aria }>{ a.Label }</button>
	</form>
}

// inboxChooseForm is "Make one book" for one audiobook: a plain POST that carries the book's id.
templ inboxChooseForm(m InboxMatch) {
	<form class="ts-pair__form" method="post" action={ templ.URL(m.Action) }>
		<input type="hidden" name="_csrf" value={ m.CSRF }/>
		<input type="hidden" name="book" value={ m.BookID }/>
		<button type="submit" class="ts-btn ts-btn--primary" aria-label={ m.Aria }>{ m.ChooseLabel }</button>
	</form>
}

// AdminEbookPickView is the page that asks which audiobook an ebook belongs to (board NoMatchPhone).
type AdminEbookPickView struct {
	Eyebrow, Title, BackLabel, BackText string
	// Error is the sentence of a refused pairing, drawn in an alert.
	Error string
	Card  components.PairingCardView
	// SearchAction is the page's own address; the form is a plain GET with the field q.
	SearchAction, SearchLabel, SearchGo, Q string
	CloseTitle                             string
	Close                                  []InboxMatch
	ResultsTitle, NoResults                string
	Results                                []InboxMatch
	Searched                               bool
	KeepAction, KeepLabel, KeepNote, CSRF  string
}

// AdminEbookPick offers the close matches, a search of the audiobooks and "Keep it as an ebook on its own".
templ AdminEbookPick(v AdminEbookPickView) {
	<div class="ts-admin ts-admin--list">
		<a class="ts-admin__back" href="/admin/ebooks" aria-label={ v.BackLabel }>
			@components.Icon("folder", false)
			{ v.BackText }
		</a>
		<span class="ts-overline">{ v.Eyebrow }</span>
		<h1 class="title-1 ts-admin__title">{ v.Title }</h1>
		if v.Error != "" {
			<p class="body ts-users__error" role="alert">{ v.Error }</p>
		}
		@components.PairingCard(v.Card)
		<form class="ts-inbox__search" method="get" action={ templ.URL(v.SearchAction) } role="search">
			<div class="ts-field">
				<label class="ts-field__label" for="inbox-q">{ v.SearchLabel }</label>
				<input class="ts-input" id="inbox-q" type="search" name="q" value={ v.Q } autocomplete="off"/>
			</div>
			<button type="submit" class="ts-btn ts-btn--secondary">{ v.SearchGo }</button>
		</form>
		if v.Searched {
			<section aria-labelledby="inbox-results-h">
				<h2 id="inbox-results-h" class="section">{ v.ResultsTitle }</h2>
				if len(v.Results) == 0 {
					<p class="body" role="status">{ v.NoResults }</p>
				} else {
					@inboxMatches(v.Results)
				}
			</section>
		}
		if len(v.Close) > 0 {
			<section aria-labelledby="inbox-close-h">
				<h2 id="inbox-close-h" class="section">{ v.CloseTitle }</h2>
				@inboxMatches(v.Close)
			</section>
		}
		<form class="ts-inbox__keep" method="post" action={ templ.URL(v.KeepAction) }>
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			<button type="submit" class="ts-btn ts-btn--quiet">{ v.KeepLabel }</button>
			<p class="caption">{ v.KeepNote }</p>
		</form>
	</div>
}

templ inboxMatches(ms []InboxMatch) {
	<ul class="ts-group ts-group--pad ts-needs">
		for _, m := range ms {
			<li class="ts-needs__row">
				<div class="ts-needs__text">
					<span class="body ts-needs__title">{ m.Title }</span>
					<span class="caption ts-needs__author">
						if m.Byline != "" {
							{ m.Byline }
						}
						if m.Byline != "" && m.Reason != "" {
							&nbsp;·&nbsp;
						}
						{ m.Reason }
					</span>
					if m.Note != "" {
						<span class="caption ts-needs__outcome">{ m.Note }</span>
					}
				</div>
				@inboxChooseForm(m)
			</li>
		}
	</ul>
}
