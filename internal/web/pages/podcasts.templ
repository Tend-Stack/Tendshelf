package pages

import (
	"net/url"
	"strconv"

	"github.com/Tend-Stack/tendshelf/internal/web/components"
)

// PodcastStyles are the sheets of the podcast pages.
var PodcastStyles = []string{"css/pages-home.css", "css/pages-library.css", "css/pages-book.css", "css/pages-podcasts.css"}

// PodcastAdminStyles are the sheets of the owner's podcast settings page.
var PodcastAdminStyles = []string{"css/pages-onboard.css", "css/pages-admin.css", "css/pages-email.css", "css/pages-me.css", "css/pages-podcasts.css"}

// PodTab is one tab of the Podcasts home.
type PodTab struct {
	Label, Href string
	On          bool
}

// PodcastsView is the Podcasts home: the tabs, then the shows as a grid or the episodes as rows. The
// handler writes every word (internal/web/podcasts_copy.go).
type PodcastsView struct {
	Title, FindHref, SearchLabel, SearchButton string
	TabsLabel                  string
	Tabs                       []PodTab
	Shows                      []components.ShowCardView
	Episodes                   []components.EpisodeRowView
	// Import is the "Bring your podcasts" section under the shows (nil on the other tabs).
	Import *PodImportView
	// Failure is a line shown above the list (for example a show that could not be fetched); empty draws nothing.
	Failure string
	// EmptyTitle and EmptyBody are drawn when the tab has nothing.
	EmptyTitle, EmptyBody string
	// Starters is the "Popular shows" suggestion list, drawn under the empty state when nothing is followed.
	Starters *PodStarterView
}

// podSearchForm is the in-page search field of the Podcasts tabs; it looks like the Radio page's and submits to the results page.
templ podSearchForm(v PodcastsView) {
	<form class="ts-podsearch__form" method="get" action={ templ.SafeURL(v.FindHref) } role="search">
		<input class="ts-input" type="search" name="q" maxlength="200" aria-label={ v.SearchLabel } placeholder={ v.SearchLabel } autocomplete="off"/>
		<button type="submit" class="ts-btn ts-btn--primary">{ v.SearchButton }</button>
	</form>
}

// Podcasts is the home of the podcasts a person follows.
templ Podcasts(v PodcastsView) {
	<div class="ts-podcasts">
		<header class="ts-podcasts__head">
			<h1 class="title-1 ts-podcasts__title">{ v.Title }</h1>
		</header>
		<nav class="ts-tabs ts-podcasts__tabs" aria-label={ v.TabsLabel }>
			for _, t := range v.Tabs {
				<a class="ts-tabs__item" href={ templ.SafeURL(t.Href) } if t.On {
	aria-current="page"
}>{ t.Label }</a>
			}
		</nav>
		@podSearchForm(v)
		if v.Failure != "" {
			<p class="ts-banner ts-podcasts__banner" role="status">
				@components.Icon("alert", false)
				{ v.Failure }
			</p>
		}
		if len(v.Shows) == 0 && len(v.Episodes) == 0 {
			@components.EmptyState(v.EmptyTitle, v.EmptyBody, nil)
		} else if len(v.Shows) > 0 {
			<div class="ts-grid ts-grid--covers ts-podcasts__grid">
				for _, c := range v.Shows {
					@components.ShowCard(c)
				}
			</div>
		} else {
			<div class="ts-lib-rows ts-podcasts__rows">
				for _, e := range v.Episodes {
					@components.EpisodeRow(e)
				}
			</div>
		}
		if v.Starters != nil {
			@PodStarters(*v.Starters)
		}
		if v.Import != nil {
			@PodImport(*v.Import)
		}
	</div>
}

// PodImportView is the import and export section of the Podcasts home. The handler writes every word.
type PodImportView struct {
	CSRF, Title, Hint, FileLabel, Button, ExportLabel, ExportHref string
	Status                                                         PodImportStatusView
}

// PodImportStatusView is the result of the person's latest import: nothing (no JobID), a running import that
// polls itself, or the plain-words result.
type PodImportStatusView struct {
	JobID, Label string
	Pending      bool
	Failed       bool
	Lines        []string
}

// PodImportStatus is the import result. While the job runs it asks for itself every 2 seconds and swaps itself out.
templ PodImportStatus(v PodImportStatusView) {
	<div
		id="pod-import-status"
		class="ts-podimport__status"
		role="status"
		aria-label={ v.Label }
		if v.Pending {
			hx-get={ "/hx/jobs/" + url.PathEscape(v.JobID) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		for _, l := range v.Lines {
			<p class={ "body", templ.KV("ts-podimport__failed", v.Failed) }>{ l }</p>
		}
	</div>
}

// PodImport is the "Bring your podcasts" section: a file form that works without JavaScript, the export link and
// the result of the latest import.
templ PodImport(v PodImportView) {
	<section class="ts-podimport" aria-labelledby="pod-import-title">
		<h2 id="pod-import-title" class="section">{ v.Title }</h2>
		<p class="caption">{ v.Hint }</p>
		<form class="ts-podimport__form" method="post" action="/podcasts/opml" enctype="multipart/form-data">
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			<input class="ts-input ts-podimport__file" type="file" name="file" accept=".opml,.xml,text/xml,text/x-opml" aria-label={ v.FileLabel } required/>
			<div class="ts-podimport__buttons">
				<button type="submit" class="ts-btn ts-btn--primary">{ v.Button }</button>
				<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(v.ExportHref) } hx-boost="false">{ v.ExportLabel }</a>
			</div>
		</form>
		if v.Status.JobID != "" {
			@PodImportStatus(v.Status)
		}
	</section>
}

// PodHit is one OndaCast result.
type PodHit struct {
	Title, Subtitle, Slug string
	Card                  components.CardView
}

// PodcastSearchView is the search page: the search form, the results, and the "Add by RSS address" form.
type PodcastSearchView struct {
	CSRF, Title, Q, SearchLabel, SearchButton, BackHref, BackLabel string
	Hits                                                           []PodHit
	Searched                                                       bool
	// Failure is the search problem in plain words (OndaCast unreachable); the RSS address form still works.
	Failure string
	// NoResults is the line shown when a search found nothing.
	NoResults       string
	FollowLabel     string
	AddTitle        string
	AddHint         string
	AddLabel        string
	AddOpen         bool
	ResultsLabel    string
	FollowAriaLabel string
	// Starters is the "Popular shows" suggestion list, drawn before anything is searched.
	Starters *PodStarterView
}

// PodcastSearch is the OndaCast search and the RSS address form.
templ PodcastSearch(v PodcastSearchView) {
	<div class="ts-podcasts ts-podsearch">
		<a class="ts-btn ts-btn--quiet ts-book__back" href={ templ.SafeURL(v.BackHref) }>
			@backIcon()
			{ v.BackLabel }
		</a>
		<h1 class="title-1 ts-podcasts__title">{ v.Title }</h1>
		<form class="ts-podsearch__form" method="get" action="/podcasts/search" role="search">
			<input class="ts-input" type="search" name="q" value={ v.Q } maxlength="200" aria-label={ v.SearchLabel } placeholder={ v.SearchLabel } autocomplete="off"/>
			<button type="submit" class="ts-btn ts-btn--primary">{ v.SearchButton }</button>
		</form>
		if v.Failure != "" {
			<p class="ts-banner ts-podcasts__banner" role="alert">
				@components.Icon("alert", false)
				{ v.Failure }
			</p>
		}
		if !v.Searched && v.Starters != nil {
			@PodStarters(*v.Starters)
		}
		if v.Searched && v.Failure == "" {
			if len(v.Hits) == 0 {
				<p class="body ts-podsearch__none" role="status">{ v.NoResults }</p>
			} else {
				<ul class="ts-podsearch__hits" aria-label={ v.ResultsLabel }>
					for _, h := range v.Hits {
						@PodHitRow(h, v.CSRF, v.FollowLabel, v.FollowAriaLabel)
					}
				</ul>
			}
		}
		<details class="ts-group ts-group--pad ts-podsearch__add" open?={ v.AddOpen }>
			<summary class="ts-podsearch__summary">
				<span>{ v.AddTitle }</span>
				@components.Icon("chevron-down", false)
			</summary>
			<form class="ts-podsearch__addform" method="post" action="/podcasts/follow">
				<input type="hidden" name="_csrf" value={ v.CSRF }/>
				<div class="ts-field">
					<label class="ts-field__label" for="pod-feed">{ v.AddLabel }</label>
					<input id="pod-feed" class="ts-input" type="url" name="feed_url" maxlength="2048" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="pod-feed-hint" required/>
					<span class="ts-field__hint" id="pod-feed-hint">{ v.AddHint }</span>
				</div>
				<button type="submit" class="ts-btn ts-btn--primary">{ v.FollowLabel }</button>
			</form>
		</details>
	</div>
}

// PodHitRow is one show with its Follow control: a search result or a suggested show.
templ PodHitRow(h PodHit, csrf, followLabel, followAria string) {
	<li class="ts-row ts-podhit">
		<form method="post" action="/podcasts/open" class="ts-podhit__open">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="slug" value={ h.Slug }/>
			<button type="submit" class="ts-podhit__link">
				@components.Cover(h.Card, "56")
				<span class="ts-row__text">
					<span class="ts-row__title ts-clamp-2">{ h.Title }</span>
					if h.Subtitle != "" {
						<span class="ts-row__meta ts-truncate ts-podhit__sub">{ h.Subtitle }</span>
					}
					<span class="ts-row__meta ts-podhit__busy" role="status">Opening…</span>
				</span>
			</button>
		</form>
		<form method="post" action="/podcasts/follow" class="ts-podhit__follow">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="slug" value={ h.Slug }/>
			<button type="submit" class="ts-btn ts-btn--secondary" aria-label={ followAria + " " + h.Title }>{ followLabel }</button>
		</form>
	</li>
}

// PodStarterGroup is one named group of suggested shows.
type PodStarterGroup struct {
	Title string
	Hits  []PodHit
}

// PodStarterView is the "Popular shows" section. The list is curated by the project, not a chart; the handler
// writes every word.
type PodStarterView struct {
	CSRF, Title, Hint, FollowLabel, FollowAria string
	Groups                                     []PodStarterGroup
}

// PodStarters is the suggestion list: groups of shows with the same Follow control a search result has.
templ PodStarters(v PodStarterView) {
	<section class="ts-podstart" aria-labelledby="pod-starters">
		<h2 id="pod-starters" class="section">{ v.Title }</h2>
		<p class="caption">{ v.Hint }</p>
		for i, g := range v.Groups {
			<h3 id={ "pod-starters-" + strconv.Itoa(i) } class="ts-podstart__group">{ g.Title }</h3>
			<ul class="ts-podsearch__hits" aria-labelledby={ "pod-starters-" + strconv.Itoa(i) }>
				for _, h := range g.Hits {
					@PodHitRow(h, v.CSRF, v.FollowLabel, v.FollowAria)
				}
			</ul>
		}
	</section>
}
