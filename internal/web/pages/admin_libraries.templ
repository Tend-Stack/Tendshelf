package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// AdminFolder is one folder row on the Libraries page.
type AdminFolder struct {
	ID, LibraryID, LibraryName, Path string
	// Summary is "{n} books · {size}".
	Summary string
	// Scan is the library's scan status while one is active, otherwise nil.
	Scan *components.ScanStatusView
}

// ProblemCard is one group in "things need a look". The handler writes the sentences.
type ProblemCard struct {
	Kind   string // drm, damaged, unsupported, missing or nocover: picks the icon
	Title  string
	Body   string
	Titles []string // book titles, shown as a list when present
}

// AdminLibrariesView is the Libraries & scanning page.
type AdminLibrariesView struct {
	CSRF string
	// Banner is the status line after "Mark books missing", or empty.
	Banner   string
	Ready    string // "912 books ready to play"
	LastScan string // "Last scan 2 hours ago found 2 new books." or "No scan yet."
	Folders  []AdminFolder
	Problems []ProblemCard
	// ProblemsTitle is "{n} things need a look"; empty when nothing does.
	ProblemsTitle string
	// Online is the owner-only "Book details from the internet" section; nil for everyone else.
	Online *AdminOnlineView
	// Lookups is the per-library part of that section (automatic lookups, "Look up all books");
	// nil when lookups are off. OnlineTitle and OnlineBody head the section for an admin, who
	// does not see the owner's switch.
	Lookups                 *AdminLookupsView
	OnlineTitle, OnlineBody string
	// Uploads is "Adding books from this device" (decision 0015); nil when uploads are not set up.
	Uploads *AdminUploadsView
	// Watch is "Finding new books" (S1): per library, watching and the scheduled scan; nil with no library.
	Watch *AdminWatchView
	// EbooksHref and EbooksLabel link /admin/ebooks ("Ebooks"), with no count; empty when ebooks are off.
	EbooksHref, EbooksLabel string
	// DuplicatesHref and DuplicatesLabel link /admin/duplicates ("Duplicate books", S4).
	DuplicatesHref, DuplicatesLabel string
	// HealthHref and HealthLabel link /admin/health ("Library health", S3).
	HealthHref, HealthLabel string
}

// AdminWatchView is the section where each library's "Watch for new books" and scheduled scan are set.
// The handler writes every word.
type AdminWatchView struct {
	Title, Lead, WatchLabel, EveryLabel, Save string
	Choices                                   []Option
	Libraries                                 []AdminWatchLibrary
}

// AdminWatchLibrary is one library's row: the switch, the interval in minutes ("0" = never) and the
// plain sentence about how it is being kept up to date.
type AdminWatchLibrary struct {
	ID, Name, Every, Status string
	Watch                   bool
}

// AdminUploadsView is the section where the owner picks, per library, the folder that receives
// uploaded books. An admin sees the same words read-only. The handler writes every word.
type AdminUploadsView struct {
	Title, Lead, Where, Off, Save, OwnerOnly string
	Owner                                    bool
	Libraries                                []AdminUploadLibrary
}

// AdminUploadLibrary is one library's choice: the folders it has, the chosen one (empty = off), the
// refusal after a save that failed, and the link to the Add books page when uploads are on.
type AdminUploadLibrary struct {
	ID, Name, Chosen, ChosenPath string
	Folders                      []AdminUploadFolder
	Error                        string
	AddHref, AddLabel            string
}

// AdminUploadFolder is one choice: a folder of the library.
type AdminUploadFolder struct{ ID, Path string }

// AdminLookupsView is the library rows of "Book details from the internet". The handler writes
// every word.
type AdminLookupsView struct {
	AutoLabel, AutoHint, Save, StartLabel, MoreLabel string
	Libraries                                        []AdminLookupLibrary
}

// AdminLookupLibrary is one library's row: the automatic setting, the start button or the running
// status, and the link to the books that need a look (empty when none do).
type AdminLookupLibrary struct {
	ID, Name   string
	Auto       bool
	Status     *components.LookupBulkView
	NeedsHref  string
	NeedsLabel string
}

// AdminOnlineView is the switch that allows online lookups. The handler writes every word.
type AdminOnlineView struct {
	Title, Body, OnLabel, OffLabel, Save string
	On                                   bool
}

func problemIcon(kind string) string {
	switch kind {
	case "drm":
		return "shield"
	case "nocover":
		return "grid"
	}
	return "alert"
}

// AdminLibraries lists the folders, starts scans and shows what needs a look.
templ AdminLibraries(v AdminLibrariesView) {
	<div class="ts-admin">
		<span class="ts-overline">Your server</span>
		<h1 class="title-1 ts-admin__title">Libraries &amp; scanning</h1>
		if v.Banner != "" {
			<p class="ts-banner ts-admin__banner" role="status">
				@components.Icon("check", false)
				{ v.Banner }
			</p>
		}
		<div class="ts-groups ts-admin__groups">
		<section class="ts-group ts-group--pad ts-admin__summary" aria-label="Scanning">
			<p class="label ts-admin__ready">
				@components.Icon("check", false)
				{ v.Ready }
			</p>
			<p class="caption ts-num ts-admin__last">{ v.LastScan }</p>
			if v.EbooksHref != "" {
				<div class="ts-admin__actions"><a class="ts-btn ts-btn--secondary" href={ templ.SafeURL(v.EbooksHref) }>{ v.EbooksLabel }</a></div>
			}
			if v.DuplicatesHref != "" {
				<div class="ts-admin__actions"><a class="ts-btn ts-btn--secondary" href={ templ.SafeURL(v.DuplicatesHref) }>{ v.DuplicatesLabel }</a></div>
			}
			if v.HealthHref != "" {
				<div class="ts-admin__actions"><a class="ts-btn ts-btn--secondary" href={ templ.SafeURL(v.HealthHref) }>{ v.HealthLabel }</a></div>
			}
			<div class="ts-admin__actions">
				<form method="post" action="/admin/libraries/scan">
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<button type="submit" class="ts-btn ts-btn--primary">Scan now</button>
				</form>
				<a class="ts-btn ts-btn--secondary" href="/admin/libraries/folders/new">Add a folder</a>
			</div>
		</section>
		if len(v.Problems) > 0 {
			<section class="ts-group ts-group--pad ts-admin__section" aria-labelledby="problems-h">
				<h2 id="problems-h" class="section">{ v.ProblemsTitle }</h2>
				for _, c := range v.Problems {
					<article class="ts-problem">
						<span class={ "ts-problem__icon ts-problem__icon--" + c.Kind } aria-hidden="true">
							@components.Icon(problemIcon(c.Kind), false)
						</span>
						<div class="ts-problem__text">
							<h3 class="body ts-problem__title">{ c.Title }</h3>
							<p class="caption ts-problem__body">{ c.Body }</p>
							if len(c.Titles) > 0 {
								<ul class="caption ts-problem__list">
									for _, t := range c.Titles {
										<li>{ t }</li>
									}
								</ul>
							}
						</div>
					</article>
				}
			</section>
		}
		<section class="ts-group ts-group--pad ts-group--wide ts-admin__section" aria-labelledby="folders-h">
			<h2 id="folders-h" class="section">Folders</h2>
			<ul class="ts-folders">
				for _, f := range v.Folders {
					<li class="ts-folder">
						<span class="ts-folder__icon" aria-hidden="true">@components.Icon("folder", false)</span>
						<div class="ts-folder__text">
							<span class="body ts-folder__name">{ f.LibraryName }</span>
							<span class="caption ts-folder__path">{ f.Path }</span>
							<span class="caption ts-num ts-folder__meta">{ f.Summary }</span>
							if f.Scan != nil {
								@components.ScanStatus(*f.Scan)
							}
						</div>
						<div class="ts-folder__actions">
							<form method="post" action={ templ.SafeURL("/admin/libraries/" + f.LibraryID + "/scan") }>
								<input type="hidden" name="_csrf" value={ v.CSRF }/>
								<button type="submit" class="ts-btn ts-btn--secondary">Scan</button>
							</form>
							<details class="ts-folder__more">
								<summary class="ts-btn ts-btn--quiet">More</summary>
								<a class="ts-folder__link" href={ templ.SafeURL("/admin/folders/" + f.ID + "/emptied") }>This folder was emptied on purpose</a>
							</details>
						</div>
					</li>
				}
			</ul>
		</section>
		if v.Watch != nil {
			@adminWatch(v)
		}
		if v.Online != nil || v.Lookups != nil {
			<section class="ts-group ts-group--pad ts-group--wide ts-admin__section ts-admin__online" aria-labelledby="online-h">
				<h2 id="online-h" class="section">{ v.OnlineTitle }</h2>
				<p class="caption">{ v.OnlineBody }</p>
				if v.Online != nil {
					@adminOnlineSwitch(v)
				}
				if v.Lookups != nil {
					@adminLookupRows(v)
				}
			</section>
		}
		if v.Uploads != nil {
			@adminUploads(v)
		}
		</div>
	</div>
}

// adminWatch is "Finding new books": a plain form for each library that works without script.
templ adminWatch(v AdminLibrariesView) {
	<section class="ts-group ts-group--pad ts-group--wide ts-admin__section" aria-labelledby="watch-h" id="watch">
		<h2 id="watch-h" class="section">{ v.Watch.Title }</h2>
		<p class="caption">{ v.Watch.Lead }</p>
		<ul class="ts-lookuplibs">
			for _, l := range v.Watch.Libraries {
				<li class="ts-lookuplib">
					<span class="body ts-lookuplib__name">{ l.Name }</span>
					<form class="ts-lookuplib__form" method="post" action={ templ.SafeURL("/admin/libraries/" + l.ID + "/watch") }>
						<input type="hidden" name="_csrf" value={ v.CSRF }/>
						<input type="hidden" name="on" value="0"/>
						<label class="ts-admin__choice" for={ "watch-" + l.ID }>
							<input type="checkbox" class="ts-check" id={ "watch-" + l.ID } name="on" value="1" aria-describedby={ "watch-status-" + l.ID } checked?={ l.Watch }/>
							<span>{ v.Watch.WatchLabel }</span>
						</label>
						<label class="caption" for={ "watch-every-" + l.ID }>{ v.Watch.EveryLabel }</label>
						<select id={ "watch-every-" + l.ID } name="every" class="ts-select">
							for _, c := range v.Watch.Choices {
								<option value={ c.Value } selected?={ c.Value == l.Every }>{ c.Label }</option>
							}
						</select>
						<p id={ "watch-status-" + l.ID } class="caption">{ l.Status }</p>
						<button type="submit" class="ts-btn ts-btn--secondary">{ v.Watch.Save }</button>
					</form>
				</li>
			}
		</ul>
	</section>
}

// adminUploads is "Adding books from this device": a plain form for each library that works without
// script. The owner chooses the folder that receives books or "Nowhere (off)"; an admin only reads.
templ adminUploads(v AdminLibrariesView) {
	<section class="ts-upset ts-group--wide" aria-labelledby="uploads-h" id="uploads">
		<h2 id="uploads-h" class="section">{ v.Uploads.Title }</h2>
		<p class="caption ts-upset__lead">{ v.Uploads.Lead }</p>
		for _, l := range v.Uploads.Libraries {
			if v.Uploads.Owner {
				<form class="ts-upset__lib" method="post" action={ templ.SafeURL("/admin/libraries/" + l.ID + "/uploads") }>
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<fieldset class="ts-upset__choices">
						<legend class="body ts-upset__name">{ l.Name } <span class="caption ts-upset__q">{ v.Uploads.Where }</span></legend>
						<label class="ts-upset__choice">
							<input type="radio" class="ts-check" name="folder_id" value="" checked?={ l.Chosen == "" }/>
							<span>{ v.Uploads.Off }</span>
						</label>
						for _, f := range l.Folders {
							<label class="ts-upset__choice">
								<input type="radio" class="ts-check" name="folder_id" value={ f.ID } checked?={ l.Chosen == f.ID }/>
								<span class="ts-upset__path">{ f.Path }</span>
							</label>
						}
					</fieldset>
					if l.Error != "" {
						<p class="ts-field__error ts-upset__err" role="alert">
							@components.Icon("alert", false)
							{ l.Error }
						</p>
					}
					<div class="ts-upset__btns">
						<button type="submit" class="ts-btn ts-btn--secondary">{ v.Uploads.Save }</button>
						if l.AddHref != "" {
							<a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(l.AddHref) }>{ l.AddLabel }</a>
						}
					</div>
				</form>
			} else {
				<div class="ts-upset__lib">
					<p class="body ts-upset__name">{ l.Name } <span class="caption ts-upset__q">{ v.Uploads.Where }</span></p>
					if l.ChosenPath != "" {
						<p class="ts-upset__path">{ l.ChosenPath }</p>
					} else {
						<p>{ v.Uploads.Off }</p>
					}
					<p class="caption ts-upset__lead">{ v.Uploads.OwnerOnly }</p>
					if l.AddHref != "" {
						<div class="ts-upset__btns"><a class="ts-btn ts-btn--quiet" href={ templ.SafeURL(l.AddHref) }>{ l.AddLabel }</a></div>
					}
				</div>
			}
		}
	</section>
}

// adminOnlineSwitch is the owner's on/off choice.
templ adminOnlineSwitch(v AdminLibrariesView) {
				<form method="post" action="/admin/online">
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<fieldset class="ts-admin__choices">
						<legend class="ts-sr">{ v.Online.Title }</legend>
						<label class="ts-admin__choice">
							<input type="radio" class="ts-check" name="on" value="1" checked?={ v.Online.On }/>
							<span>{ v.Online.OnLabel }</span>
						</label>
						<label class="ts-admin__choice">
							<input type="radio" class="ts-check" name="on" value="0" checked?={ !v.Online.On }/>
							<span>{ v.Online.OffLabel }</span>
						</label>
					</fieldset>
					<button type="submit" class="ts-btn ts-btn--secondary">{ v.Online.Save }</button>
				</form>
}

// adminLookupRows is one row per library: the automatic setting, "Look up all books" or the running
// status, and the link to the books that need a look.
templ adminLookupRows(v AdminLibrariesView) {
	<ul class="ts-lookuplibs">
		for _, l := range v.Lookups.Libraries {
			<li class="ts-lookuplib">
				<span class="body ts-lookuplib__name">{ l.Name }</span>
				<form class="ts-lookuplib__form" method="post" action={ templ.SafeURL("/admin/libraries/" + l.ID + "/auto-lookup") }>
					<input type="hidden" name="_csrf" value={ v.CSRF }/>
					<input type="hidden" name="on" value="0"/>
					<label class="ts-admin__choice" for={ "auto-" + l.ID }>
						<input type="checkbox" class="ts-check" id={ "auto-" + l.ID } name="on" value="1" aria-describedby={ "auto-hint-" + l.ID } checked?={ l.Auto }/>
						<span>{ v.Lookups.AutoLabel }</span>
					</label>
					<p id={ "auto-hint-" + l.ID } class="caption ts-autolookup__hint">{ v.Lookups.AutoHint }</p>
					<button type="submit" class="ts-btn ts-btn--secondary">{ v.Lookups.Save }</button>
				</form>
				if l.Status != nil {
					@components.LookupBulkStatus(*l.Status)
				}
				if l.Status == nil || !l.Status.Active {
					<form class="ts-lookuplib__form" method="post" action={ templ.SafeURL("/admin/libraries/" + l.ID + "/lookups") }>
						<input type="hidden" name="_csrf" value={ v.CSRF }/>
						<label class="ts-admin__choice" for={ "more-" + l.ID }>
							<input type="checkbox" class="ts-check" id={ "more-" + l.ID } name="more" value="1"/>
							<span>{ v.Lookups.MoreLabel }</span>
						</label>
						<button type="submit" class="ts-btn ts-btn--secondary">{ v.Lookups.StartLabel }</button>
					</form>
				}
				if l.NeedsHref != "" {
					<a class="ts-lookuplib__needs" href={ templ.SafeURL(l.NeedsHref) }>{ l.NeedsLabel }</a>
				}
			</li>
		}
	</ul>
}
