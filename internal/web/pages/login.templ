package pages

import "github.com/Tend-Stack/tendshelf/internal/web/components"

// LoginView is what the sign-in page shows. It never carries the password.
type LoginView struct {
	CSRF      string
	Username  string
	Next      string // already checked with auth.SafeNext
	FormError string
	// NoPassword is the line under the form about asking for a sign-in link.
	NoPassword string
	// SSOLabel ("Sign in with Authelia") and SSOHref (/login/oidc, with next) show the provider button
	// above the form when sign-in with a provider is on; SSOOr is the caption between it and the form.
	SSOLabel, SSOHref, SSOOr string
}

// Login is the sign-in page.
templ Login(v LoginView) {
	@components.Brand()
	<h1 class="title-1 ts-frame__title">Sign in</h1>
	<p class="body-lg ts-frame__lead">Welcome back.</p>
	if v.SSOHref != "" {
		<a class="ts-btn ts-btn--secondary ts-btn--lg ts-btn--block ts-sso__btn" href={ templ.SafeURL(v.SSOHref) } hx-boost="false" title={ v.SSOLabel }>
			<span class="ts-sso__label">{ v.SSOLabel }</span>
		</a>
		<p class="caption ts-login__or">{ v.SSOOr }</p>
	}
	<form class="ts-form" method="post" action="/login">
		<input type="hidden" name="_csrf" value={ v.CSRF }/>
		if v.Next != "" && v.Next != "/" {
			<input type="hidden" name="next" value={ v.Next }/>
		}
		@formError(v.FormError)
		@components.TextField(components.Field{
			ID: "username", Name: "username", Label: "Username", Value: v.Username, Required: true, Plain: true,
			Autocomplete: "username", Autofocus: true,
		})
		@components.TextField(components.Field{
			ID: "password", Name: "password", Label: "Password", Type: "password", Required: true,
			Autocomplete: "current-password",
		})
		<button type="submit" class="ts-btn ts-btn--primary ts-btn--lg ts-btn--block">Sign in</button>
	</form>
	if v.NoPassword != "" {
		<p class="caption">{ v.NoPassword }</p>
	}
}
