package pages

// RuntimesStyles are the sheets of the word-timing page.
var RuntimesStyles = []string{"css/pages-onboard.css", "css/pages-admin.css", "css/pages-email.css", "css/pages-runtimes.css"}

// RuntimeFactView is one line of a card's facts. Href makes the value a link; Mono draws it in the mono face.
type RuntimeFactView struct {
	Label, Value, Href string
	Mono               bool
}

// RuntimeCardView is one language's card. State is "ready", "not_set_up", "needs_check" or "problem".
// While a check runs Pending is set and the card asks for itself every 2 seconds.
type RuntimeCardView struct {
	Lang, Name, State, StateLabel, Line string
	Facts                               []RuntimeFactView
	Pending                             bool
	PollHref, ResultHref, ResultLabel   string
	CheckAction, CheckLabel, CheckAria  string
	CSRF                                string
	Failed                              bool
}

// RuntimeFileView is a pinned file the owner can save (served as text, never fetched by Tendshelf).
type RuntimeFileView struct{ Label, Href string }

// RuntimeStepView is one install step: a sentence, the files to save and a block of commands.
type RuntimeStepView struct {
	Text, CodeLabel string
	Files           []RuntimeFileView
	Code            string
}

// AdminRuntimesView is the word-timing page. The handler writes every word.
type AdminRuntimesView struct {
	Lead, Title, Intro, Error string
	Cards                []RuntimeCardView
	StepsTitle, StepsLead string
	Steps                []RuntimeStepView
	StepsOpen            bool // nothing is set up yet, so the steps are the first thing to read
}

func runtimeCardID(lang string) string { return "runtime-card-" + lang }

// RuntimeCard is one language: its state in words, the facts about the model and the Check button. While a
// check runs it swaps itself for the fresh card every 2 seconds.
templ RuntimeCard(v RuntimeCardView) {
	<section
		id={ runtimeCardID(v.Lang) }
		class="ts-group ts-group--pad ts-runtimes__card"
		aria-labelledby={ runtimeCardID(v.Lang) + "-h" }
		if v.Pending {
			hx-get={ v.PollHref }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div class="ts-runtimes__head">
			<h2 id={ runtimeCardID(v.Lang) + "-h" } class="section">{ v.Name }</h2>
			<span class={ "ts-runtimes__state", "ts-runtimes__state--" + v.State }>{ v.StateLabel }</span>
		</div>
		<p class={ "body", "ts-runtimes__line", templ.KV("ts-runtimes__line--failed", v.Failed || v.State == "problem") } role="status">{ v.Line }</p>
		if v.Pending && v.ResultHref != "" {
			<a class="caption" href={ templ.SafeURL(v.ResultHref) }>{ v.ResultLabel }</a>
		}
		<dl class="ts-runtimes__facts">
			for _, f := range v.Facts {
				<div class="ts-runtimes__fact">
					<dt class="caption">{ f.Label }</dt>
					<dd class={ "body", templ.KV("mono", f.Mono) }>
						if f.Href != "" {
							<a href={ templ.SafeURL(f.Href) } rel="noopener noreferrer">{ f.Value }</a>
						} else {
							{ f.Value }
						}
					</dd>
				</div>
			}
		</dl>
		<form method="post" action={ templ.URL(v.CheckAction) }>
			<input type="hidden" name="_csrf" value={ v.CSRF }/>
			<input type="hidden" name="language" value={ v.Lang }/>
			<button type="submit" class="ts-btn ts-btn--secondary" aria-label={ v.CheckAria } disabled?={ v.Pending }>{ v.CheckLabel }</button>
		</form>
	</section>
}

// AdminRuntimes is the owner's page for read-along word timing: one card per language and the install steps.
templ AdminRuntimes(v AdminRuntimesView) {
	<div class="ts-admin ts-email ts-runtimes">
		<span class="ts-overline">{ v.Lead }</span>
		<h1 class="title-1 ts-admin__title">{ v.Title }</h1>
		<p class="body">{ v.Intro }</p>
		if v.Error != "" {
			<p class="body ts-runtimes__line--failed" role="alert">{ v.Error }</p>
		}
		<div class="ts-groups ts-runtimes__cards">
			for _, c := range v.Cards {
				@RuntimeCard(c)
			}
		</div>
		<details class="ts-email__off ts-runtimes__steps" open?={ v.StepsOpen }>
			<summary>{ v.StepsTitle }</summary>
			<p class="caption">{ v.StepsLead }</p>
			<ol class="ts-runtimes__list">
				for _, st := range v.Steps {
					<li>
						<p class="body">{ st.Text }</p>
						if len(st.Files) > 0 {
							<ul class="ts-runtimes__files">
								for _, f := range st.Files {
									<li><a class="mono" href={ templ.SafeURL(f.Href) } download>{ f.Label }</a></li>
								}
							</ul>
						}
						if st.Code != "" {
							<pre class="mono ts-runtimes__code" tabindex="0" aria-label={ st.CodeLabel }><code>{ st.Code }</code></pre>
						}
					</li>
				}
			</ol>
		</details>
	</div>
}
