<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosters run plain http on a home network and private certificate authorities, so cleartext and user
     certificates are allowed. The address is the owner's own choice (plan: Network). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
